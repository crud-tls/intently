---
/** Loop's showcase art: a week grid with recurring tasks slotted into the free gaps. */
const DAYS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
// [day index, start row, length, colour]
const BLOCKS: [number, number, number, string][] = [
	[0, 1, 2, '#5B6CFF'], [1, 4, 1, '#FF8A3D'], [2, 1, 2, '#5B6CFF'], [3, 3, 2, '#2E9E5B'],
	[4, 1, 2, '#5B6CFF'], [5, 2, 3, '#FF8A3D'], [6, 5, 1, '#2E9E5B'],
];
---

<div class="week" aria-hidden="true">
	{DAYS.map((d) => <span class="day">{d}</span>)}
	{BLOCKS.map(([day, start, len, color]) => (
		<span class="block" style={`grid-column:${day + 1};grid-row:${start + 1} / span ${len};background:${color}`}></span>
	))}
</div>

<style>
	.week {
		display: grid;
		grid-template-columns: repeat(7, 34px);
		grid-template-rows: 28px repeat(6, 26px);
		gap: 6px;
		padding: 22px;
		border-radius: 22px;
		background: var(--surface);
		box-shadow: 0 18px 40px rgb(91 108 255 / 0.18);
	}

	.day {
		grid-row: 1;
		text-align: center;
		font-weight: 700;
		font-size: 0.8rem;
		color: var(--text-2);
	}

	.block {
		border-radius: 8px;
		opacity: 0.9;
	}
</style>
