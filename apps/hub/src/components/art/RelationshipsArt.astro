---
/**
 * Dusk: two figures side by side on a hill, the sun low between them, and a row of lights along
 * the path ahead, smaller with distance: the visits still to come.
 */
// [x, y, r]
const VISITS: [number, number, number][] = [
	[214, 404, 6], [244, 396, 5.4], [272, 389, 4.8], [298, 383, 4.2], [321, 378, 3.6],
	[342, 374, 3.1], [360, 371, 2.6], [376, 369, 2.2], [390, 368, 1.8],
];
---

<svg class="relationships-art" viewBox="0 0 400 480" role="img" aria-label="Two figures side by side on a hill at sunset, with small lights along the path ahead of them.">
	<defs>
		<radialGradient id="ra-sun" cx="0.5" cy="0.5" r="0.5">
			<stop offset="0" stop-color="#FFF0D6" />
			<stop style="stop-color:var(--glow)" offset="0.55" />
			<stop style="stop-color:var(--glow)" offset="1" stop-opacity="0" />
		</radialGradient>
		<linearGradient id="ra-ground" x1="0" y1="0" x2="0" y2="1">
			<stop style="stop-color:var(--ink)" offset="0" stop-opacity="0.85" />
			<stop style="stop-color:var(--ink)" offset="1" stop-opacity="0" />
		</linearGradient>
	</defs>
	<circle class="sun" cx="210" cy="300" r="170" fill="url(#ra-sun)" />
	<path style="fill:var(--ink)" class="far-hill" d="M-10 360 C 80 330, 160 340, 240 350 S 360 340, 410 330 L410 480 L-10 480 Z" fill-opacity="0.18" />
	<path class="near-hill" d="M-10 420 C 60 380, 160 372, 240 392 S 360 380, 410 366 L410 480 L-10 480 Z" fill="url(#ra-ground)" />
	<g style="fill:var(--glow)" class="visits">
		{VISITS.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
	</g>
	<g class="pair" style="--intently-light: var(--ink); --intently-dark: var(--ink)">
		<use href="#im" x="92" y="282" width="100" height="100" />
		<use href="#im" x="196" y="300" width="86" height="86" />
	</g>
</svg>

<style>
	.relationships-art {
		display: block;
		mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent);
		width: 100%;
		height: auto;
	}
</style>
