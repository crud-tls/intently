---
/**
 * Blue hour: a figure in front of a mirror. The reflection is still a blur; small lights (the daily
 * acts) drift into it. Motion and the Self page sharpen it by easing the blur on .reflection.
 */
// Small acts drifting into the mirror: [x, y, r]
const ACTS: [number, number, number][] = [[96, 120, 4], [312, 96, 3], [330, 210, 5], [80, 250, 3.5], [300, 330, 3], [120, 340, 4.5]];
---

<svg class="self-art" viewBox="0 0 400 480" role="img" aria-label="A small figure stands in front of a tall oval mirror. Its reflection is still blurred, and small lights drift towards it.">
	<defs>
		<filter id="sa-blur" x="-30%" y="-30%" width="160%" height="160%">
			<feGaussianBlur class="blur" stdDeviation="9" />
		</filter>
		<radialGradient id="sa-glass" cx="0.4" cy="0.35" r="0.75">
			<stop style="stop-color:var(--glow)" offset="0" stop-opacity="0.55" />
			<stop style="stop-color:var(--glow)" offset="1" stop-opacity="0.08" />
		</radialGradient>
		<clipPath id="sa-oval"><ellipse cx="200" cy="210" rx="118" ry="170" /></clipPath>
	</defs>
	<ellipse cx="200" cy="210" rx="118" ry="170" fill="url(#sa-glass)" />
	<g clip-path="url(#sa-oval)">
		<use href="#im" x="120" y="110" width="160" height="160" class="reflection" filter="url(#sa-blur)" opacity="0.85" />
	</g>
	<ellipse style="stroke:var(--ink)" cx="200" cy="210" rx="118" ry="170" fill="none" stroke-width="10" stroke-opacity="0.9" />
	<ellipse style="stroke:var(--glow)" cx="200" cy="210" rx="106" ry="158" fill="none" stroke-width="2" stroke-opacity="0.6" />
	<g style="fill:var(--accent)" class="acts">
		{ACTS.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
	</g>
	<use href="#im" x="262" y="330" width="128" height="128" class="walker" />
</svg>

<style>
	.self-art {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
