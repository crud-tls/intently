---
/** The illustration for a chapter, by id. */
import type { ChapterId } from '../../data/chapters.ts';
import TimeArt from './TimeArt.astro';
import AttentionArt from './AttentionArt.astro';
import HealthArt from './HealthArt.astro';
import WealthArt from './WealthArt.astro';
import RelationshipsArt from './RelationshipsArt.astro';
import SelfArt from './SelfArt.astro';
import FaithArt from './FaithArt.astro';

interface Props {
	id: ChapterId;
}

const ART = {
	time: TimeArt,
	attention: AttentionArt,
	health: HealthArt,
	wealth: WealthArt,
	relationships: RelationshipsArt,
	self: SelfArt,
	faith: FaithArt,
};
const Art = ART[Astro.props.id];
---

<Art />
