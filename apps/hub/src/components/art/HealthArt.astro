---
/** Noon: the sun overhead, rings of breath around it, and a dotted path climbing a gentle hill. */
const RAYS = Array.from({ length: 16 }, (_, i) => (i * 360) / 16);
// Footsteps up the hill: [x, y]
const STEPS: [number, number][] = [
	[30, 446], [62, 436], [94, 425], [126, 413], [158, 402], [190, 392], [222, 384], [254, 378],
];
---

<svg class="health-art" viewBox="0 0 400 480" role="img" aria-label="The noon sun with three rings of breath around it, and a figure walking up a gentle hill on a dotted path.">
	<defs>
		<radialGradient id="ha-sun" cx="0.5" cy="0.5" r="0.5">
			<stop offset="0" stop-color="#FFFFFF" />
			<stop style="stop-color:var(--glow)" offset="0.6" />
			<stop style="stop-color:var(--glow)" offset="1" stop-opacity="0.9" />
		</radialGradient>
	</defs>
	<g style="stroke:var(--ink)" class="breath" fill="none">
		<circle cx="200" cy="170" r="150" stroke-opacity="0.08" stroke-width="2" />
		<circle cx="200" cy="170" r="118" stroke-opacity="0.13" stroke-width="2" />
		<circle cx="200" cy="170" r="88" stroke-opacity="0.2" stroke-width="2" />
	</g>
	<g style="stroke:var(--glow)" class="rays" stroke-width="6" stroke-linecap="round">
		{RAYS.map((a) => <line x1="200" y1="96" x2="200" y2="110" transform={`rotate(${a} 200 170)`} />)}
	</g>
	<circle class="sun" cx="200" cy="170" r="52" fill="url(#ha-sun)" />
	<path style="fill:var(--ink)" class="hill" d="M-10 480 L-10 450 C 90 420, 200 360, 300 368 S 410 400, 410 400 L410 480 Z" fill-opacity="0.12" />
	<g style="fill:var(--ink)" class="steps" fill-opacity="0.55">
		{STEPS.map(([x, y], i) => <ellipse cx={x} cy={y - (i % 2) * 6} rx="5" ry="3.2" />)}
	</g>
	<use href="#im" x="262" y="300" width="74" height="74" class="walker" />
</svg>

<style>
	.health-art {
		display: block;
		mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
		width: 100%;
		height: auto;
	}
</style>
