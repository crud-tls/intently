---
/** Afternoon: small coins dropping one by one into a glass jar that is slowly filling up. */
// Coins resting in the jar: [x, y]
const STACK: [number, number][] = [
	[160, 404], [196, 408], [232, 404], [266, 400], [142, 384], [178, 386], [214, 388], [250, 384],
	[284, 380], [160, 366], [198, 368], [236, 366], [272, 362], [180, 348], [218, 350], [254, 346],
];
// Coins on the way in, smaller as they fall from further away: [x, y, scale]
const FALLING: [number, number, number][] = [[212, 64, 0.6], [214, 128, 0.75], [216, 196, 0.9]];
---

<svg class="wealth-art" viewBox="0 0 400 480" role="img" aria-label="Coins dropping one at a time into a glass jar that is slowly filling up.">
	<defs>
		<linearGradient id="wa-glass" x1="0" y1="0" x2="1" y2="0">
			<stop offset="0" stop-color="#FFFFFF" stop-opacity="0.55" />
			<stop offset="0.3" stop-color="#FFFFFF" stop-opacity="0.15" />
			<stop offset="1" stop-color="#FFFFFF" stop-opacity="0.35" />
		</linearGradient>
		<radialGradient id="wa-coin" cx="0.35" cy="0.35" r="0.7">
			<stop offset="0" stop-color="#FFF1C4" />
			<stop style="stop-color:var(--glow)" offset="0.6" />
			<stop offset="1" stop-color="#C98A1E" />
		</radialGradient>
		<clipPath id="wa-inside">
			<path d="M128 262 C 116 300, 112 360, 120 400 C 128 432, 160 442, 214 442 C 268 442, 300 432, 308 400 C 316 360, 312 300, 300 262 Z" />
		</clipPath>
	</defs>
	<g class="falling">
		{FALLING.map(([x, y, s]) => (
			<g transform={`translate(${x} ${y}) scale(${s})`}>
				<ellipse style="stroke:var(--ink)" rx="18" ry="18" fill="url(#wa-coin)" stroke-opacity="0.35" stroke-width="2" />
			</g>
		))}
	</g>
	<g clip-path="url(#wa-inside)" class="stack">
		{STACK.map(([x, y]) => (
			<ellipse style="stroke:var(--ink)" cx={x} cy={y + 16} rx="19" ry="12" fill="url(#wa-coin)" stroke-opacity="0.3" stroke-width="2" />
		))}
	</g>
	<path style="stroke:var(--ink)" class="jar" d="M150 222 L278 222 L278 246 C 296 252, 302 258, 300 262 C 312 300, 316 360, 308 400 C 300 432, 268 442, 214 442 C 160 442, 128 432, 120 400 C 112 360, 116 300, 128 262 C 126 258, 132 252, 150 246 Z"
		fill="url(#wa-glass)" stroke-width="3" stroke-linejoin="round" />
	<rect style="fill:var(--ink)" x="142" y="206" width="144" height="20" rx="8" fill-opacity="0.85" />
	<path d="M140 290 C 136 320, 136 350, 140 380" fill="none" stroke="#FFFFFF" stroke-opacity="0.8" stroke-width="6" stroke-linecap="round" />
	<use href="#im" x="318" y="372" width="72" height="72" class="walker" />
</svg>

<style>
	.wealth-art {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
