---
/**
 * Night again. The seven lights of the day sit on the Intently figure (the head is the last one,
 * faith); the visitor picks where to begin. Below, the app family: the day laid out from dawn to
 * night, each app in its own hour's light (src/components/world/Hour.astro).
 */
import AppMark from '@intently/ui/AppMark.astro';
import { CHAPTERS, type ChapterId } from '../../data/chapters.ts';
import Postcard from '../world/Postcard.astro';
import Hour from '../world/Hour.astro';
import { siteUrl, statusLabel } from '../../data/apps.ts';

interface Props {
	/** The ground colour of the scene above it. */
	after: string;
}

const { after } = Astro.props;

/** "5:50 am" as minutes after midnight, so the page can tell which hour it is where the visitor is. */
const minutes = (clock: string) => {
	const [, h, m, half] = clock.match(/(\d+):(\d+) (am|pm)/)!;
	return ((+h % 12) + (half === 'pm' ? 12 : 0)) * 60 + +m;
};

// Where each light sits on the figure (400-unit frame), and which side its name goes.
const SPOTS: Record<ChapterId, [number, number, 'left' | 'right' | 'top']> = {
	time: [62, 300, 'left'],
	attention: [44, 205, 'left'],
	health: [88, 118, 'left'],
	wealth: [176, 62, 'top'],
	faith: [251, 51, 'top'],
	relationships: [322, 140, 'right'],
	self: [356, 262, 'right'],
};
---

<Postcard id="finale" after={after} label="begin-title">
	<div class="begin">
		<h2 id="begin-title" class="display">Where will you begin?</h2>
		<p class="lede">You don't have to fix seven things. Choose one light and start there.</p>
		<div class="constellation">
			<svg class="figure" viewBox="0 0 400 400" aria-hidden="true"><use href="#im" width="400" height="400" /></svg>
			<ol class="lights">
				{CHAPTERS.map((c) => {
					const [x, y, side] = SPOTS[c.id];
					return (
						<li class={side} style={`--x:${x / 4}%;--y:${y / 4}%;--light:${c.light}`}>
							<a href={c.path} data-light={c.id}>
								<span class="star" aria-hidden="true"></span>
								<span class="name">{c.name}</span>
							</a>
						</li>
					);
				})}
			</ol>
		</div>
	</div>
</Postcard>

<section class="family-wrap" aria-labelledby="apps-title">
	<div class="wrap family" id="apps">
		<h2 id="apps-title" class="display">Seven lights, one life.</h2>
		<p class="intro">We're a small, independent studio, and each of our apps looks after one of these lights.
			They're calm by default, with no streak guilt and no dark patterns. Each one says plainly what leaves your
			device and why. None of them shows ads, and we never sell your data.</p>
		<ol class="day">
			{CHAPTERS.map((c) => (
				<Hour as="li" chapter={c} land={64} data-from={minutes(c.clock)}>
					<div class="row">
						<a class="aspect" href={c.path}>
							<span class="clock">{c.clock}</span>
							<span class="name">{c.name}</span>
							<span class="now voice" hidden>about now</span>
						</a>
						<ul class="apps">
							{c.apps.map((a) => {
								const status = statusLabel(a);
								return (
									<li>
										<a class="app" href={siteUrl(a)}>
											<AppMark app={a} size={46} />
											<span class="text">
												<strong>{a.name}</strong>
												<span class="tagline">{a.tagline}</span>
												{status
													? <span class="status voice">{status}</span>
													: <span class="status out"><span class="star" aria-hidden="true"></span>{a.platforms.join(', ')}</span>}
											</span>
										</a>
									</li>
								);
							})}
						</ul>
					</div>
				</Hour>
			))}
		</ol>
	</div>
</section>

<script>
	// Which hour of the day is it for the visitor? That strip says so. Nothing leaves the page.
	const hours = [...document.querySelectorAll<HTMLElement>('.day [data-from]')];
	if (hours.length) {
		const d = new Date();
		const m = d.getHours() * 60 + d.getMinutes();
		// Before dawn it is still last night's lantern hour.
		const current = hours.filter((h) => +h.dataset.from! <= m).pop() ?? hours[hours.length - 1];
		current.querySelector<HTMLElement>('.now')?.removeAttribute('hidden');
	}
</script>

<style>
	.begin {
		text-align: center;
		max-width: none !important;
	}

	.family-wrap {
		position: relative;
		padding: 12vh 0 4vh;
		background: var(--soil);
		color: var(--soil-ink);
	}

	h2 {
		font-size: clamp(2.4rem, 5.4vw, 4.4rem);
		margin: 0 0 1rem;
	}

	.begin .lede {
		margin: 0 auto;
		color: var(--ink2);
	}

	.constellation {
		position: relative;
		width: min(100%, 360px, 42svh);
		aspect-ratio: 1;
		margin: 28px auto 0;
		text-shadow: none;
	}

	.figure {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		--intently-light: color-mix(in srgb, var(--ink) 6%, transparent);
		--intently-dark: color-mix(in srgb, var(--ink) 9%, transparent);
	}

	.lights {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.lights li {
		position: absolute;
		left: var(--x);
		top: var(--y);
	}

	.lights a {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 10px;
		transform: translate(-50%, -50%);
		padding: 8px;
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		white-space: nowrap;
	}

	.lights .left a { flex-direction: row-reverse; transform: translate(calc(-100% + 19px), -50%); }

	.lights .right a { transform: translate(-19px, -50%); }

	.lights .top a { flex-direction: column-reverse; transform: translate(-50%, calc(-100% + 19px)); gap: 4px; }

	.star {
		flex: none;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: radial-gradient(circle, #fff 0 22%, var(--light) 45%, transparent 72%);
		box-shadow: 0 0 22px color-mix(in srgb, var(--light) 70%, transparent);
		transition: transform 300ms var(--ease-out);
	}

	.lights a:hover .star,
	.lights a:focus-visible .star {
		transform: scale(1.4);
	}

	.lights a:hover .name { text-decoration: underline; text-underline-offset: 0.25em; }

	.family {
		max-width: 960px;
	}

	.intro {
		max-width: var(--measure);
		color: var(--soil-ink2);
		margin: 0 0 40px;
	}

	/* The day, dawn at the top and the lantern hour at the bottom: seven skies, one after another. */
	.day {
		list-style: none;
		margin: 0;
		padding: 0;
		border-radius: 30px;
		overflow: clip;
	}

	.row {
		display: grid;
		grid-template-columns: 172px minmax(0, 1fr);
		gap: 8px 24px;
		padding: 24px 32px 8px;
		/* The right of each strip belongs to its sun or moon. */
		max-width: 68%;
	}

	.aspect {
		display: grid;
		align-content: start;
		gap: 2px;
		text-decoration: none;
	}

	.clock {
		font-size: 0.9rem;
		font-weight: 550;
		color: var(--ink2);
		font-variant-numeric: tabular-nums;
	}

	.aspect .name {
		font-family: var(--serif);
		font-variation-settings: "SOFT" 100;
		font-size: 1.7rem;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.now {
		margin-top: 4px;
		font-size: 0.95rem;
		color: var(--ink2);
	}

	.aspect:hover .name,
	.app:hover strong { text-decoration: underline; text-underline-offset: 0.22em; text-decoration-thickness: 1.5px; }

	.apps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 16px;
	}

	.app {
		display: grid;
		grid-template-columns: 46px minmax(0, 1fr);
		align-items: start;
		gap: 14px;
		text-decoration: none;
	}

	.text {
		display: grid;
		line-height: 1.35;
	}

	.text strong { font-size: 1.08rem; font-weight: 680; }

	.tagline {
		color: var(--ink2);
		font-size: 0.95rem;
		text-wrap: pretty;
	}

	.status {
		margin-top: 4px;
		font-size: 0.92rem;
	}

	/* Out in the world: its light is on. */
	.status.out {
		display: flex;
		align-items: center;
		gap: 7px;
		font-weight: 600;
	}

	.status .star { width: 12px; height: 12px; box-shadow: 0 0 10px color-mix(in srgb, var(--light) 80%, transparent); }

	/* The hour you point at lifts its sun a little. */
	.day :global(.hour:hover .orb),
	.day :global(.hour:focus-within .orb) { transform: translateY(-5px) scale(1.06); }

	/* Too narrow for names around the figure: the lights become a simple list. */
	@media (max-width: 560px) {
		.constellation { aspect-ratio: auto; width: auto; margin-top: 36px; }
		.figure { display: none; }
		.lights { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 10px; }
		.lights li { position: static; }
		.lights a,
		.lights .left a,
		.lights .right a,
		.lights .top a {
			position: static;
			transform: none;
			flex-direction: row;
			gap: 8px;
			padding: 8px 14px 8px 8px;
			border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
			border-radius: 999px;
			background: color-mix(in srgb, var(--sky-top) 72%, transparent);
		}
		.row { grid-template-columns: 1fr; padding: 20px 20px 6px; max-width: 80%; }
		.aspect { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
		.now { flex-basis: 100%; margin: 0; }
		.aspect .name { font-size: 1.45rem; }
	}
</style>
