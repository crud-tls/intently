---
/** One chapter of the day on the home page: when it is, the thought, a way in, and its art. */
import AppMark from '@intently/ui/AppMark.astro';
import SceneArt from '../art/SceneArt.astro';
import type { Chapter } from '../../data/chapters.ts';
import { band, type SkyKey } from '../../data/sky.ts';
import { siteUrl } from '../../data/apps.ts';

interface Props {
	chapter: Chapter;
	prev: SkyKey;
	next: SkyKey;
	/** Art on the left, text on the right. */
	flip?: boolean;
}

const { chapter: c, prev, next, flip = false } = Astro.props;
const style = `--band:${band(prev, c.sky, next)};--band-dim:${band(prev, c.sky, next, true)};--light:${c.light}`;
const many = c.apps.length > 1;
---

<section id={c.id} class:list={['scene', { flip }]} data-sky={c.sky} data-chapter={c.id} style={style} aria-labelledby={`${c.id}-title`}>
	<div class="wrap inner">
		<div class="copy">
			<p class="when"><span class="light" aria-hidden="true"></span><span>{c.clock}</span><strong>{c.name}</strong></p>
			<h2 id={`${c.id}-title`} class="display">{c.title}</h2>
			{c.home.map((p) => <p class="body">{p}</p>)}
			<p class="go"><a class="button" href={c.path}>{c.deeper}</a></p>
			<p class="app-hint">
				<span class="marks" aria-hidden="true">{c.apps.map((a) => <AppMark app={a} size={30} />)}</span>
				<span>{many ? 'Our apps for this' : 'Our app for this'}:
					{c.apps.map((a, i) => (
						<>{i > 0 && (i === c.apps.length - 1 ? ' and ' : ', ')}<a href={siteUrl(a)}>{a.name}</a></>
					))}
				</span>
			</p>
		</div>
		<div class="art">
			<SceneArt id={c.id} />
		</div>
	</div>
</section>

<style>
	.scene {
		position: relative;
		min-height: 100svh;
		display: grid;
		align-items: center;
		padding: 16vh 0;
		background: var(--band);
	}

	@media (prefers-color-scheme: dark) {
		.scene { background: var(--band-dim); }
	}

	/* Once the live sky takes over (motion layer), the bands step back. */
	:global(html.sky-live) .scene { background: none; }

	.inner {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(32px, 6vw, 88px);
		align-items: center;
	}

	.flip .copy { order: 2; }

	.copy { max-width: 36rem; }

	.when strong {
		color: var(--ink);
		font-weight: 650;
	}

	h2 {
		font-size: clamp(2.4rem, 5.4vw, 4.4rem);
		margin: 0 0 1.4rem;
	}

	.body {
		font-size: clamp(1.05rem, 1.4vw, 1.2rem);
		line-height: 1.65;
		margin: 0 0 1rem;
		color: var(--ink);
		text-wrap: pretty;
	}

	.body + .body { color: var(--ink2); }

	.go { margin: 2rem 0 1.6rem; }

	.app-hint {
		display: flex;
		align-items: center;
		gap: 12px;
		margin: 0;
		font-size: 0.95rem;
		color: var(--ink2);
	}

	.app-hint a {
		color: var(--ink);
		font-weight: 650;
	}

	.marks {
		display: flex;
	}

	.marks :global(.mark + .mark) { margin-left: -8px; }

	.marks :global(.mark) { box-shadow: 0 0 0 2px var(--sky-bottom); }

	.art {
		width: min(100%, 440px);
		justify-self: center;
	}

	@media (max-width: 820px) {
		.scene { padding: 14vh 0 12vh; }
		.inner { grid-template-columns: 1fr; }
		.flip .copy { order: 0; }
		.art { width: min(78%, 340px); order: -1; }
	}
</style>
