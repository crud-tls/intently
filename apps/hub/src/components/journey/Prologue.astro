---
/**
 * Before dawn: the night the day begins from. Stars are scattered, the way a distracted day feels;
 * the finale gathers them into the mark. The logo keeps data-splash-target: the first-visit splash
 * flies the animated mark onto it.
 */
import { band } from '../../data/sky.ts';
import { seeded } from '../../scripts/lib/random.ts';

const rand = seeded(28);
const STARS = Array.from({ length: 110 }, () => ({
	x: +(rand() * 160).toFixed(2),
	y: +(rand() * 100).toFixed(2),
	r: +(0.6 + rand() * rand() * 1.8).toFixed(2),
	o: +(0.35 + rand() * 0.6).toFixed(2),
}));
const style = `--band:${band('night', 'night', 'dawn')}`;
---

<section class="prologue" data-sky="night" style={style} aria-labelledby="prologue-title">
	<svg class="stars" aria-hidden="true" preserveAspectRatio="xMidYMid slice" viewBox="0 0 160 100">
		{STARS.map((s) => <circle cx={s.x} cy={s.y} r={s.r / 7} opacity={s.o} />)}
	</svg>
	<div class="wrap copy">
		<img src="/brand/intently-logo.svg" alt="" width="88" height="88" class="logo" data-splash-target />
		<h1 id="prologue-title" class="display">Most days just happen.</h1>
		<p class="lede">Walk through one with us, from first light to the quiet after dark, and notice the seven
			places where a little intention goes a long way.</p>
		<a class="button" href="#time">Start at dawn</a>
	</div>
</section>

<style>
	.prologue {
		position: relative;
		min-height: 100svh;
		display: grid;
		place-items: center;
		padding: 120px 0 18vh;
		overflow: hidden;
		background: var(--band);
	}

	:global(html.sky-live) .prologue { background: none; }

	.stars {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		fill: var(--ink);
	}

	.copy {
		position: relative;
		text-align: center;
		max-width: 820px;
	}

	.logo {
		display: block;
		margin: 0 auto 28px;
	}

	h1 {
		font-size: clamp(3rem, 9vw, 7rem);
		margin: 0 0 1.5rem;
	}

	.lede {
		margin: 0 auto 2.2rem;
		color: var(--ink2);
	}
</style>
