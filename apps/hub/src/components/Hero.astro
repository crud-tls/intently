---
import AppMark from '@intently/ui/AppMark.astro';
import { APPS } from '@intently/registry';

// Where each app icon floats around the headline: [left %, top %, size px, drift delay s].
const SPOTS: [number, number, number, number][] = [
	[6, 14, 76, 0], [84, 10, 68, 1.2], [90, 58, 56, 2.1], [4, 66, 60, 0.6],
	[70, 80, 48, 1.7], [22, 84, 44, 2.6], [50, 4, 40, 3.1],
];
---

<section class="hero">
	<div class="float" aria-hidden="true">
		{APPS.slice(0, SPOTS.length).map((app, i) => {
			const [x, y, size, delay] = SPOTS[i];
			return (
				<span class="spot" style={`left:${x}%;top:${y}%;animation-delay:-${delay}s`}>
					<AppMark app={app} size={size} />
				</span>
			);
		})}
	</div>
	<div class="wrap copy">
		<img src="/brand/intently-logo.svg" alt="" width="88" height="88" class="logo" data-splash-target />
		<h1>Apps made with intent.</h1>
		<p class="lead">We're a small, independent studio. We make calm tools that help you spend your time
			on what matters, and we keep them honest about your data.</p>
		<a class="button" href="#apps">See our apps</a>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding: 110px 0 120px;
		background:
			radial-gradient(60% 70% at 15% 20%, rgb(3 169 244 / 0.16), transparent 70%),
			radial-gradient(55% 60% at 85% 30%, rgb(186 104 200 / 0.14), transparent 70%),
			radial-gradient(60% 60% at 60% 100%, rgb(255 138 61 / 0.12), transparent 70%);
	}

	.copy {
		position: relative;
		text-align: center;
		max-width: 760px;
	}

	.logo {
		display: block;
		margin: 0 auto 18px;
	}

	h1 {
		font-size: clamp(2.6rem, 7vw, 4.6rem);
		font-weight: 800;
	}

	.lead {
		font-size: 1.2rem;
		color: var(--text-2);
		margin: 0 auto 28px;
		max-width: 36rem;
	}

	.float {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.spot {
		position: absolute;
		animation: drift 9s ease-in-out infinite;
	}

	@keyframes drift {
		0%, 100% { transform: translate(0, 0) rotate(-3deg); }
		50% { transform: translate(6px, -14px) rotate(3deg); }
	}

	@media (prefers-reduced-motion: reduce) {
		.spot { animation: none; }
	}

	/* On narrow screens the icons sit only at the edges so they never cover the text. */
	@media (max-width: 720px) {
		.hero { padding: 72px 0 96px; }
		.spot { transform: scale(0.65); }
		.spot:nth-child(n + 5) { display: none; }
	}
</style>
