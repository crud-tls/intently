---
/** Questions to sit with: not a checklist, so no boxes and no numbers. */
interface Props {
	prompts: string[];
}

const { prompts } = Astro.props;
---

<section class="reflection" aria-labelledby="reflect-title">
	<h2 id="reflect-title" class="heading">Questions to sit with</h2>
	<ul>
		{prompts.map((p) => <li class="display">{p}</li>)}
	</ul>
</section>

<style>
	.heading {
		font-size: 1rem;
		font-weight: 650;
		color: var(--text-2);
		margin: 0 0 28px;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(28px, 5vw, 48px);
	}

	li {
		font-size: clamp(1.6rem, 3.4vw, 2.5rem);
		font-weight: 400;
		line-height: 1.18;
		max-width: 22ch;
	}

	li:nth-child(2) { margin-left: clamp(0px, 12vw, 160px); }

	li:nth-child(3) { margin-left: clamp(0px, 5vw, 64px); }
</style>
