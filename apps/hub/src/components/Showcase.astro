---
import AppMark from '@intently/ui/AppMark.astro';
import type { App } from '@intently/registry';

interface Props {
	app: App;
	flip?: boolean;
}

const { app, flip = false } = Astro.props;
const status = { live: null, review: 'On Google Play soon', soon: 'Coming soon' }[app.status];
const href = `https://${app.host}`;
---

<article class:list={['row', { flip }]} style={`--app:${app.color}`}>
	<div class="text">
		<AppMark app={app} size={56} />
		<h3>{app.name}</h3>
		<p class="tagline">{app.tagline}</p>
		{app.highlights && (
			<ul>
				{app.highlights.map((h) => <li>{h}</li>)}
			</ul>
		)}
		<p class="actions">
			{app.stores.play && <a class="button" href={app.stores.play}>Get it on Google Play</a>}
			{status && <span class="pill">{status}</span>}
			<a class="more" href={href}>Visit {app.name} &rarr;</a>
		</p>
		<p class="platforms">{app.platforms.join(' · ')}</p>
	</div>
	<a class="art" href={href} aria-label={`${app.name} website`}>
		<slot name="art"><AppMark app={app} size={160} /></slot>
	</a>
</article>

<style>
	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px;
		align-items: center;
		padding: 36px;
		border-radius: 32px;
		background: color-mix(in srgb, var(--app) 7%, var(--surface));
		border: 1px solid color-mix(in srgb, var(--app) 18%, var(--line));
	}

	.row + .row { margin-top: 24px; }

	.flip .text { order: 2; }

	h3 {
		font-size: clamp(1.8rem, 3.5vw, 2.4rem);
		margin: 16px 0 6px;
	}

	.tagline {
		font-size: 1.15rem;
		color: var(--text-2);
		margin: 0 0 16px;
	}

	ul {
		margin: 0 0 22px;
		padding-left: 1.2rem;
	}

	li { margin: 6px 0; }

	li::marker { color: var(--app); }

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px;
		margin: 0;
	}

	.pill {
		padding: 6px 14px;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--app) 45%, var(--line));
		font-size: 0.92rem;
	}

	.more {
		font-weight: 650;
		text-decoration: none;
	}

	.more:hover { text-decoration: underline; }

	.platforms {
		margin: 16px 0 0;
		font-size: 0.9rem;
		color: var(--text-2);
	}

	.art {
		text-decoration: none;
		color: inherit;
		display: grid;
		place-items: center;
		min-height: 320px;
		border-radius: 26px;
		background:
			radial-gradient(70% 70% at 50% 40%, color-mix(in srgb, var(--app) 34%, transparent), transparent 75%),
			color-mix(in srgb, var(--app) 14%, var(--surface));
	}

	@media (max-width: 820px) {
		.row { grid-template-columns: 1fr; padding: 24px; }
		.flip .text { order: 0; }
		.art { min-height: 240px; }
	}
</style>
