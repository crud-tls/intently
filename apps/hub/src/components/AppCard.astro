---
import type { App } from '@intently/registry';

interface Props {
	app: App;
}

const { app } = Astro.props;
const status = { live: null, review: 'On Google Play soon', soon: 'Coming soon' }[app.status];
const href = `https://${app.host}`;
---

<article class="card" style={`--app:${app.color}`}>
	<a href={href} class="cover" aria-label={`${app.name}: visit the site`}>
		{app.icon
			? <img src={app.icon} alt="" width="64" height="64" class="icon" />
			: <span class="icon monogram" aria-hidden="true">{app.name[0]}</span>}
	</a>
	<div class="body">
		<h3><a href={href}>{app.name}</a></h3>
		<p class="tagline">{app.tagline}</p>
		<p class="meta">
			<span>{app.platforms.join(' · ')}</span>
			{status && <span class="pill">{status}</span>}
		</p>
		{app.stores.play && <a class="store" href={app.stores.play}>Get it on Google Play</a>}
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		overflow: hidden;
		transition: transform 160ms ease, box-shadow 160ms ease;
	}

	.card:hover {
		transform: translateY(-3px);
		box-shadow: 0 14px 34px color-mix(in srgb, var(--app) 18%, transparent);
	}

	.cover {
		display: grid;
		place-items: center;
		height: 150px;
		background:
			radial-gradient(120% 90% at 30% 20%, color-mix(in srgb, var(--app) 30%, transparent), transparent 70%),
			color-mix(in srgb, var(--app) 12%, var(--surface));
	}

	.icon {
		width: 72px;
		height: 72px;
		border-radius: 18px;
		box-shadow: 0 8px 20px color-mix(in srgb, var(--app) 35%, transparent);
	}

	.monogram {
		display: grid;
		place-items: center;
		background: var(--app);
		color: #fff;
		font-weight: 800;
		font-size: 2rem;
	}

	.body { padding: 20px 22px 22px; }

	h3 { font-size: 1.3rem; margin-bottom: 6px; }

	h3 a { text-decoration: none; }

	.tagline { margin: 0 0 14px; color: var(--text-2); }

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		margin: 0;
		font-size: 0.88rem;
		color: var(--text-2);
	}

	.pill {
		padding: 2px 10px;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--app) 45%, var(--line));
		color: var(--text);
	}

	.store {
		display: inline-block;
		margin-top: 14px;
		font-weight: 650;
		font-size: 0.95rem;
	}
</style>
