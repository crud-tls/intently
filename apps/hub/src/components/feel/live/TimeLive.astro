---
/** Time, live: your age and a life length; the weeks fill the dawn sky (src/scripts/feel/time.ts). */
import { lifeWeeks, weeksLived } from '../../../scripts/lib/math.ts';

const AGE = 30;
const LIFE = 80;
const fmt = (n: number) => n.toLocaleString('en');
---

<div class="feel-live needs-js" data-feel="time">
	<div class="feel-stage" data-stage aria-hidden="true" style={`aspect-ratio:${LIFE} / 52`}></div>
	<p class="ask">{'Each light is one week of a life. Move the sliders and watch the weeks you have lived fill in.'}</p>
	<div class="fields">
		<label class="field">
			<span>Your age <output data-out="age">{AGE}</output></span>
			<input type="range" min="1" max="99" step="1" value={AGE} data-age />
		</label>
		<label class="field">
			<span>A life of <output data-out="life">{LIFE}</output> years</span>
			<input type="range" min="60" max="100" step="1" value={LIFE} data-life />
		</label>
	</div>
	<p class="readout" aria-live="polite">
		<span><strong data-out="lived">{fmt(weeksLived(AGE))}</strong> weeks lived.</span>
		<span data-ahead-line>About <strong data-out="ahead">{fmt(lifeWeeks(LIFE) - weeksLived(AGE))}</strong> ahead.</span>
		<span data-past hidden>Past the assumption: every week now is a gift.</span>
	</p>
	<p class="assume">The life length is an assumption, not a prediction. Nothing you choose leaves this page.</p>
</div>

<style>
	.feel-live {
		margin-top: 1.4rem;
		text-shadow: none;
	}

	.ask { margin: 0 0 1rem; color: var(--ink2); }

	.fields {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px 22px;
	}

	.field {
		display: grid;
		gap: 6px;
		font-weight: 600;
		font-size: 0.95rem;
	}

	output { font-variant-numeric: tabular-nums; }

	input[type="range"] {
		width: 100%;
		accent-color: var(--sky-accent);
	}

	.readout {
		margin: 1rem 0 0.4rem;
		font-family: var(--serif);
		font-variation-settings: "SOFT" 100;
		font-size: clamp(1.25rem, 2.2vw, 1.6rem);
		line-height: 1.3;
	}

	.readout strong {
		font-weight: 600;
		font-variant-numeric: tabular-nums lining-nums;
	}

	.assume {
		margin: 0;
		font-size: 0.85rem;
		color: var(--ink2);
	}

	/* Where the world draws the weeks (only while the live hero runs). */
	.feel-stage { display: none; }

	:global(html.hero-live) .feel-stage {
		display: block;
		width: 100%;
		margin-bottom: 14px;
	}

	@media (max-width: 520px) {
		.fields { grid-template-columns: 1fr; }
	}
</style>
