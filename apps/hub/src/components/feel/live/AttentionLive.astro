---
/** Attention, live: hold one slow breath to quiet the morning; see what phone hours add up to. */
import { hoursPerYear, wakingDays } from '../../../scripts/lib/math.ts';

const HOURS = 4;
const fmt = (n: number) => Math.floor(n).toLocaleString('en');
---

<div class="feel-live needs-js" data-feel="attention">
	<p class="ask">The morning is loud. Before you look, take one slow breath.</p>
	<button type="button" class="button breathe" data-breathe aria-pressed="false" aria-describedby="breathe-help">Hold to breathe</button>
	<p id="breathe-help" class="hint">Press and hold for about four seconds, or tap once to be guided.</p>
	<p class="cue" data-cue aria-live="polite"></p>
	<label class="field">
		<span>Hours on your phone a day <output data-out="hours">{HOURS}</output></span>
		<input type="range" min="0" max="12" step="0.5" value={HOURS} data-hours />
	</label>
	<p class="readout" aria-live="polite">
		<strong data-out="year">{fmt(hoursPerYear(HOURS))}</strong> hours a year: about
		<strong data-out="days">{fmt(wakingDays(hoursPerYear(HOURS)))}</strong> full waking days.
	</p>
	<p class="assume">A waking day is sixteen hours. Nothing you choose leaves this page.</p>
</div>

<style>
	.feel-live {
		margin-top: 1.4rem;
		text-shadow: none;
	}

	.ask { margin: 0 0 1rem; color: var(--ink2); }

	.breathe {
		min-width: 12rem;
		justify-content: center;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
		transition: transform 300ms var(--ease-out);
	}

	.breathe[aria-pressed="true"] { transform: scale(0.96); }

	.hint {
		margin: 0.5rem 0 0;
		font-size: 0.85rem;
		color: var(--ink2);
	}

	.cue {
		min-height: 1.6em;
		margin: 0.6rem 0 1rem;
		font-family: var(--serif);
		font-variation-settings: "SOFT" 100;
		font-size: 1.25rem;
	}

	.field {
		display: grid;
		gap: 6px;
		max-width: 22rem;
		font-weight: 600;
		font-size: 0.95rem;
	}

	output { font-variant-numeric: tabular-nums; }

	input[type="range"] {
		width: 100%;
		accent-color: var(--sky-accent);
	}

	.readout {
		margin: 0.9rem 0 0.4rem;
		font-family: var(--serif);
		font-variation-settings: "SOFT" 100;
		font-size: clamp(1.2rem, 2vw, 1.5rem);
		line-height: 1.3;
	}

	.readout strong { font-weight: 600; font-variant-numeric: tabular-nums lining-nums; }

	.assume { margin: 0; font-size: 0.85rem; color: var(--ink2); }

	@media (prefers-reduced-motion: reduce) {
		.breathe { transition: none; }
	}
</style>
