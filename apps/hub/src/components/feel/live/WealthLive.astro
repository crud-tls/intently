---
/** Wealth, live: a small daily amount fills the pond (src/scripts/feel/wealth.ts). */
import { setAside, withGrowth } from '../../../scripts/lib/math.ts';

interface Props {
	/** The chapter's own invitation (src/data/chapters.ts: feel.intro). */
	intro: string;
}

const { intro } = Astro.props;
const AMOUNT = 5;
const YEARS = 10;
// A few currencies people here use; formatting is the browser's (Intl), nothing is converted.
const CURRENCIES = [['', 'No currency'], ['USD', 'US dollar'], ['EUR', 'Euro'], ['GBP', 'Pound'], ['BDT', 'Taka'], ['INR', 'Rupee (India)'], ['PKR', 'Rupee (Pakistan)'], ['AED', 'Dirham'], ['SAR', 'Riyal'], ['MYR', 'Ringgit'], ['IDR', 'Rupiah']];
const n = (v: number) => Math.round(v).toLocaleString('en');
---

<div class="feel-live needs-js" data-feel="wealth">
	<p class="ask">{intro}</p>
	<div class="fields">
		<label class="field">
			<span>A day <output data-out="amount">{AMOUNT}</output></span>
			<input type="range" min="0.5" max="50" step="0.5" value={AMOUNT} data-amount />
		</label>
		<label class="field">
			<span>For <output data-out="years">{YEARS}</output> years</span>
			<input type="range" min="1" max="30" step="1" value={YEARS} data-years />
		</label>
		<label class="field">
			<span>Currency</span>
			<select data-currency>
				{CURRENCIES.map(([code, name]) => <option value={code}>{code ? `${code}, ${name}` : name}</option>)}
			</select>
		</label>
		<label class="field check">
			<input type="checkbox" data-growth />
			<span>Show it growing at 5% a year</span>
		</label>
	</div>
	<p class="readout" aria-live="polite">
		<strong data-out="perDay">{AMOUNT}</strong> a day is <strong data-out="year">{n(setAside(AMOUNT, 1))}</strong> a year and
		<strong data-out="total">{n(setAside(AMOUNT, YEARS))}</strong> in <span data-out="yearsAgain">{YEARS}</span> years, simply set aside.
	</p>
	<p class="grown" data-growth-line hidden>If it grew 5% a year: about <strong data-out="grown">{n(withGrowth(AMOUNT, YEARS, 0.05))}</strong>.
		An illustration only, before inflation and fees, and not advice.</p>
	<p class="assume">Nothing is converted or saved; nothing you choose leaves this page.</p>
</div>

<style>
	select {
		font: inherit;
		font-weight: 450;
		padding: 6px 10px;
		border-radius: 10px;
		border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
		background: color-mix(in srgb, var(--sky-top) 40%, #ffffff 60%);
		color: #1d1b18;
	}

	.check {
		display: flex;
		align-items: center;
		gap: 8px;
		align-self: end;
		font-weight: 500;
	}

	.check input { width: 18px; height: 18px; accent-color: var(--sky-accent); }

	.grown { margin: 0 0 0.6rem; font-size: 0.95rem; }
</style>
