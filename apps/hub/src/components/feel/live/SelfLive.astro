---
/** Self, live: hold still and the reflection sharpens; small acts light up (src/scripts/feel/self.ts). */
interface Props {
	/** The chapter's own invitation (src/data/chapters.ts: feel.intro). */
	intro: string;
}

const { intro } = Astro.props;
const ACTS = ['rested', 'kind', 'present', 'patient', 'honest', 'brave', 'grateful', 'generous', 'curious', 'steady', 'gentle with myself', 'upright'];
---

<div class="feel-live needs-js" data-feel="self">
	<p class="ask">{intro}</p>
	<p class="cue" data-cue aria-live="polite"></p>
	<p class="sentence">I'm becoming someone who is <span data-becoming>…</span>.</p>
	<div class="acts" role="group" aria-label="Small acts">
		{ACTS.map((a) => <button type="button" class="act" data-act={a} aria-pressed="false">{a}</button>)}
	</div>
	<p class="assume">Nothing you choose is saved or sent.</p>
</div>

<style>
	.sentence {
		margin: 0 0 0.9rem;
		font-family: var(--serif);
		font-variation-settings: "SOFT" 100;
		font-size: clamp(1.25rem, 2.2vw, 1.6rem);
		line-height: 1.3;
	}

	.acts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 0.8rem;
	}

	.act {
		font: inherit;
		font-size: 0.95rem;
		padding: 6px 14px;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
		background: transparent;
		color: var(--ink);
		cursor: pointer;
		transition: background-color 200ms ease, color 200ms ease;
	}

	.act[aria-pressed="true"] {
		background: var(--glow);
		border-color: var(--glow);
		color: #15183a;
		font-weight: 600;
	}

	.act:focus-visible { outline: 3px solid var(--sky-accent); outline-offset: 2px; }
</style>
