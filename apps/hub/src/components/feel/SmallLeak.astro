---
/** Wealth: a small daily amount, simply set aside, over one and ten years. */
import FeelFrame from './FeelFrame.astro';
import Tally from '../Tally.astro';
import { setAside } from '../../scripts/lib/math.ts';

interface Props {
	caption: string;
	perDay?: number;
}

const { caption, perDay = 5 } = Astro.props;
const fmt = (n: number) => Math.round(n).toLocaleString('en');
---

<FeelFrame caption={caption}>
	<Tally lines={[
		{ key: 'perDay', value: fmt(perDay), unit: 'a day' },
		{ key: 'year', value: fmt(setAside(perDay, 1)), unit: 'in a year' },
		{ key: 'ten', value: fmt(setAside(perDay, 10)), unit: 'in ten years' },
	]} />
</FeelFrame>
