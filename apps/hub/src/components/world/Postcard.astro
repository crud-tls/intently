---
/**
 * A scene of the day as a full-screen landscape with words in its sky. The landscape is a static
 * SVG (src/world/render-svg.ts); <picture> hands phones the tall composition. When the live world
 * runs (html.world-live), the picture steps aside and the shared canvas shows through.
 */
import { scene as getScene, type SceneId } from '../../world/scenes.ts';
import { SKY } from '../../data/sky.ts';

interface Props {
	id: SceneId;
	/** The first scene on a page loads at once; the rest wait until they're near. */
	eager?: boolean;
	/** The ground colour of the scene above, so stacked postcards meet softly. */
	after?: string;
	as?: 'section' | 'header';
	label?: string;
	class?: string;
}

const { id, eager = false, after, as: Tag = 'section', label, class: className } = Astro.props;
const scene = getScene(id);
const style = after ? `--after:${after}` : undefined;
---

<Tag id={Tag === 'section' ? id : undefined} class:list={['postcard', `words-${scene.words}`, className]} data-scene={id} data-sky={scene.sky}
	style={style} aria-labelledby={label}>
	<picture class="land" aria-hidden="true">
		<source media="(max-aspect-ratio: 1/1)" srcset={`/world/${id}-tall.svg`} />
		<img src={`/world/${id}-wide.svg`} alt="" width="2800" height="1000" loading={eager ? 'eager' : 'lazy'}
			decoding="async" fetchpriority={eager ? 'high' : undefined} />
	</picture>
	<div class="wrap words sky-words">
		<slot />
	</div>
</Tag>

<style>
	.postcard {
		position: relative;
		min-height: 100svh;
		overflow: clip;
		background: var(--sky-top);
		isolation: isolate;
	}

	/* Postcards stacked without the live world meet in a short fade from the ground above. */
	.postcard[style*="--after"]::before {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: 14svh;
		z-index: 1;
		background: linear-gradient(var(--after), transparent);
		pointer-events: none;
	}

	.land {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.land img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 100%;
		display: block;
	}

	/* display:none (not visibility) so lazy landscapes further down are never fetched. */
	:global(html.world-live) .land,
	:global(html.world-live) .postcard::before { display: none; }

	:global(html.world-live) .postcard { background: none; }

	.words {
		position: relative;
		z-index: 2;
		padding-top: max(96px, 13svh);
		padding-bottom: 50svh;
	}

	.words-center .words { text-align: center; }

	.words-center .words :global(.when) { justify-content: center; }

	.words-right .words { display: flex; flex-direction: column; align-items: flex-end; text-align: left; }

	.words > :global(*) { max-width: 34rem; }

	.words-center .words > :global(*) { margin-inline: auto; }
</style>
