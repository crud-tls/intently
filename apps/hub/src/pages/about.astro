---
import Base from '../layouts/Base.astro';
import Postcard from '../components/world/Postcard.astro';
import AppMark from '@intently/ui/AppMark.astro';
import { STUDIO } from '@intently/registry';
import { CHAPTERS } from '../data/chapters.ts';
import { siteUrl } from '../data/apps.ts';
---

<Base title="About" sky="night" description="Intently is a small independent studio making calm, private apps for living each part of the day on purpose.">
	<main>
		<Postcard id="finale" as="header" eager label="about-title">
			<h1 id="about-title" class="display">A small studio for intentional days.</h1>
		</Postcard>

		<div class="wrap prose">
			<p class="lede">Intently is a small, independent app studio. We make calm tools for the parts of a day that
				matter: your time, your attention, your health, your money, the people you love, who you're becoming,
				and the quiet at the end of it.</p>
			<p>Intently is run by {STUDIO.owner}, a software engineer who builds Android, iOS and web apps. Every app
				here started as something we needed ourselves.</p>

			<h2 class="display">What we believe</h2>
			<ul class="beliefs">
				<li><strong>Small and calm beats big and loud.</strong> An app should earn its place on your phone.</li>
				<li><strong>No guilt, no dark patterns.</strong> Our apps nudge, then get out of the way.</li>
				<li><strong>Say plainly what happens to data.</strong> Each app's privacy policy is written from its code, not from a template.</li>
				<li><strong>No ads, no data selling.</strong> Ever.</li>
			</ul>

			<h2 class="display">One app for each part of the day</h2>
			<ul class="apps">
				{CHAPTERS.map((c) => (
					<li style={`--light:${c.light}`}>
						<a class="aspect" href={c.path}><span class="star" aria-hidden="true"></span>{c.name}</a>
						<span class="list">
							{c.apps.map((a) => (
								<a class="app" href={siteUrl(a)}><AppMark app={a} size={28} /> {a.name}</a>
							))}
						</span>
					</li>
				))}
			</ul>

			<p class="go"><a class="button" href="/contact/">Get in touch</a></p>
		</div>
	</main>
</Base>

<style>
	h1 {
		font-size: clamp(2.6rem, 6vw, 5rem);
		margin: 0;
		max-width: 14ch !important;
		margin-inline: auto;
	}

	.prose {
		max-width: 760px;
		padding-top: 56px;
	}

	h2 {
		font-size: clamp(1.7rem, 3.4vw, 2.4rem);
		margin: 2.4em 0 0.8em;
	}

	.beliefs li { margin: 10px 0; }

	.apps {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--line);
	}

	.apps li {
		display: grid;
		grid-template-columns: 170px 1fr;
		align-items: center;
		gap: 16px;
		padding: 14px 0;
		border-bottom: 1px solid var(--line);
	}

	.aspect {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--serif);
		font-variation-settings: "SOFT" 100;
		font-size: 1.2rem;
		text-decoration: none;
	}

	.star {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: radial-gradient(circle, #fff 0 22%, var(--light) 50%, transparent 74%);
		box-shadow: 0 0 14px color-mix(in srgb, var(--light) 70%, transparent);
	}

	.list { display: flex; flex-wrap: wrap; gap: 8px 18px; }

	.app {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
		text-decoration: none;
	}

	.app:hover, .aspect:hover { text-decoration: underline; text-underline-offset: 0.2em; }

	.go { margin-top: 48px; }

	@media (max-width: 560px) {
		.apps li { grid-template-columns: 1fr; gap: 8px; }
	}
</style>
