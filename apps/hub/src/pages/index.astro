---
import Base from '../layouts/Base.astro';
import Splash from '../components/Splash.astro';
import Prologue from '../components/journey/Prologue.astro';
import ChapterScene from '../components/journey/ChapterScene.astro';
import DayRail from '../components/journey/DayRail.astro';
import Finale from '../components/journey/Finale.astro';
import { CHAPTERS } from '../data/chapters.ts';

// The day runs from the night before (the prologue) to the night after (the finale).
const skies = ['night' as const, ...CHAPTERS.map((c) => c.sky), 'night' as const];
---

<Base splash sky="night" title="Intently"
	description="Most days just happen. Intently makes calm, private apps for living them on purpose: your time, attention, health, money, people, self and faith.">
	<Splash />
	<DayRail />
	<main class="journey">
		<Prologue />
		{CHAPTERS.map((c, i) => (
			<ChapterScene chapter={c} prev={skies[i]} next={skies[i + 2]} flip={i % 2 === 1} />
		))}
		<Finale />
	</main>
</Base>
