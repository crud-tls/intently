---
/**
 * A chapter page: the moment of the day (hero), a way to feel it (slot "feel"), questions to sit
 * with, one practice, the app we made for it, and the rest of the day. The page lives under its
 * chapter's sky.
 */
import Base from './Base.astro';
import Postcard from '../components/world/Postcard.astro';
import Reflection from '../components/Reflection.astro';
import Practice from '../components/Practice.astro';
import AppCard from '../components/AppCard.astro';
import { neighbours, type Chapter } from '../data/chapters.ts';
import { STUDIO } from '@intently/registry';

interface Props {
	chapter: Chapter;
}

const { chapter: c } = Astro.props;
const { prev, next } = neighbours(c.id);
const url = new URL(c.path, Astro.site).href;
const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${url}#page`,
		url,
		name: c.meta.title,
		description: c.meta.description,
		isPartOf: { '@type': 'WebSite', name: STUDIO.name, url: STUDIO.url },
		publisher: { '@id': `${STUDIO.url}/#organization` },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: STUDIO.name, item: `${STUDIO.url}/` },
			{ '@type': 'ListItem', position: 2, name: c.name, item: url },
		],
	},
];
const isFirst = c.id === 'time';
const isLast = c.id === 'faith';
---

<Base title={c.meta.title} description={c.meta.description} sky={c.sky} schema={schema}>
	<main class="chapter" data-chapter={c.id} style={`--light:${c.light}`}>
		<Postcard id={c.id} as="header" eager class="hero">
			<p class="when"><span class="light" aria-hidden="true"></span><span>{c.clock}</span><strong>{c.name}</strong></p>
			<h1 class="display">{c.title}</h1>
		</Postcard>

		<div class="wrap intro">
			{c.lede.map((p) => <p class="lede">{p}</p>)}
		</div>

		<section class="wrap feel" aria-labelledby="feel-title">
			<h2 id="feel-title" class="display">{c.feel.heading}</h2>
			<slot name="feel" />
			{c.feel.assumptions.length > 0 && (
				<ul class="assumptions" aria-label="Assumptions">
					{c.feel.assumptions.map((a) => <li>{a}</li>)}
				</ul>
			)}
		</section>

		<div class="wrap narrow">
			<Reflection prompts={c.reflection} />
		</div>

		<div class="wrap narrow">
			<Practice heading={c.practice.heading} body={c.practice.body} />
		</div>

		<section class="wrap narrow apps" aria-labelledby="apps-title">
			<h2 id="apps-title" class="display">{c.apps.length > 1 ? 'The apps we made for this' : 'The app we made for this'}</h2>
			<p class="lede">{c.appLine}</p>
			{c.apps.map((a) => <AppCard app={a} />)}
		</section>

		<nav class="wrap narrow day" aria-label="The rest of the day">
			<a class="prev" href={prev.path} data-sky={prev.sky}>
				<span class="dir">{isFirst ? 'The night before' : 'Earlier'}</span>
				<span class="when"><span class="light" aria-hidden="true" style={`--light:${prev.light}`}></span><span>{prev.clock}</span><strong>{prev.name}</strong></span>
				<span class="title display">{prev.title}</span>
			</a>
			<a class="next" href={next.path} data-sky={next.sky}>
				<span class="dir">{isLast ? 'Tomorrow, at dawn' : 'Later'}</span>
				<span class="when"><span class="light" aria-hidden="true" style={`--light:${next.light}`}></span><span>{next.clock}</span><strong>{next.name}</strong></span>
				<span class="title display">{next.title}</span>
			</a>
		</nav>
	</main>
</Base>

<style>
	h1 {
		font-size: clamp(2.8rem, 6.4vw, 5.6rem);
		margin: 0;
	}

	.intro {
		padding-top: 56px;
	}

	.intro .lede { margin: 0 0 1rem; }

	.feel {
		padding-top: 40px;
	}

	.feel > h2,
	.apps > h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin: 0 0 1rem;
	}

	.assumptions {
		margin: 24px 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.92rem;
		color: var(--text-2);
		max-width: var(--measure);
	}

	.assumptions li { margin: 4px 0; }

	.assumptions li::before {
		content: "";
		display: inline-block;
		width: 6px;
		height: 6px;
		margin-right: 10px;
		border-radius: 50%;
		background: var(--light);
		vertical-align: 0.15em;
	}

	.narrow {
		max-width: 860px;
		margin-top: clamp(80px, 12vw, 140px);
	}

	.apps .lede { margin: 0 0 24px; }

	.day {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.day a {
		display: grid;
		gap: 10px;
		align-content: start;
		padding: 28px;
		border-radius: 30px;
		text-decoration: none;
		background: linear-gradient(180deg, var(--sky-top), var(--sky-upper));
		color: var(--ink);
		transition: transform 300ms var(--ease-out);
	}

	.day a:hover { transform: translateY(-3px); }

	.day .next { text-align: right; justify-items: end; }

	.day .when { margin: 0; color: var(--ink2); }

	.day .when strong { color: var(--ink); }

	.dir {
		font-weight: 650;
		font-size: 0.95rem;
	}

	.day .title {
		font-size: clamp(1.3rem, 2.4vw, 1.7rem);
	}

	@media (max-width: 820px) {
		.day { grid-template-columns: 1fr; }
		.day .next { text-align: left; justify-items: start; }
	}

	@media (prefers-reduced-motion: reduce) {
		.day a { transition: none; }
		.day a:hover { transform: none; }
	}
</style>
