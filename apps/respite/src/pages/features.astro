---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import { SITE_TITLE } from '../consts';
import { content } from '../content';

const features = [
	{
		icon: "BarChart3",
		title: "Finally See the Truth",
		description: "You tell yourself it's only 20 minutes. The data tells a different story. Respite shows you exactly where your time goes—without judgment.",
		details: ["Daily time summaries", "Per-app usage breakdown", "Weekly and monthly trends", "Streaks and daily totals"],
		color: "blue"
	},
	{
		icon: "Target",
		title: "Set Boundaries You Actually Keep",
		description: "Choose how much time feels right for each app. When you're getting close, Respite lets you know, with a gentle heads-up and no lectures. On iPhone you can also turn on an app lock that covers an app once today's time is used.",
		details: ["Daily time limits per app", "Visual progress rings", "Goal achievement celebrations", "Adjust limits any time"],
		color: "green"
	},
	{
		icon: "Bell",
		title: "The 3-Second Pause That Changes Everything",
		description: "Before an app opens, a simple screen appears: 'Is this what you want to be doing right now?' That tiny moment is all it takes.",
		details: ["A pause before the apps you pick", "Leave, or continue after a moment", "Timers and daily limits", "Reflection questions (Android and Chrome)"],
		color: "purple"
	},
	{
		icon: "Trophy",
		title: "Celebrate Every Win (Even the Small Ones)",
		description: "Day 1 feels small. Day 7 feels like something. Day 30 feels like you're becoming someone new. Respite tracks your streaks because lasting change deserves recognition.",
		details: ["Daily streak tracking", "Milestone celebrations", "Streak freezes in newer versions", "Gentle, no-guilt reminders"],
		color: "orange"
	},
	{
		icon: "TrendingUp",
		title: "Watch Your Progress Unfold",
		description: "Beautiful charts show your journey over days, weeks, and months. See your baseline shrink, and feel the pride of measurable progress.",
		details: ["Usage trend charts", "Day-by-day comparisons", "Weekly and monthly views", "Richer insights with Respite Plus"],
		color: "blue"
	},
	{
		icon: "Brain",
		title: "Ask Yourself: Is This What I Want?",
		description: "On Android and Chrome, the pause rotates reflection questions, a short guided breathing exercise, your own usage stats, quotes and activity suggestions. On iPhone, the pause is Apple's Screen Time shield. It's mindfulness, built into your phone.",
		details: ["Reflection questions (Android and Chrome)", "Guided breathing exercise (Android and Chrome)", "Your own usage stats in the pause", "Quotes and activity suggestions"],
		color: "green"
	},
	{
		icon: "Smartphone",
		title: "Your Progress, At a Glance",
		description: "On Android, a widget on your home screen shows your streak and today's progress. One look is often enough to remind you of who you're becoming.",
		details: ["Home screen widgets (Android)", "Quick settings toggle (Android)", "One-tap stats view", "Streak at a glance"],
		color: "purple"
	},
	{
		icon: "Lock",
		title: "Your Data Stays Yours",
		description: "No account needed for the core features, and your usage history stays on your device unless you turn on sync. There are no ads, and we never sell your data.",
		details: ["History stored on your device", "No account needed (sign in only for sync)", "No ads", "We never sell your data"],
		color: "green"
	}
];

const featureFAQs = [
	{
		question: "Is Respite free?",
		answer: "Yes. Respite is free on iPhone, Android and Chrome, with no ads. The pause, usage tracking, daily limits and streaks all work without paying. An optional upgrade, Respite Plus, adds sync across your devices and extras such as more schedules, longer focus sessions and richer insights."
	},
	{
		question: "Does Respite need an account?",
		answer: "No. You can use Respite's core features without signing in. An account (Google or Apple sign-in) is only needed if you want to sync across devices with Respite Plus. Without one, your usage history stays on your device."
	},
	{
		question: "Does Respite work on iPhone?",
		answer: "Yes. Respite is available for iPhone, Android and Chrome. The iPhone app is built on Apple's Screen Time, so the pause appears as Apple's Screen Time shield before the apps you pick. It also offers daily limits and an app lock that covers an app once today's time is used, refreshing at midnight."
	},
	{
		question: "How is Respite different from app blockers?",
		answer: "Blockers shut an app down. Respite puts a short, gentle pause in front of the apps you pick, so you open them on purpose rather than by reflex. You can leave or continue after a moment. It also tracks your usage, keeps streaks and lets you set daily limits, so you see the pattern as well as interrupt it."
	},
	{
		question: "Does Respite collect my data?",
		answer: "Your usage history stays on your device unless you turn on sync. Respite shows no ads and never sells your data. On iPhone, Apple's Screen Time keeps the apps you pick private, even from Respite. Each version's privacy policy lists exactly what it collects, including any anonymous analytics or crash reports."
	},
	{
		question: "Can I use Respite on multiple devices?",
		answer: "Yes. Respite runs on iPhone, Android and Chrome, and each device works on its own with its own history and settings. If you want your progress synced across devices, the optional Respite Plus upgrade adds sync, which requires signing in with Google or Apple."
	}
];

const colorMap: Record<string, string> = {
	blue: 'var(--ds-primary)',
	green: 'var(--ds-green)',
	orange: 'var(--ds-orange)',
	purple: 'var(--ds-purple)'
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="How Respite Works | Mindful Screen Time Features" description="Usage tracking that opens your eyes, pauses that feel like a deep breath, and streaks that build quiet pride. See how Respite helps you scroll less." />
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://respite.liveintently.app" },
				{ name: "Features", url: "https://respite.liveintently.app/features/" }
			]}
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- Features Hero - Glass -->
			<section class="features-hero">
				<div class="hero-glow" aria-hidden="true"></div>
				<div class="container">
					<h1 class="text-gradient">Everything You Need to Take Back Control</h1>
					<p class="hero-subtitle">Respite uses a gentle pause, not shame, to help you open apps on purpose. Free on iPhone, Android and Chrome, with no ads.</p>
				</div>
			</section>

			<!-- What is Respite - Glass Intro -->
			<section class="intro-section">
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<h2>What is Respite?</h2>
						<div class="glass-intro-card">
							<p class="direct-answer">
								Respite is a <strong>privacy-first digital wellbeing app</strong> that helps you build healthier relationships with technology. Instead of just blocking apps, it uses <strong>mindful interventions</strong> to create moments of awareness, helping you make conscious choices about screen time. It's free with no ads, your usage history stays on your device, you only sign in if you want sync, and it runs on iPhone, Android and Chrome.
							</p>
						</div>
						<p class="intro-links">
							Learn more about our privacy-first approach (<a href="/privacy/">iPhone</a>, <a href="/privacy/android/">Android</a>, <a href="/privacy/chrome/">Chrome</a>) or <a href="/download/">download Respite today</a> to start building healthier digital habits.
						</p>
					</ScrollReveal>
				</div>
			</section>

			<!-- Core Features - Asymmetric Bento Grid -->
			<section class="bento-section">
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<h2 class="section-title">Core Features</h2>
					</ScrollReveal>

					<ScrollReveal animation="fadeUp">
						<div class="bento-grid">
							{features.map((feature, index) => (
								<div class={`bento-card ${index === 0 ? 'bento-hero-card' : index === 7 ? 'bento-privacy-card' : 'bento-standard'}`} style={`--card-delay: ${[0, 0, 100, 200, 0, 100, 0, 100][index]}ms`}>
									<div class="bento-feature-header">
										<div class={`bento-icon bento-icon-${feature.color}`}>
											<Icon name={feature.icon} size={index === 0 ? 32 : 24} color={colorMap[feature.color]} />
										</div>
										<h3>{feature.title}</h3>
									</div>
									<p class="bento-description">{feature.description}</p>
									<ul class="bento-details">
										{feature.details.map(detail => <li>{detail}</li>)}
									</ul>
								</div>
							))}
						</div>
					</ScrollReveal>
				</div>
			</section>

			<!-- What each platform does -->
				<section class="platform-section">
					<div class="container">
						<ScrollReveal animation="fadeUp">
							<h2 class="section-title">What Each Version Does</h2>
							<p class="platform-lead">Respite is the same idea on every device, but each app is built for its platform. Features below belong only to the platform they are listed under.</p>
							<div class="platform-columns">
								{content.platforms.map((p) => (
									<div class="platform-col">
										<h3>{p.title}</h3>
										<p>{p.summary}</p>
										<ul>{p.features.map((f) => <li>{f}</li>)}</ul>
										<p class="platform-links"><a href={p.privacy}>Privacy policy</a>{p.terms && <> · <a href={p.terms}>Terms</a></>}</p>
									</div>
								))}
							</div>
						</ScrollReveal>
					</div>
				</section>

				<!-- How It Works - Glass Step Cards -->
			<section class="how-it-works">
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<h2 class="section-title">How Respite Works</h2>
					</ScrollReveal>

					<ScrollReveal animation="fadeUp">
					<div class="steps-timeline">
						<div class="timeline-step">
							<div class="step-number-wrapper">
								<div class="step-marker step-1">
									<span class="step-number">1</span>
								</div>
								<div class="timeline-connector"></div>
							</div>
							<div class="step-glass-card">
								<h3>Notice</h3>
								<p>Respite quietly observes which apps pull you in. Within a day, you'll see exactly where your time goes.</p>
							</div>
						</div>

						<div class="timeline-step">
							<div class="step-number-wrapper">
								<div class="step-marker step-2">
									<span class="step-number">2</span>
								</div>
								<div class="timeline-connector"></div>
							</div>
							<div class="step-glass-card">
								<h3>Pause</h3>
								<p>When you reach for a distracting app on autopilot, a gentle pause appears. Not to scold you—to ask: 'Is this what you want right now?'</p>
							</div>
						</div>

						<div class="timeline-step">
							<div class="step-number-wrapper">
								<div class="step-marker step-3">
									<span class="step-number">3</span>
								</div>
							</div>
							<div class="step-glass-card">
								<h3>Transform</h3>
								<p>Small choices compound. Each time you pause, you get a little better at choosing on purpose, and your streak shows it.</p>
							</div>
							</div>
					</div>
				</ScrollReveal>
				</div>
			</section>

			<!-- FAQ Section - Glass Cards -->
			<section class="faq-section">
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<h2 class="section-title">Frequently Asked Questions</h2>
					</ScrollReveal>

					<ScrollReveal animation="fadeUp">
						<div class="faq-list">
							{featureFAQs.map((faq) => (
								<details class="faq-glass-card">
									<summary>{faq.question}</summary>
									<p>{faq.answer}</p>
								</details>
							))}
						</div>
					</ScrollReveal>
				</div>
			</section>

			<!-- FAQ Schema -->
			<FAQSchema faqs={featureFAQs} />

			<!-- CTA Section - Enhanced -->
			<section class="cta-section">
				<div class="cta-divider" aria-hidden="true"></div>
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<div class="cta-glass">
							<h2>Ready to Take Back Control?</h2>
							<p>Change your relationship with your phone, one gentle pause at a time. Free, no ads, account optional.</p>
							<div class="cta-buttons" data-placement="final_cta">
								<Button href="/download/" variant="primary" size="lg">Download Free</Button>
								<Button href="/support/" variant="secondary" size="lg">Get Support</Button>
							</div>
						</div>
					</ScrollReveal>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* ============================
	   HERO - Glass with gradient
	   ============================ */
	.features-hero {
		width: 100%;
		padding: var(--ds-space-2xl) 0;
		background: linear-gradient(180deg, var(--ds-bg-accent) 0%, var(--ds-bg-secondary) 100%);
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.features-hero::before {
		content: '';
		display: block;
		height: 7rem;
	}

	.hero-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 600px;
		height: 400px;
		background: radial-gradient(ellipse, rgba(var(--ds-brand-rgb),  0.12) 0%, transparent 70%);
		filter: blur(60px);
		pointer-events: none;
	}

	.text-gradient {
		font-size: 2rem;
		font-weight: 800;
		margin: 0 0 var(--ds-space-md);
		letter-spacing: -0.02em;
		line-height: 1.2;
		background: linear-gradient(135deg, var(--ds-primary) 0%, var(--ds-purple) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		max-width: 700px;
		margin: 0 auto;
		color: var(--ds-text-secondary);
		line-height: 1.6;
	}

	@media (prefers-color-scheme: dark) {
		.hero-glow {
			background: radial-gradient(ellipse, rgba(var(--ds-brand-rgb),  0.08) 0%, transparent 70%);
		}
	}

	/* ============================
	   INTRO SECTION - Glass card
	   ============================ */
	.intro-section {
		width: 100%;
		padding: var(--ds-space-2xl) 0;
		background: var(--ds-bg-secondary);
		text-align: center;
	}

	.intro-section h2 {
		font-size: 2rem;
		font-weight: 700;
		margin: 0 0 var(--ds-space-lg);
		color: var(--ds-text-primary);
	}

	.glass-intro-card {
		max-width: 800px;
		margin: 0 auto;
		padding: var(--ds-space-2xl);
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		border-radius: 24px;
	}

	.direct-answer {
		font-size: 1.125rem;
		line-height: 1.75;
		color: var(--ds-text-secondary);
		margin: 0;
	}

	.direct-answer strong {
		color: var(--ds-text-primary);
		font-weight: 600;
	}

	.intro-links {
		font-size: 1rem;
		max-width: 800px;
		margin: var(--ds-space-lg) auto 0;
		color: var(--ds-text-secondary);
	}

	.intro-links a {
		color: var(--ds-primary);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: var(--ds-transition-normal);
	}

	.intro-links a:hover {
		border-bottom-color: var(--ds-primary);
	}

	@media (prefers-color-scheme: dark) {
		.glass-intro-card {
			background: rgba(21, 38, 47, 0.75);
			border: 1px solid rgba(255, 255, 255, 0.12);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 4px 20px rgba(0, 0, 0, 0.4);
		}
	}

	/* ============================
	   BENTO SECTION - Asymmetric
	   ============================ */
	.bento-section {
		width: 100%;
		padding: var(--ds-space-2xl) 0;
		background: var(--ds-bg-secondary);
	}

	.section-title {
		font-size: 2rem;
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--ds-space-2xl);
		color: var(--ds-text-primary);
	}

	.bento-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		max-width: 1100px;
		margin: 0 auto;
	}

	/* Base glass card */
	.bento-card {
		position: relative;
		border-radius: 24px;
		overflow: hidden;
		padding: 1.5rem;
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@media (hover: hover) {
		.bento-card:hover {
			transform: scale(1.02);
		}

		.bento-card:hover .bento-icon::before {
			opacity: 0.25;
			transform: scale(1.3);
		}
	}

	@media (prefers-color-scheme: dark) {
		.bento-card {
			background: rgba(21, 38, 47, 0.75);
			border: 1px solid rgba(255, 255, 255, 0.12);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 4px 20px rgba(0, 0, 0, 0.4);
		}
	}

	/* Hero card: full width */
	.bento-hero-card {
		padding: 2rem;
	}

	.bento-hero-card h3 {
		font-size: 1.375rem;
	}

	/* Privacy card: wider */
	.bento-privacy-card {
		padding: 2rem;
	}

	/* Feature header with icon */
	.bento-feature-header {
		display: flex;
		align-items: flex-start;
		gap: var(--ds-space-md);
		margin-bottom: var(--ds-space-md);
	}

	/* Icon with glow */
	.bento-icon {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		flex-shrink: 0;
	}

	.bento-icon::before {
		content: '';
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		opacity: 0.15;
		transition: opacity 0.4s ease, transform 0.4s ease;
	}

	.bento-icon-blue::before { background: radial-gradient(circle, var(--ds-primary), transparent 70%); }
	.bento-icon-green::before { background: radial-gradient(circle, var(--ds-green), transparent 70%); }
	.bento-icon-purple::before { background: radial-gradient(circle, var(--ds-purple), transparent 70%); }
	.bento-icon-orange::before { background: radial-gradient(circle, var(--ds-orange), transparent 70%); }

	.bento-feature-header h3 {
		font-size: 1.125rem;
		font-weight: 700;
		margin: 0.5rem 0 0;
		color: var(--ds-text-primary);
		line-height: 1.3;
		letter-spacing: -0.01em;
	}

	.bento-description {
		color: var(--ds-text-secondary);
		line-height: 1.6;
		margin: 0 0 var(--ds-space-md);
		font-size: 0.9375rem;
	}

	.bento-details {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.bento-details li {
		padding: 0.25rem 0 0.25rem 1.25rem;
		position: relative;
		font-size: 0.875rem;
		color: var(--ds-text-secondary);
		line-height: 1.5;
	}

	.bento-details li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 6px;
		height: 6px;
		background: var(--ds-primary);
		border-radius: 50%;
	}

	/* ============================
	   HOW IT WORKS - Glass Steps
	   ============================ */
	.platform-section { width: 100%; padding: var(--ds-space-2xl) 0; background: var(--ds-bg-secondary); }
	.platform-lead { max-width: 700px; margin: 0 auto var(--ds-space-xl); text-align: center; color: var(--ds-text-secondary); }
	.platform-columns { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ds-space-lg); }
	.platform-col { padding: var(--ds-space-lg); border-radius: var(--ds-radius-lg); background: var(--ds-bg-primary); border: 1px solid var(--ds-gray-200); }
	.platform-col h3 { margin: 0 0 var(--ds-space-sm); color: var(--ds-text-primary); }
	.platform-col p { color: var(--ds-text-secondary); }
	.platform-col ul { padding-left: 1.2rem; color: var(--ds-text-primary); }
	.platform-col li { margin: 0.35rem 0; }
	.platform-links a { color: var(--ds-primary); font-weight: 600; }
	@media (max-width: 860px) { .platform-columns { grid-template-columns: 1fr; } }

	.how-it-works {
		width: 100%;
		padding: var(--ds-space-2xl) 0 var(--ds-space-4xl);
		background: var(--ds-bg-primary);
	}

	.steps-timeline {
		max-width: 800px;
		margin: 0 auto;
	}

	.timeline-step {
		display: flex;
		gap: var(--ds-space-lg);
		margin-bottom: var(--ds-space-xl);
		align-items: flex-start;
	}

	.timeline-step:last-child {
		margin-bottom: 0;
	}

	.step-number-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		position: relative;
		flex-shrink: 0;
	}

	.step-marker {
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 2;
	}

	.step-marker.step-1 { background: var(--ds-primary); }
	.step-marker.step-2 { background: var(--ds-purple); }
	.step-marker.step-3 { background: var(--ds-green); }

	.step-number {
		color: white;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.timeline-connector {
		width: 3px;
		height: calc(100% + var(--ds-space-xl) - 48px);
		background: linear-gradient(180deg, var(--ds-primary) 0%, var(--ds-purple) 50%, var(--ds-green) 100%);
		position: absolute;
		top: 48px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1;
		border-radius: 2px;
		opacity: 0.4;
	}

	/* Glass card for step content */
	.step-glass-card {
		flex: 1;
		padding: var(--ds-space-lg) var(--ds-space-xl);
		background: rgba(255, 255, 255, 0.75);
