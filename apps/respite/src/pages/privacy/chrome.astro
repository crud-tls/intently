---
import '@fontsource-variable/inter/wght.css';
import AppLayout from '@intently/ui/AppLayout.astro';
import LegalArticle from '@intently/legal/LegalArticle.astro';
import * as policy from '@intently/legal/policies/respite-chrome/privacy.md';
import { app } from '@intently/registry';
import { content } from '../../content';

const a = app('respite');
---

<AppLayout app={a} content={content} title="Privacy policy (Chrome)" description={`What the ${a.name} browser extension collects, why, and where it goes.`}>
	<main style="--legal-top:3.5rem"><LegalArticle policy={policy} links={[{ label: 'Respite iPhone privacy', href: '/privacy' }, { label: 'Terms', href: '/terms' }]} /></main>
</AppLayout>
