---
// One page around a policy from @intently/legal, with the site's single Header and Footer.
import type { MarkdownInstance } from 'astro';
import type { ComponentProps } from 'astro/types';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import LegalArticle from '@intently/legal/LegalArticle.astro';

interface Props {
	policy: MarkdownInstance<Record<string, any>>;
	title: string;
	description: string;
	/** Breadcrumb label for this page. */
	crumb: string;
}

const { policy, title, description, crumb } = Astro.props;
const origin = new URL(Astro.url.pathname, Astro.site).toString();
// The three apps each have a policy; the terms for iPhone and Android differ and Chrome has none.
const links = [
	{ label: 'Privacy (iPhone)', href: '/privacy' },
	{ label: 'Privacy (Android)', href: '/privacy/android' },
	{ label: 'Privacy (Chrome)', href: '/privacy/chrome' },
	{ label: 'Terms (iPhone)', href: '/terms' },
	{ label: 'Terms (Android)', href: '/terms/android' },
	{ label: 'Delete your account', href: '/delete-account' },
].filter((l) => l.href !== Astro.url.pathname.replace(/\/$/, ''));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<BreadcrumbSchema items={[{ name: 'Home', url: String(Astro.site).replace(/\/$/, '') }, { name: crumb, url: origin }]} />
	</head>
	<body>
		<Header />
		<main>
			<LegalArticle policy={policy as unknown as ComponentProps<typeof LegalArticle>['policy']} links={links} />
		</main>
		<Footer />
	</body>
</html>
