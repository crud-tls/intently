---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/marketing/Hero.astro';
import PlatformCard from '../components/marketing/PlatformCard.astro';
import Icon from '../components/ui/Icon.astro';
import Biscuit from '../components/ui/Biscuit.astro';
import Picture from '../components/ui/Picture.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import WebSiteSchema from '../components/SEO/WebSiteSchema.astro';
import ProductSchema from '../components/SEO/ProductSchema.astro';
import { getCollection } from 'astro:content';

const androidFeatures = ["Complete app blocking", "Usage analytics", "Streak tracking", "Widget support"];
const iosFeatures = ["A pause before the apps you choose", "Daily limits and an app lock", "Built on Apple's Screen Time", "Private by design"];
const chromeFeatures = ["Site tracking", "Focus mode", "Usage insights", "Quick settings"];

// Get latest 3 blog posts
const allPosts = await getCollection('blog');
const latestPosts = allPosts
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Pawse - Take Back Your Time | Free Screen Time App That Respects Your Privacy"
			description="Stop losing 3+ hours a day to mindless scrolling. Pawse creates a gentle pause before distracting apps open—helping you choose what matters. Free, no account needed, no ads."
		/>
		<WebSiteSchema />
		<ProductSchema
			name="Pawse"
			description="Free privacy-first screen time app. Mindful pause before distracting apps, usage tracking, streak tracking — works offline, no account needed."
			platform="android"
			downloadUrl="https://play.google.com/store/apps/details?id=dev.sadakat.thinkfaster"
		/>
	</head>
	<body>
		<Header />

		<main>
			<Hero />

			<!-- Features Section - Asymmetric Bento -->
			<section class="bento-section">
				<div class="container">
					<div class="section-header">
						<h2 class="section-title">What Changes When You Use Pawse</h2>
						<p class="section-subtitle">Four ways your relationship with your phone transforms.</p>
					</div>

					<div class="bento-grid">
						<!-- Hero Card: Stat Showpiece -->
						<div class="bento-card bento-hero">
							<div class="bento-glow-bg" aria-hidden="true"></div>
							<div class="bento-hero-layout">
								<div class="bento-hero-stat">
									<span class="bento-stat-number">1</span>
									<span class="bento-stat-unit">pause</span>
									<span class="bento-stat-caption">before each app you choose</span>
								</div>
								<div class="bento-hero-content">
									<div class="bento-icon bento-icon-blue">
										<Icon name="Clock" size={32} color="var(--ds-primary)" />
									</div>
									<h3>See Where Your Hours Go</h3>
									<p>Most people are shocked to discover they spend 3-4 hours daily on apps they don't even enjoy. Pawse reveals the truth gently.</p>
								</div>
							</div>
						</div>

						<!-- Pause Card: Breathing Animation -->
						<div class="bento-card bento-pause">
							<div class="bento-icon bento-icon-purple">
								<div class="breath-ring" aria-hidden="true"></div>
								<Icon name="Pause" size={28} color="var(--ds-purple)" />
							</div>
							<h3>A Breath Between You and the Scroll</h3>
							<p>When you reach for apps on autopilot, Pawse creates a quiet pause. In that moment, you remember: you can choose.</p>
						</div>

						<!-- Transform Card: Streak Dots -->
						<div class="bento-card bento-transform">
							<div class="bento-icon bento-icon-orange">
								<Icon name="TrendingUp" size={28} color="var(--ds-orange)" />
							</div>
							<div class="mini-streak" aria-hidden="true">
								<span class="streak-dot"></span>
								<span class="streak-dot"></span>
								<span class="streak-dot filled"></span>
								<span class="streak-dot filled"></span>
								<span class="streak-dot filled"></span>
								<span class="streak-dot filled"></span>
								<span class="streak-dot filled active"></span>
							</div>
							<h3>Watch Yourself Transform</h3>
							<p>Every day you choose presence over scrolling, your streak grows. It's not about perfection—it's about becoming someone in control.</p>
						</div>

						<!-- Privacy Card: Badge Pills -->
						<div class="bento-card bento-privacy">
							<Biscuit mood="meditate" size={96} label="Biscuit meditating" class="bento-biscuit" />
							<h3>Your Secrets Stay Yours</h3>
							<p>Your screen-time history stays on your phone. No account needed, and nothing syncs unless you sign in.</p>
							<div class="privacy-badges">
								<span class="privacy-badge"><Icon name="WifiOff" size={14} color="var(--ds-green)" /> Works offline</span>
								<span class="privacy-badge"><Icon name="EyeOff" size={14} color="var(--ds-green)" /> No ads</span>
								<span class="privacy-badge"><Icon name="Database" size={14} color="var(--ds-green)" /> History on your phone</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Transformation Journey Section -->
			<section class="journey-section">
				<div class="container">
					<div class="journey-header">
						<span class="journey-eyebrow">The shift</span>
						<h2 class="journey-title">One Small Pause.<br/>Everything Changes.</h2>
					</div>

					<div class="journey-track">
						<!-- Central timeline -->
						<div class="timeline-line" aria-hidden="true">
							<div class="timeline-glow"></div>
						</div>

						<!-- Row 1 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="AlarmClock" size={20} color="var(--ds-red)" /></span>
									<p>"Just 5 more minutes" turns into an hour</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="Hand" size={20} color="var(--ds-green)" /></span>
									<p>You catch yourself before the spiral starts</p>
								</div>
							</div>
						</div>

						<!-- Row 2 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="Smartphone" size={20} color="var(--ds-red)" /></span>
									<p>Picking up your phone 80+ times without thinking</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="Brain" size={20} color="var(--ds-green)" /></span>
									<p>Reaching for your phone becomes a conscious choice</p>
								</div>
							</div>
						</div>

						<!-- Row 3 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="Frown" size={20} color="var(--ds-red)" /></span>
									<p>Feeling guilty but unable to stop</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="Trophy" size={20} color="var(--ds-green)" /></span>
									<p>Feeling proud of small wins that add up</p>
								</div>
							</div>
						</div>

						<!-- Row 4 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="Moon" size={20} color="var(--ds-red)" /></span>
									<p>Losing evenings to mindless scrolling</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="BookOpen" size={20} color="var(--ds-green)" /></span>
									<p>Having evenings for books, walks, or real conversations</p>
								</div>
							</div>
						</div>

						<!-- Row 5 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="Bell" size={20} color="var(--ds-red)" /></span>
									<p>Waking up and immediately checking notifications</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="Sun" size={20} color="var(--ds-green)" /></span>
									<p>Starting your morning on your own terms</p>
								</div>
							</div>
						</div>

						<!-- Labels -->
						<div class="journey-labels" aria-hidden="true">
							<span class="journey-label journey-label-before">Before</span>
							<span class="journey-label journey-label-after">After</span>
						</div>
					</div>

					<div class="journey-closing">
						<p>This isn't about willpower. It's about <em>awareness</em>.</p>
						<span class="journey-closing-sub">Pawse gives you the pause that changes everything.</span>
					</div>
				</div>
			</section>

			<!-- Platforms Section -->
			<section class="platforms-section">
				<div class="container">
					<h2 class="section-title">Wherever You Scroll, We're There</h2>
					<p class="section-subtitle">Whether it's your phone in bed, your browser at work, or your tablet on the couch—Pawse quietly has your back.</p>
					<div class="platforms-grid">
						<PlatformCard
							platform="android"
							title="Android"
							description="Your phone is the biggest time thief. Take it back with the full Pawse experience."
							features={androidFeatures}
							downloadUrl="https://play.google.com/store/apps/details?id=dev.sadakat.thinkfaster"
							storeType="playstore"
						/>
						<PlatformCard
							platform="ios"
							title="iOS — Respite"
							description="iPhone users, meet Respite — our native app with the same gentle pause, built on Apple's Screen Time. App names never leave your iPhone."
							features={iosFeatures}
							downloadUrl="https://apps.apple.com/us/app/respite-screen-time-control/id6757760293"
							storeType="appstore"
						/>
						<PlatformCard
							platform="chrome"
							title="Chrome Extension"
							description="That 'quick check' at work that turns into 45 minutes? Pawse catches you before the rabbit hole swallows you whole."
							features={chromeFeatures}
							downloadUrl="https://chromewebstore.google.com/detail/intently-intentful-browsi/acjndeeecacgplloeefjjhlnlpgnonop"
							storeType="chromestore"
						/>
					</div>
				</div>
			</section>

			<!-- Blog Section -->
			<section class="blog-section">
				<div class="container">
					<span class="blog-eyebrow">From the blog</span>
					<h2 class="section-title">Insights for a More Intentional Life</h2>
					<p class="section-subtitle">Expert tips on digital wellbeing, phone addiction, and mindful tech use.</p>
					<div class="blog-grid">
						{latestPosts.map((post) => (
							<article class="blog-card">
								{post.data.heroImage && (
									<a href={`/blog/${post.id}`} class="blog-image-link">
										<Picture src={post.data.heroImage} alt={post.data.title} class="blog-image" loading="lazy" width={640} height={360} />
									</a>
								)}
								<div class="blog-content">
									<h3 class="blog-title">
										<a href={`/blog/${post.id}`}>{post.data.title}</a>
									</h3>
									<p class="blog-description">{post.data.description}</p>
									<a href={`/blog/${post.id}`} class="blog-link">
										Read more about {post.data.title}
										<Icon name="ArrowRight" size={14} color="currentColor" />
									</a>
								</div>
							</article>
						))}
					</div>
					<div class="blog-cta">
						<a href="/blog" class="view-all-button">View All Articles</a>
						<a href="/quiz" class="quiz-button"><Icon name="Smartphone" size={20} /> Take Our Phone Addiction Quiz</a>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section class="cta-section">
				<div class="cta-divider" aria-hidden="true"></div>
				<div class="container">
					<div class="cta-layout">
						<div class="cta-content">
							<Biscuit mood="cheer" size={120} label="Biscuit cheering" class="cta-biscuit" />
							<span class="cta-eyebrow">
								<Icon name="Sparkles" size={16} color="var(--ds-primary)" />
								Ready to change?
							</span>
							<h2 class="cta-headline">
								Tomorrow, You Could Wake Up With
								<span class="cta-highlight">an Extra Hour</span>
							</h2>
							<p class="cta-body">Take back your mornings, your evenings, and your weekends. It starts with one free download.</p>
							<div class="cta-actions">
								<a href="/download" class="cta-button-primary">
									Start Reclaiming Your Time
									<Icon name="ArrowRight" size={18} color="currentColor" />
								</a>
								<span class="cta-reassurance">
									<Icon name="ShieldCheck" size={14} color="var(--ds-green)" />
									Free forever. No account needed.
								</span>
							</div>
						</div>
						<div class="cta-visual" aria-hidden="true">
							<div class="clock-face">
								<div class="clock-ring"></div>
								<div class="clock-hand clock-hour"></div>
								<div class="clock-hand clock-minute"></div>
								<div class="clock-center"></div>
								<div class="clock-highlight"></div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	/* Bento Section — Asymmetric Showcase */
	.bento-section {
		width: 100%;
		padding: var(--ds-space-4xl) 0;
		background: var(--ds-bg-secondary);
		position: relative;
	}

	.section-header {
		text-align: center;
		max-width: 600px;
		margin: 0 auto var(--ds-space-3xl);
		padding: 0 1rem;
		position: relative;
	}

	.section-header .section-title {
		font-size: 2rem;
		font-weight: 800;
		margin: 0 0 var(--ds-space-md) 0;
		color: var(--ds-text-primary);
		letter-spacing: -0.03em;
		line-height: 1.2;
	}

	.section-header .section-subtitle {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--ds-text-secondary);
		margin: 0;
		font-weight: 400;
	}

	/* Bento grid */
	.bento-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* Base card glass */
	.bento-card {
		position: relative;
		border-radius: 24px;
		overflow: hidden;
		padding: 1.5rem;
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@media (hover: hover) {
		.bento-card:hover {
			transform: scale(1.02);
		}

		.bento-card:hover .bento-icon::before {
			opacity: 0.25;
			transform: scale(1.3);
		}

		.bento-card:hover .bento-glow-bg {
			opacity: 1;
		}
	}

	@media (prefers-color-scheme: dark) {
		.bento-card {
			background: rgba(30, 30, 30, 0.75);
			border: 1px solid rgba(255, 255, 255, 0.12);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 4px 20px rgba(0, 0, 0, 0.4);
		}
	}

	.bento-card h3 {
		font-size: 1.0625rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
		color: var(--ds-text-primary);
		line-height: 1.3;
		letter-spacing: -0.01em;
	}

	.bento-card p {
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--ds-text-secondary);
		margin: 0;
	}

	/* Floating icons with glow */
	.bento-icon {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		margin-bottom: 1rem;
		flex-shrink: 0;
	}

	.bento-icon::before {
		content: '';
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		opacity: 0.15;
		transition: opacity 0.4s ease, transform 0.4s ease;
	}

	.bento-icon-blue::before { background: radial-gradient(circle, var(--ds-primary), transparent 70%); }
	.bento-icon-purple::before { background: radial-gradient(circle, var(--ds-purple), transparent 70%); }
	.bento-icon-orange::before { background: radial-gradient(circle, var(--ds-orange), transparent 70%); }
	.bento-icon-green::before { background: radial-gradient(circle, var(--ds-green), transparent 70%); }

	/* === Hero Card === */
	.bento-hero {
		padding: 2rem;
	}

	.bento-hero-layout {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		position: relative;
		z-index: 1;
	}

	.bento-glow-bg {
		position: absolute;
		inset: -20px;
		z-index: 0;
		border-radius: 40px;
		background:
			radial-gradient(ellipse at 30% 50%, rgba(var(--ds-brand-rgb),  0.08) 0%, transparent 60%),
			radial-gradient(ellipse at 70% 50%, rgba(217, 70, 122,  0.06) 0%, transparent 60%);
		filter: blur(20px);
		opacity: 0.6;
		animation: glow-pulse 8s ease-in-out infinite;
		pointer-events: none;
	}

	@keyframes glow-pulse {
		0%, 100% { opacity: 0.6; }
		50% { opacity: 1; }
	}

	.bento-hero-stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.bento-stat-number {
		font-size: clamp(3.5rem, 7vw, 5.5rem);
		font-weight: 900;
		letter-spacing: -0.04em;
		line-height: 1;
		background: linear-gradient(135deg, var(--ds-primary) 0%, var(--ds-purple) 50%, var(--ds-primary) 100%);
		background-size: 200% 200%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: gradient-shift 6s ease-in-out infinite;
	}

	@keyframes gradient-shift {
		0%, 100% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
	}

	.bento-stat-unit {
		font-size: clamp(1.5rem, 3vw, 2.5rem);
		font-weight: 700;
		color: var(--ds-text-secondary);
		margin-top: -0.25rem;
	}

	.bento-stat-caption {
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ds-text-hint);
		font-weight: 600;
		margin-top: 0.5rem;
	}

	.bento-hero-content {
		display: flex;
		flex-direction: column;
	}

	.bento-hero h3 {
		font-size: 1.375rem;
	}

	.bento-hero p {
		font-size: 0.975rem;
	}

	@media (prefers-color-scheme: dark) {
		.bento-stat-number {
			background: linear-gradient(135deg, var(--ds-brand) 0%, var(--ds-purple) 50%, var(--ds-brand) 100%);
			background-size: 200% 200%;
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			background-clip: text;
			animation: gradient-shift 6s ease-in-out infinite;
		}

		.bento-glow-bg {
			background:
				radial-gradient(ellipse at 30% 50%, rgba(var(--ds-brand-rgb),  0.04) 0%, transparent 60%),
				radial-gradient(ellipse at 70% 50%, rgba(217, 70, 122,  0.03) 0%, transparent 60%);
		}
	}

	/* === Breathing Ring (Pause card) === */
	.breath-ring {
		position: absolute;
		width: 72px;
		height: 72px;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		border: 2px solid var(--ds-purple);
		opacity: 0.3;
		animation: breathe 4s ease-in-out infinite;
	}

	@keyframes breathe {
		0%, 100% { transform: translate(-50%, -50%) scale(0.8); opacity: 0.15; }
		50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.35; }
	}

	/* === Streak Dots (Transform card) === */
	.mini-streak {
		display: flex;
		gap: 6px;
		margin-bottom: 0.75rem;
	}

	.streak-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--ds-gray-300);
	}

	.streak-dot.filled {
		background: var(--ds-orange);
	}

	.streak-dot.active {
		background: var(--ds-orange);
		box-shadow: 0 0 8px rgba(255, 152, 0, 0.5);
		animation: pulse-dot 2s ease-in-out infinite;
	}

	@keyframes pulse-dot {
		0%, 100% { box-shadow: 0 0 4px rgba(255, 152, 0, 0.3); }
		50% { box-shadow: 0 0 12px rgba(255, 152, 0, 0.6); }
	}

	/* === Privacy Badges === */
	.privacy-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(0, 0, 0, 0.04);
	}

	.privacy-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--ds-green);
		background: rgba(76, 175, 80, 0.08);
		padding: 0.25rem 0.75rem;
		border-radius: var(--ds-radius-full);
		border: 1px solid rgba(76, 175, 80, 0.15);
	}

	@media (prefers-color-scheme: dark) {
		.privacy-badges {
			border-top-color: rgba(255, 255, 255, 0.06);
		}

		.privacy-badge {
			background: rgba(76, 175, 80, 0.12);
			border-color: rgba(76, 175, 80, 0.2);
		}

		.streak-dot {
			background: var(--ds-gray-400);
		}
	}

	/* Bento responsive */
	@media (min-width: 768px) {
		.bento-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}

		.bento-hero {
			grid-column: 1 / -1;
		}

		.bento-privacy {
			grid-column: 1 / -1;
		}

		.bento-hero-layout {
			flex-direction: row;
			align-items: center;
			gap: 2.5rem;
		}

		.bento-hero-stat {
			min-width: 200px;
		}

		.section-header .section-title {
			font-size: 2.5rem;
		}

		.section-header .section-subtitle {
			font-size: 1.0625rem;
		}
	}

	@media (min-width: 1024px) {
		.bento-section {
			padding: var(--ds-space-5xl) 0;
		}

		.bento-grid {
			grid-template-columns: 1.2fr 1fr 1.2fr;
			gap: 1.75rem;
		}

		.bento-hero {
			grid-column: 1 / -1;
		}

		.bento-pause { grid-column: 1; }
		.bento-transform { grid-column: 2; }
		.bento-privacy { grid-column: 3; }
	}

	/* Bento mobile */
	@media (max-width: 767px) {
		.bento-hero {
			padding: 1.5rem;
		}

		.bento-hero h3 {
			font-size: 1.125rem;
		}

		.bento-icon {
			width: 48px;
			height: 48px;
		}
	}

	/* Reduced motion */
	@media (prefers-reduced-motion: reduce) {
		.bento-stat-number,
		.bento-glow-bg,
		.breath-ring,
		.streak-dot.active {
			animation: none;
		}

		.bento-glow-bg {
			opacity: 0.8;
		}

		.breath-ring {
			transform: translate(-50%, -50%) scale(1);
			opacity: 0.2;
		}
	}

	/* Features Section - keeping for backward compatibility */
	.features-section {
		width: 100%;
		padding: var(--ds-space-2xl) 0;
		background: var(--ds-bg-primary);
	}

	/* Platforms Section */
	.platforms-section {
		width: 100%;
		padding: var(--ds-space-2xl) 0;
		background: var(--ds-bg-secondary);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.section-title {
		font-size: 2.5rem;
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--ds-space-md) 0;
		color: var(--ds-text-primary);
	}

	.section-subtitle {
		font-size: 1.125rem;
		text-align: center;
		max-width: 600px;
		margin: 0 auto var(--ds-space-3xl);
		color: var(--ds-text-secondary);
	}

	.features-grid,
	.platforms-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--ds-space-xl);
	}

	.features-grid .feature-card,
	.platforms-grid .platform-card {
		height: auto;
	}

	/* Tablet: 2 columns */
	@media (min-width: 768px) {
		.features-grid,
		.platforms-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.features-grid .feature-card,
		.platforms-grid .platform-card {
			height: 100%;
		}
	}

	/* Desktop: 4 columns for features, 3 for platforms */
	@media (min-width: 1024px) {
		.features-grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.platforms-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Blog Section */
	.blog-section {
		width: 100%;
		padding: var(--ds-space-2xl) 0;
		background: var(--ds-bg-secondary);
	}

	.blog-eyebrow {
		display: block;
		text-align: center;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ds-primary);
		margin-bottom: 0.75rem;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		margin-bottom: var(--ds-space-2xl);
	}

	.blog-card {
		background: rgba(255, 255, 255, 0.7);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border-radius: 24px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		display: flex;
		flex-direction: column;
	}

	.blog-card:hover {
		transform: translateY(-4px);
		background: rgba(255, 255, 255, 0.85);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 12px 40px rgba(0, 0, 0, 0.1),
			0 4px 12px rgba(0, 0, 0, 0.06);
	}

	@media (prefers-color-scheme: dark) {
		.blog-card {
			background: rgba(40, 40, 40, 0.7);
			border: 1px solid rgba(255, 255, 255, 0.12);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.15),
				0 4px 20px rgba(0, 0, 0, 0.4);
		}

		.blog-card:hover {
			background: rgba(40, 40, 40, 0.85);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.2),
				0 12px 40px rgba(0, 0, 0, 0.5);
		}
	}

	.blog-image-link {
		display: block;
		overflow: hidden;
	}

	.blog-image {
		width: 100%;
		height: 200px;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.blog-card:hover .blog-image {
		transform: scale(1.06);
	}

	.blog-content {
		padding: 1.25rem 1.5rem 1.5rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.blog-title {
		font-size: 1.125rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
	}

	.blog-title a {
		color: var(--ds-text-primary);
		text-decoration: none;
		transition: color var(--ds-transition-fast);
	}

	.blog-title a:hover {
		color: var(--ds-primary);
	}

	.blog-description {
		font-size: 0.9rem;
		color: var(--ds-text-secondary);
		margin: 0 0 1rem;
		line-height: 1.55;
		flex: 1;
	}

	.blog-link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--ds-primary);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.875rem;
		transition: all var(--ds-transition-fast);
		align-self: flex-start;
	}

	.blog-link:hover {
		gap: 0.625rem;
		color: var(--ds-primary-dark);
	}

	.blog-cta {
		display: flex;
		gap: var(--ds-space-md);
		justify-content: center;
		flex-wrap: wrap;
	}

	.view-all-button,
	.quiz-button {
		display: inline-block;
		padding: 0.875rem 1.75rem;
		border-radius: var(--ds-radius-full);
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		transition: all var(--ds-transition-normal);
	}

	.view-all-button {
		background: rgba(var(--ds-brand-rgb),  0.85);
		color: var(--ds-on-brand);
		border: 1px solid rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(12px) saturate(150%);
		-webkit-backdrop-filter: blur(12px) saturate(150%);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.3),
			0 4px 16px rgba(var(--ds-brand-rgb),  0.3);
	}

	.view-all-button:hover {
		background: rgba(var(--ds-brand-rgb),  0.95);
		transform: translateY(-2px);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.35),
			0 8px 24px rgba(var(--ds-brand-rgb),  0.4);
	}

	.quiz-button {
		background: rgba(255, 255, 255, 0.6);
		color: var(--ds-primary);
		border: 1px solid rgba(var(--ds-brand-rgb),  0.2);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
	}

	.quiz-button:hover {
		background: rgba(255, 255, 255, 0.85);
		border-color: rgba(var(--ds-brand-rgb),  0.4);
		transform: translateY(-2px);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.5),
			0 4px 16px rgba(var(--ds-brand-rgb),  0.1);
	}

	@media (prefers-color-scheme: dark) {
		.quiz-button {
			background: rgba(255, 255, 255, 0.08);
			border-color: rgba(var(--ds-brand-rgb),  0.25);
			color: var(--ds-primary);
		}

		.quiz-button:hover {
			background: rgba(255, 255, 255, 0.15);
			border-color: rgba(var(--ds-brand-rgb),  0.45);
		}
	}

	@media (min-width: 768px) {
		.blog-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.blog-image {
			height: 180px;
		}
	}

	/* Journey / Transformation Section */
	.journey-section {
		width: 100%;
		padding: var(--ds-space-3xl) 0;
		background: var(--ds-bg-primary);
		position: relative;
		overflow: hidden;
	}

	.journey-header {
		text-align: center;
		max-width: 560px;
		margin: 0 auto var(--ds-space-3xl);
		padding: 0 1rem;
	}

	.journey-eyebrow {
		display: inline-block;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ds-primary);
		margin-bottom: 0.75rem;
	}

	.journey-title {
		font-size: 2rem;
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: -0.03em;
		color: var(--ds-text-primary);
		margin: 0;
	}

	/* The track that holds timeline + rows */
	.journey-track {
		position: relative;
		max-width: 820px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* Central vertical line */
	.timeline-line {
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 2px;
		background: linear-gradient(
			180deg,
			var(--ds-red) 0%,
			var(--ds-gray-300) 40%,
			var(--ds-gray-300) 60%,
			var(--ds-green) 100%
		);
		transform: translateX(-50%);
		border-radius: 2px;
		z-index: 0;
	}

	.timeline-glow {
		position: absolute;
		inset: 0;
		width: 100%;
		filter: blur(6px);
		background: inherit;
		opacity: 0.4;
	}

	/* Before / After labels floating at top */
	.journey-labels {
		display: none;
	}

	@media (min-width: 768px) {
		.journey-labels {
			display: flex;
			justify-content: space-between;
			padding: 0 2rem;
			margin-bottom: 1.5rem;
			position: relative;
			z-index: 1;
		}

		.journey-label {
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			padding: 0.375rem 1rem;
			border-radius: 100px;
		}

		.journey-label-before {
			color: var(--ds-red);
			background: rgba(244, 67, 54, 0.08);
		}

		.journey-label-after {
			color: var(--ds-green);
			background: rgba(76, 175, 80, 0.08);
		}
	}

	/* Each row: before | node | after */
	.journey-row {
		display: grid;
		grid-template-columns: 1fr 40px 1fr;
		align-items: center;
		gap: 0;
		margin-bottom: 1rem;
		position: relative;
		z-index: 1;
	}

	.journey-row:last-of-type {
		margin-bottom: 0;
	}

	/* Timeline dot at center */
	.timeline-node {
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 2;
	}

	.node-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--ds-gray-400);
		border: 2px solid var(--ds-bg-primary);
		box-shadow: 0 0 0 2px var(--ds-gray-300);
		transition: all 0.3s ease;
	}

	.journey-row:first-of-type .node-dot {
		background: var(--ds-red);
		box-shadow: 0 0 0 2px rgba(244, 67, 54, 0.2);
	}

	.journey-row:last-of-type .node-dot {
		background: var(--ds-green);
		box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.2);
	}

	/* Before side (left) */
	.journey-before {
		display: flex;
		justify-content: flex-end;
		padding-right: 0.75rem;
	}

	/* After side (right) */
	.journey-after {
		display: flex;
		justify-content: flex-start;
		padding-left: 0.75rem;
	}

	/* The glass cards */
	.journey-card {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.875rem 1.125rem;
		border-radius: 16px;
		backdrop-filter: blur(16px) saturate(150%);
		-webkit-backdrop-filter: blur(16px) saturate(150%);
		transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
		max-width: 100%;
	}

	.journey-card p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--ds-text-secondary);
	}

	.journey-card:hover {
		transform: translateY(-2px);
	}

	/* Before card — warm/red tinted glass */
	.journey-card-before {
		background: rgba(255, 255, 255, 0.65);
		border: 1px solid rgba(244, 67, 54, 0.1);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.8),
			0 2px 12px rgba(244, 67, 54, 0.06);
	}

	.journey-card-before:hover {
		background: rgba(255, 255, 255, 0.85);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 8px 24px rgba(244, 67, 54, 0.1);
	}

	/* After card — cool/green tinted glass */
	.journey-card-after {
		background: rgba(255, 255, 255, 0.65);
		border: 1px solid rgba(76, 175, 80, 0.1);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.8),
			0 2px 12px rgba(76, 175, 80, 0.06);
	}

	.journey-card-after:hover {
		background: rgba(255, 255, 255, 0.85);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 8px 24px rgba(76, 175, 80, 0.1);
	}

	/* Icon circles */
	.journey-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		flex-shrink: 0;
	}

	.journey-icon-before {
		background: rgba(244, 67, 54, 0.08);
	}

	.journey-icon-after {
		background: rgba(76, 175, 80, 0.08);
	}

	/* Dark mode */
	@media (prefers-color-scheme: dark) {
		.journey-card-before {
			background: rgba(50, 40, 40, 0.7);
			border-color: rgba(244, 67, 54, 0.15);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.08),
				0 2px 12px rgba(0, 0, 0, 0.3);
		}

		.journey-card-before:hover {
			background: rgba(60, 45, 45, 0.85);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.12),
				0 8px 24px rgba(0, 0, 0, 0.4);
		}

		.journey-card-after {
			background: rgba(40, 50, 40, 0.7);
			border-color: rgba(76, 175, 80, 0.15);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.08),
				0 2px 12px rgba(0, 0, 0, 0.3);
		}

		.journey-card-after:hover {
			background: rgba(45, 60, 45, 0.85);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.12),
				0 8px 24px rgba(0, 0, 0, 0.4);
		}

		.node-dot {
			border-color: var(--ds-bg-primary);
			box-shadow: 0 0 0 2px var(--ds-gray-300);
		}

		.journey-icon-before {
			background: rgba(244, 67, 54, 0.15);
		}

		.journey-icon-after {
			background: rgba(76, 175, 80, 0.15);
		}

		.timeline-line {
			background: linear-gradient(
				180deg,
				var(--ds-red) 0%,
				var(--ds-gray-400) 40%,
				var(--ds-gray-400) 60%,
				var(--ds-green) 100%
			);
		}

		.journey-label-before {
			background: rgba(244, 67, 54, 0.12);
		}

		.journey-label-after {
			background: rgba(76, 175, 80, 0.12);
		}
	}

	/* Closing */
	.journey-closing {
		text-align: center;
		max-width: 520px;
		margin: var(--ds-space-3xl) auto 0;
		padding: 0 1rem;
	}

	.journey-closing p {
		font-size: 1.375rem;
		font-weight: 600;
		color: var(--ds-text-primary);
		margin: 0 0 0.5rem;
		line-height: 1.4;
		letter-spacing: -0.02em;
	}

	.journey-closing em {
		font-style: normal;
		background: linear-gradient(135deg, var(--ds-primary) 0%, var(--ds-green) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.journey-closing-sub {
		display: block;
		font-size: 0.9375rem;
		color: var(--ds-text-hint);
		font-weight: 400;
	}

	/* === Mobile: stack cards vertically === */
	@media (max-width: 767px) {
		.journey-title {
			font-size: 1.625rem;
		}

		.timeline-line,
		.timeline-node,
		.journey-labels {
			display: none;
		}

		.journey-track {
			max-width: 480px;
		}

		.journey-row {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			margin-bottom: 1.25rem;
		}

		.journey-before,
		.journey-after {
			padding: 0;
			justify-content: stretch;
		}

		.journey-card {
			width: 100%;
		}

		.journey-closing p {
			font-size: 1.1875rem;
		}
	}

	/* Tablet+ */
	@media (min-width: 768px) {
		.journey-section {
			padding: var(--ds-space-4xl) 0;
		}

		.journey-title {
			font-size: 2.5rem;
		}
	}

	/* Desktop */
	@media (min-width: 1024px) {
		.journey-section {
			padding: var(--ds-space-5xl) 0;
		}

		.journey-card p {
			font-size: 0.9375rem;
		}
	}

	/* Testimonials Section */
	.testimonials-section {
		width: 100%;
		padding: var(--ds-space-2xl) 0;
		background: var(--ds-bg-primary);
		overflow: hidden;
	}

	.testimonials-section .section-title {
		margin-bottom: var(--ds-space-xl);
	}

	/* Marquee */
	.marquee-wrap {
		position: relative;
		width: 100%;
		padding: 0.5rem 0 1.5rem;
	}

	.marquee-wrap::before,
	.marquee-wrap::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		width: 80px;
		z-index: 2;
		pointer-events: none;
	}

	.marquee-wrap::before {
		left: 0;
		background: linear-gradient(90deg, var(--ds-bg-primary) 0%, transparent 100%);
	}

	.marquee-wrap::after {
		right: 0;
		background: linear-gradient(270deg, var(--ds-bg-primary) 0%, transparent 100%);
	}

	.marquee-track {
		display: flex;
		gap: 1.25rem;
		width: max-content;
		animation: marquee 40s linear infinite;
	}

	.marquee-track:hover {
		animation-play-state: paused;
	}

	@keyframes marquee {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}

	/* Quote cards */
	.quote-card {
		min-width: 300px;
		max-width: 360px;
		flex-shrink: 0;
		padding: 1.5rem;
		background: rgba(255, 255, 255, 0.65);
		backdrop-filter: blur(16px) saturate(150%);
		-webkit-backdrop-filter: blur(16px) saturate(150%);
		border: 1px solid rgba(255, 255, 255, 0.7);
		border-radius: 20px;
