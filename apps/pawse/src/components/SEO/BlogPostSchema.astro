---
interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  modifiedAt?: Date;
  author?: string;
  authorType?: 'Organization' | 'Person';
  image?: string;
  url?: string;
  section?: string;
  tags?: string[];
  wordCount?: number;
}

const {
  title,
  description,
  publishedAt,
  modifiedAt,
  author = "Pawse Team",
  authorType = 'Organization',
  image,
  url,
  section = "Digital Wellbeing",
  tags = [],
  wordCount = 0
} = Astro.props;

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": url || `https://pawse.liveintently.app/blog/${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
  "headline": title,
  "description": description,
  "image": image ? `https://pawse.liveintently.app${image}` : "https://pawse.liveintently.app/blog-placeholder-1.jpg",
  "datePublished": publishedAt.toISOString(),
  "dateModified": (modifiedAt || publishedAt).toISOString(),
  "author": {
    "@type": authorType,
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://pawse.liveintently.app/#organization",
    "name": "Pawse",
    "logo": {
      "@type": "ImageObject",
      "url": "https://pawse.liveintently.app/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": url || `https://pawse.liveintently.app/blog/${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
  },
  "articleSection": section,
  "keywords": tags.join(', '),
  "inLanguage": "en-US",
  "wordCount": wordCount
};
---

<script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
