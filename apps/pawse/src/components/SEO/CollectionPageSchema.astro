---
/**
 * CollectionPage Schema for Blog Index and Listing Pages
 * Helps search engines understand page collections and their contents
 * Usage: Add to blog index, category pages, and other listing pages
 */

interface CollectionItem {
  name: string;
  url: string;
  description?: string;
  image?: string;
  datePublished?: string;
}

interface Props {
  name: string;
  description: string;
  url: string;
  items: CollectionItem[];
}

const {
  name,
  description,
  url,
  items
} = Astro.props;

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": name,
  "description": description,
  "url": `https://liveintently.app${url}`,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": items.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Article",
        "name": item.name,
        "url": item.url.startsWith('http') ? item.url : `https://liveintently.app${item.url}`,
        "description": item.description,
        "image": item.image ? (item.image.startsWith('http') ? item.image : `https://liveintently.app${item.image}`) : undefined,
        "datePublished": item.datePublished
      }
    }))
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
