---
/**
 * ScrollReveal Component
 * Wrapper that adds intersection observer-based reveal animations
 */
interface Props {
	animation?: 'fadeUp' | 'fadeIn' | 'slideLeft' | 'slideRight' | 'scaleIn';
	delay?: number;
	threshold?: number;
	class?: string;
}

const {
	animation = 'fadeUp',
	delay = 0,
	threshold = 0.1,
	class: className = ''
} = Astro.props;

const delayStyle = `--reveal-delay: ${delay}ms;`;
---

<div
	class:list={['scroll-reveal', `scroll-reveal-${animation}`, className]}
	style={delayStyle}
	data-threshold={threshold}
>
	<slot />
</div>

<style>
	.scroll-reveal {
		opacity: 0;
		will-change: opacity, transform;
	}

	.scroll-reveal.scroll-reveal-fadeUp {
		transform: translateY(30px);
	}

	.scroll-reveal.scroll-reveal-fadeIn {
		transform: none;
	}

	.scroll-reveal.scroll-reveal-slideLeft {
		transform: translateX(-50px);
	}

	.scroll-reveal.scroll-reveal-slideRight {
		transform: translateX(50px);
	}

	.scroll-reveal.scroll-reveal-scaleIn {
		transform: scale(0.9);
	}

	.scroll-reveal.is-visible {
		opacity: 1;
		transform: none;
		transition: opacity 0.6s ease, transform 0.6s ease;
		transition-delay: var(--reveal-delay, 0ms);
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-reveal {
			opacity: 1;
			transform: none;
		}
	}
</style>

<script>
	// Intersection Observer for scroll animations
	document.addEventListener('DOMContentLoaded', () => {
		const revealElements = document.querySelectorAll('.scroll-reveal');

		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const delay = entry.target.style.getPropertyValue('--reveal-delay') || '0';
						setTimeout(() => {
							entry.target.classList.add('is-visible');
						}, parseInt(delay));
						revealObserver.unobserve(entry.target);
					}
				});
			},
			{
				threshold: 0.1,
				rootMargin: '0px 0px -50px 0px'
			}
		);

		revealElements.forEach((el) => revealObserver.observe(el));
	});
</script>
