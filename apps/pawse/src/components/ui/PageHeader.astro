---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<div class="page-header">
	<div class="page-header-content">
		<h1>{title}</h1>
		<p>{description}</p>
	</div>
</div>

<style>
	.page-header {
		background: linear-gradient(135deg, var(--ds-blue) 0%, var(--ds-purple) 100%);
		color: white;
		padding: var(--ds-space-4xl) var(--ds-space-md);
		text-align: center;
	}

	.page-header-content {
		max-width: 800px;
		margin: 0 auto;
	}

	.page-header h1 {
		font-size: 2rem;
		margin-bottom: var(--ds-space-md);
		font-weight: 700;
	}

	.page-header p {
		font-size: 1.125rem;
		opacity: 0.95;
		line-height: 1.6;
	}

	@media (min-width: 768px) {
		.page-header {
			padding: var(--ds-space-4xl) var(--ds-space-xl);
		}

		.page-header h1 {
			font-size: 2.5rem;
		}

		.page-header p {
			font-size: 1.25rem;
		}
	}
</style>
