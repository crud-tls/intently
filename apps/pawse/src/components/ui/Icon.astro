---
/**
 * Icon Component
 *
 * Renders SVG icons from lucide-static with consistent styling.
 *
 * @param name - The icon name from Lucide (e.g., "Heart", "Lock", "TrendingUp")
 * @param size - Icon size in pixels (default: 24)
 * @param color - Icon color (supports CSS variables like "var(--intently-blue)" or hex/rgb)
 * @param className - Additional CSS classes
 * @param ariaLabel - Accessible label for screen readers (defaults to icon name)
 */

interface Props {
  name: string;
  size?: number;
  color?: string;
  className?: string;
  ariaLabel?: string;
}

const {
  name,
  size = 24,
  color = "currentColor",
  className = "",
  ariaLabel
} = Astro.props;

// Convert PascalCase to kebab-case for lucide-static file names
// e.g., "BarChart3" -> "bar-chart-3", "TrendingUp" -> "trending-up"
const kebabName = name
  .replace(/([a-z])([A-Z])/g, '$1-$2')  // Insert hyphen between lowercase and uppercase
  .replace(/([A-Z])([A-Z][a-z])/g, '$1-$2')  // Insert hyphen between consecutive uppercase letters
  .replace(/([a-z])(\d)/g, '$1-$2')  // Insert hyphen before numbers
  .replace(/([A-Z])(\d)/g, '$1-$2')  // Insert hyphen before numbers after uppercase
  .toLowerCase();

// Use eager import for icons to avoid dynamic import issues
const icons = import.meta.glob('/node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true
});

const iconPath = `/node_modules/lucide-static/icons/${kebabName}.svg`;
let iconSvg = icons[iconPath] || '';

if (!iconSvg) {
  console.error(`Icon "${name}" (${kebabName}.svg) not found in lucide-static`);
}

// Parse and modify the SVG to add our custom attributes
const modifiedSvg = iconSvg
  .replace(/width="\d+"/, `width="${size}"`)
  .replace(/height="\d+"/, `height="${size}"`)
  .replace(/stroke="[^"]*"/, `stroke="${color}"`)
  .replace(/<svg/, `<svg aria-label="${ariaLabel || name}" class="lucide-icon ${className}"`);
---

<Fragment set:html={modifiedSvg} />

<style>
  :global(.lucide-icon) {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
