---
/**
 * GlassCard Component
 * Modern glassmorphism card with layered depth and variant styles
 */
interface Props {
	variant?: 'glass' | 'solid' | 'gradient';
	color?: 'blue' | 'purple' | 'green' | 'orange' | 'teal';
	hover?: 'lift' | 'glow' | 'tilt';
	class?: string;
}

const { variant = 'glass', color = 'blue', hover = 'lift', class: className = '' } = Astro.props;

// Get gradient for color
const gradients = {
	blue: 'var(--ds-gradient-blue)',
	purple: 'var(--ds-gradient-purple)',
	green: 'var(--ds-gradient-teal)',
	orange: 'var(--ds-gradient-sunset)',
	teal: 'var(--ds-gradient-teal)'
};
---

<div class:list={['glass-card', `glass-${variant}`, `glass-${color}`, `glass-hover-${hover}`, className]}>
	<div class="glass-highlight"></div>
	<div class="glass-content">
		<slot />
	</div>
</div>

<style>
	.glass-card {
		position: relative;
		background: var(--ds-glass-bg);
		backdrop-filter: var(--ds-glass-blur);
		-webkit-backdrop-filter: var(--ds-glass-blur);
		border: 1px solid var(--ds-glass-border);
		border-radius: var(--ds-radius-xl);
		padding: var(--ds-space-xl);
		overflow: hidden;
		transition: all var(--ds-float-duration) ease;
	}

	.glass-highlight {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 50%;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%, transparent 100%);
		pointer-events: none;
	}

	/* Glass variant */
	.glass-glass {
		background: var(--ds-glass-bg);
		backdrop-filter: var(--ds-glass-blur);
		-webkit-backdrop-filter: var(--ds-glass-blur);
		border: 1px solid var(--ds-glass-border);
	}

	/* Solid variant */
	.glass-solid {
		background: var(--ds-bg-primary);
		border: 1px solid var(--ds-gray-200);
	}

	/* Gradient variant */
	.glass-gradient {
		background: var(--ds-gradient-blue);
		border: none;
		color: white;
	}

	.glass-gradient.glass-blue { background: var(--ds-gradient-blue); }
	.glass-gradient.glass-purple { background: var(--ds-gradient-purple); }
	.glass-gradient.glass-green { background: var(--ds-gradient-teal); }
	.glass-gradient.glass-orange { background: var(--ds-gradient-sunset); }
	.glass-gradient.glass-teal { background: var(--ds-gradient-teal); }

	/* Color-specific highlights */
	.glass-blue .glass-highlight {
		background: linear-gradient(180deg, rgba(var(--ds-brand-rgb),  0.15) 0%, transparent 100%);
	}
	.glass-purple .glass-highlight {
		background: linear-gradient(180deg, rgba(217, 70, 122,  0.15) 0%, transparent 100%);
	}
	.glass-green .glass-highlight {
		background: linear-gradient(180deg, rgba(76, 175, 80, 0.15) 0%, transparent 100%);
	}
	.glass-orange .glass-highlight {
		background: linear-gradient(180deg, rgba(255, 152, 0, 0.15) 0%, transparent 100%);
	}
	.glass-teal .glass-highlight {
		background: linear-gradient(180deg, rgba(var(--ds-brand-rgb), 0.15) 0%, transparent 100%);
	}

	/* Hover effects */
	.glass-card.glass-hover-lift:hover {
		transform: translateY(var(--ds-float-y));
		box-shadow: var(--ds-glass-shadow);
	}

	.glass-card.glass-hover-glow:hover {
		box-shadow: 0 0 30px rgba(var(--ds-brand-rgb),  0.3);
	}

	.glass-card.glass-hover-tilt:hover {
		transform: perspective(1000px) rotateX(2deg) rotateY(2deg) translateY(-4px);
		box-shadow: var(--ds-glass-shadow);
	}

	/* Content styling for gradient cards */
	.glass-gradient .glass-content {
		position: relative;
		z-index: 1;
	}

	.glass-gradient .glass-content h3,
	.glass-gradient .glass-content h2,
	.glass-gradient .glass-content p {
		color: white;
	}

	.glass-gradient .glass-content a {
		color: rgba(255, 255, 255, 0.9);
	}

	/* Dark mode adjustments */
	@media (prefers-color-scheme: dark) {
		.glass-card.glass-glass {
			background: rgba(30, 30, 30, 0.7);
			border-color: rgba(255, 255, 255, 0.1);
		}

		.glass-highlight {
			background: linear-gradient(180deg, rgba(255, 255, 255, 0.1) 0%, transparent 100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.glass-card:hover {
			transform: none !important;
		}
	}
</style>
