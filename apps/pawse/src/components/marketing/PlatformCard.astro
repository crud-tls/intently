---
/**
 * Platform Card Component
 * For showcasing the different platforms (Android, iOS, Chrome)
 */
import StoreButton from '../ui/StoreButton.astro';

interface Props {
	platform: 'android' | 'ios' | 'chrome';
	title: string;
	description: string;
	features: string[];
	downloadUrl: string;
	storeType: 'playstore' | 'appstore' | 'chromestore';
	available?: boolean;
}

const { platform, title, description, features, downloadUrl, storeType, available = true } = Astro.props;
---

<div class={"platform-card " + (!available ? "platform-card-soon" : "")}>
	<div class="platform-header">
		<div class="platform-icon">
			{platform === 'android' && (
				<svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
					<path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48C13.85 1.23 12.95 1 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31C6.97 3.26 6 5.01 6 7h12c0-1.99-.97-3.75-2.47-4.84zM10 5H9V4h1v1zm5 0h-1V4h1v1z"/>
				</svg>
			)}
			{platform === 'ios' && (
				<svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
					<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
				</svg>
			)}
			{platform === 'chrome' && (
				<svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
					<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
				</svg>
			)}
		</div>
		<div class="platform-info">
			<h3 class="platform-title">{title}</h3>
			{!available && <span class="coming-soon">Coming Soon</span>}
		</div>
	</div>
	<p class="platform-description">{description}</p>
	<ul class="platform-features">
		{features.map(feature => <li>{feature}</li>)}
	</ul>
	<div class="platform-cta">
		{available ? (
			<StoreButton store={storeType} href={downloadUrl} />
		) : (
			<button class="notify-btn" disabled>Coming Soon</button>
		)}
	</div>
</div>

<style>
	.platform-card {
		display: flex;
		flex-direction: column;
		gap: var(--intently-space-md);
		padding: var(--intently-space-xl);
		background: rgba(255, 255, 255, 0.7);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border-radius: 24px;
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.platform-card:hover {
		transform: translateY(-4px);
		background: rgba(255, 255, 255, 0.85);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 12px 40px rgba(0, 0, 0, 0.1),
			0 4px 12px rgba(0, 0, 0, 0.06);
	}

	@media (prefers-color-scheme: dark) {
		.platform-card {
			background: rgba(40, 40, 40, 0.7);
			border: 1px solid rgba(255, 255, 255, 0.12);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.15),
				0 4px 20px rgba(0, 0, 0, 0.4);
		}

		.platform-card:hover {
			background: rgba(40, 40, 40, 0.85);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.2),
				0 12px 40px rgba(0, 0, 0, 0.5);
		}
	}

	.platform-card-soon {
		opacity: 0.75;
	}

	.platform-card-soon:hover {
		transform: none;
	}

	.platform-header {
		display: flex;
		align-items: center;
		gap: var(--intently-space-md);
	}

	.platform-icon {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.6);
		border: 1px solid rgba(0, 0, 0, 0.05);
		border-radius: var(--intently-radius-md);
		color: var(--intently-text-primary);
		flex-shrink: 0;
	}

	@media (prefers-color-scheme: dark) {
		.platform-icon {
			background: rgba(255, 255, 255, 0.08);
			border-color: rgba(255, 255, 255, 0.1);
		}
	}

	.platform-icon svg {
		width: 32px;
		height: 32px;
	}

	.platform-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.platform-title {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0;
		color: var(--intently-text-primary);
	}

	.coming-soon {
		font-size: 0.75rem;
		font-weight: 600;
		color: white;
		background: var(--intently-orange);
		padding: 0.125rem 0.5rem;
		border-radius: var(--intently-radius-full);
		display: inline-block;
	}

	.platform-description {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--intently-text-secondary);
		margin: 0;
	}

	.platform-features {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.platform-features li {
		font-size: 0.9375rem;
		color: var(--intently-text-secondary);
		padding-left: 1.5rem;
		position: relative;
	}

	.platform-features li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: var(--intently-green);
		font-weight: 700;
	}

	.platform-cta {
		margin-top: auto;
		padding-top: var(--intently-space-md);
	}

	.notify-btn {
		width: 100%;
		padding: 0.75rem 1.5rem;
		background: var(--intently-bg-secondary);
		color: var(--intently-text-primary);
		border: 1px solid var(--intently-gray-300);
		border-radius: var(--intently-radius-md);
		font-weight: 600;
		cursor: not-allowed;
		font-size: 1rem;
		min-height: 48px;
	}

	/* Mobile: optimize spacing and sizing */
	@media (max-width: 767px) {
		.platform-card {
			padding: var(--intently-space-lg);
		}

		.platform-header {
			flex-direction: column;
			text-align: center;
		}

		.platform-icon {
			width: 56px;
			height: 56px;
		}

		.platform-icon svg {
			width: 36px;
			height: 36px;
		}

		.platform-title {
			font-size: 1.125rem;
		}

		.platform-description {
			font-size: 0.9375rem;
		}

		.platform-features li {
			font-size: 0.875rem;
		}
	}
</style>
