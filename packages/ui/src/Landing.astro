---
import AppMark from './AppMark.astro';
import type { App } from '@intently/registry';
import type { SiteContent } from './site';

interface Props {
	app: App;
	content: SiteContent;
}

const { app, content } = Astro.props;
const notifySubject = encodeURIComponent(`Tell me when ${app.name} launches`);
---

<main>
	<section class="hero">
		<div class="wrap grid">
			<div>
				{app.status !== 'live' && <p class="badge">{app.status === 'review' ? 'On Google Play soon' : 'Coming soon'}</p>}
				<h1>{content.headline}</h1>
				<p class="lead">{content.subhead}</p>
				<p class="ctas">
					{app.stores.play && <a class="button" href={app.stores.play}>Get it on Google Play</a>}
					{app.stores.appStore && <a class="button" href={app.stores.appStore}>Download on the App Store</a>}
					{!app.stores.play && !app.stores.appStore && (
						<a class="button" href={`mailto:${app.email}?subject=${notifySubject}`}>Tell me when it's out</a>
					)}
					<a class="ghost" href="#features">What it does</a>
				</p>
				<p class="muted small">{app.platforms.join(' · ')}</p>
			</div>
			<div class="art">
				<slot name="art"><AppMark app={app} size={180} /></slot>
			</div>
		</div>
	</section>

	<section id="features" class="wrap">
		<h2 class="section-title">What it does</h2>
		<div class="features">
			{content.features.map((f) => (
				<article class="feature">
					<h3>{f.title}</h3>
					<p class="muted">{f.body}</p>
				</article>
			))}
		</div>
	</section>

	{content.faq.length > 0 && (
		<section class="wrap" aria-labelledby="faq-title">
			<h2 id="faq-title" class="section-title">Questions</h2>
			<div class="faq">
				{content.faq.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
			<script type="application/ld+json" set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: content.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
			})} />
		</section>
	)}
</main>

<style>
	.hero {
		padding: 84px 0 64px;
		background:
			radial-gradient(55% 70% at 85% 40%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
			radial-gradient(45% 60% at 5% 10%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
	}

	.grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 40px;
		align-items: center;
	}

	.badge {
		display: inline-block;
		margin: 0 0 16px;
		padding: 4px 12px;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--line));
		font-size: 0.9rem;
		font-weight: 600;
	}

	h1 {
		font-size: clamp(2.4rem, 6vw, 4rem);
		font-weight: 800;
	}

	.lead {
		font-size: 1.2rem;
		color: var(--text-2);
		max-width: 34rem;
	}

	.ctas {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 18px;
		margin: 28px 0 12px;
	}

	.button { background: var(--accent); color: var(--on-accent); }

	.ghost {
		font-weight: 650;
		text-decoration: none;
	}

	.art {
		display: grid;
		place-items: center;
		min-height: 300px;
	}

	.section-title {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-2);
		margin: 64px 0 20px;
	}

	.features {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 18px;
	}

	.feature {
		padding: 22px;
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--accent) 6%, var(--surface));
		border: 1px solid color-mix(in srgb, var(--accent) 16%, var(--line));
	}

	.feature h3 { font-size: 1.1rem; }

	.feature p { margin: 0; }

	.faq details {
		border-bottom: 1px solid var(--line);
		padding: 16px 0;
	}

	.faq summary {
		cursor: pointer;
		font-weight: 650;
	}

	.faq p {
		margin: 10px 0 0;
		color: var(--text-2);
	}

	.small { font-size: 0.9rem; }

	@media (max-width: 760px) {
		.hero { padding-top: 48px; }
		.grid { grid-template-columns: 1fr; }
		.art { min-height: 200px; order: -1; }
	}
</style>
