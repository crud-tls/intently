---
import type { App } from '@intently/registry';
import type { SiteContent } from './site';

interface Props {
	app: App;
	content: SiteContent;
}

const { app, content } = Astro.props;
---

<main class="wrap page">
	<h1>{app.name} support</h1>
	<p class="lead">Questions, bug reports or ideas? Email us at <a href={`mailto:${app.email}`}>{app.email}</a>.
		We usually reply within two days.</p>
	<p class="muted">Please include your phone model and Android version if something isn't working.</p>
	{content.faq.length > 0 && <p><a href="/#faq-title">Common questions</a></p>}
	{content.accountDeletion && <p>Want to delete your account? <a href="/delete-account">Here's how</a>.</p>}
	{content.legal.privacy && <p>How we handle your data: <a href="/privacy">privacy policy</a>.</p>}
</main>

<style>
	.page {
		max-width: 680px;
		padding-top: 72px;
	}

	h1 { font-size: clamp(2rem, 5vw, 3rem); }

	.lead { font-size: 1.15rem; }
</style>
