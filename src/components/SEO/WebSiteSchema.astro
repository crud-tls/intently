---
/**
 * WebSite Schema with SearchAction
 * Enables site search box in Google search results
 * Usage: Add to homepage and/or globally in BaseHead
 */
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Intently",
  "alternateName": "Intently - Mindful Screen Time App",
  "url": "https://liveintently.app",
  "description": "Build healthier digital habits through mindful interventions. Privacy-first, 100% offline screen time tracking and digital wellbeing app.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://liveintently.app/search?q={search_term_string}"
    },
    "query-input": {
      "@type": "PropertyValueSpecification",
      "valueRequired": true,
      "valueName": "search_term_string"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Intently",
    "url": "https://liveintently.app",
    "logo": {
      "@type": "ImageObject",
      "url": "https://liveintently.app/favicon.svg"
    }
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
