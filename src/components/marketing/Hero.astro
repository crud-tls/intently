---
/**
 * Hero Section Component
 * Main hero section for the home page
 */
import Button from '../ui/Button.astro';
---

<section class="hero">
	<div class="hero-container">
		<div class="hero-content">
			<h1 class="hero-title">
				Build Healthier <span class="text-gradient">Digital Habits</span>
			</h1>
			<p class="hero-subtitle">
				Mindful interventions for screen time that respect your privacy.
				100% offline, no tracking, no account required.
			</p>
			<div class="hero-ctas">
				<Button href="/download" variant="primary" size="lg">
					Download Intently
				</Button>
				<Button href="/features" variant="secondary" size="lg">
					Learn How It Works
				</Button>
			</div>
			<div class="hero-badges">
				<span class="badge">
					<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
						<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
					</svg>
					Privacy-First
				</span>
				<span class="badge">
					<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
						<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
					</svg>
					100% Offline
				</span>
			</div>
		</div>
		<div class="hero-visual">
			<div class="hero-mockup">
				<div class="phone-frame">
					<div class="phone-screen">
						<div class="app-header">
							<div class="progress-ring">
								<svg viewBox="0 0 100 100">
									<circle cx="50" cy="50" r="45" fill="none" stroke="var(--intently-gray-200)" stroke-width="8"/>
									<circle cx="50" cy="50" r="45" fill="none" stroke="var(--intently-green)" stroke-width="8" stroke-dasharray="212" stroke-dashoffset="64" stroke-linecap="round" transform="rotate(-90 50 50)"/>
									<text x="50" y="55" text-anchor="middle" font-size="24" font-weight="bold" fill="var(--intently-green)">70%</text>
								</svg>
							</div>
						</div>
						<div class="app-content">
							<div class="stat-card">
								<div class="stat-label">Today</div>
								<div class="stat-value">2h 15m</div>
								<div class="stat-trend down">-25%</div>
							</div>
							<div class="streak-badge">
								<span>7 Day Streak!</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: var(--intently-space-4xl) 0;
		background: linear-gradient(180deg, var(--intently-bg-accent) 0%, var(--intently-bg-primary) 100%);
	}

	.hero-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 var(--intently-space-lg);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--intently-space-3xl);
		align-items: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: var(--intently-space-xl);
	}

	.hero-title {
		font-size: 3.5rem;
		font-weight: 800;
		line-height: 1.1;
		margin: 0;
		color: var(--intently-text-primary);
	}

	.text-gradient {
		background: linear-gradient(135deg, var(--intently-blue) 0%, var(--intently-purple) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--intently-text-secondary);
		margin: 0;
	}

	.hero-ctas {
		display: flex;
		gap: var(--intently-space-md);
		flex-wrap: wrap;
	}

	.hero-badges {
		display: flex;
		gap: var(--intently-space-md);
		flex-wrap: wrap;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background-color: var(--intently-bg-primary);
		border-radius: var(--intently-radius-full);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--intently-text-primary);
		box-shadow: var(--intently-shadow-sm);
	}

	.hero-visual {
		display: flex;
		justify-content: center;
	}

	.phone-frame {
		width: 280px;
		height: 560px;
		background: var(--intently-gray-900);
		border-radius: 40px;
		padding: 12px;
		box-shadow: var(--intently-shadow-xl);
	}

	.phone-screen {
		width: 100%;
		height: 100%;
		background: var(--intently-bg-primary);
		border-radius: 32px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.app-header {
		padding: var(--intently-space-xl);
		display: flex;
		justify-content: center;
		background: var(--intently-bg-secondary);
	}

	.progress-ring {
		width: 120px;
		height: 120px;
	}

	.progress-ring svg {
		width: 100%;
		height: 100%;
	}

	.app-content {
		padding: var(--intently-space-lg);
		display: flex;
		flex-direction: column;
		gap: var(--intently-space-md);
	}

	.stat-card {
		background: var(--intently-bg-secondary);
		border-radius: var(--intently-radius-lg);
		padding: var(--intently-space-md);
	}

	.stat-label {
		font-size: 0.875rem;
		color: var(--intently-text-secondary);
		margin-bottom: 0.25rem;
	}

	.stat-value {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--intently-text-primary);
	}

	.stat-trend {
		font-size: 0.875rem;
		font-weight: 600;
		margin-top: 0.25rem;
	}

	.stat-trend.down {
		color: var(--intently-green);
	}

	.streak-badge {
		background: linear-gradient(135deg, var(--intently-orange) 0%, var(--intently-purple) 100%);
		color: white;
		padding: var(--intently-space-md);
		border-radius: var(--intently-radius-lg);
		text-align: center;
		font-weight: 600;
	}

	/* Responsive */
	@media (max-width: 960px) {
		.hero-container {
			grid-template-columns: 1fr;
			text-align: center;
		}

		-hero-ctas {
			justify-content: center;
		}

		.hero-badges {
			justify-content: center;
		}

		.hero-title {
			font-size: 2.5rem;
		}

		.hero-visual {
			order: -1;
		}

		.phone-frame {
			width: 220px;
			height: 440px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding: var(--intently-space-2xl) 0;
		}

		.hero-title {
			font-size: 2rem;
		}

		.hero-subtitle {
			font-size: 1rem;
		}

		.hero-ctas {
			flex-direction: column;
			width: 100%;
		}

		.hero-ctas .btn {
			width: 100%;
		}
	}
</style>
