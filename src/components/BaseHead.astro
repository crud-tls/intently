---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import '../styles/design-system.css';
import OrganizationSchema from './SEO/OrganizationSchema.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	// Article-specific props for blog posts
	pubDate?: Date;
	modifiedDate?: Date;
	author?: string;
	section?: string;
	tags?: string[];
	readingTime?: number;
	// Open Graph type override
	ogType?: 'website' | 'article';
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/blog-placeholder-1.jpg',
	pubDate,
	modifiedDate,
	author,
	section,
	tags = [],
	readingTime,
	ogType = 'website'
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/logo.svg" />
<link rel="icon" type="image/png" href="/logo.png" />
<link rel="apple-touch-icon" href="/logo.png" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Preconnect to external domains for faster loading -->
<link rel="preconnect" href="https://liveintently.app" />
<link rel="dns-prefetch" href="https://liveintently.app" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang tags for internationalization (prepared for future multi-language support) -->
<link rel="alternate" hreflang="en" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="Intently Blog" href="/rss.xml" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Extended Meta Tags -->
<meta name="theme-color" content="#2196F3" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="keywords" content="screen time decrease app, reduce screen time app, screen time reducer, app to decrease screen time, lower screen time app, cut down screen time app, screen time limiter, screen time control app, digital wellbeing, app usage tracking, mindful tech, privacy-first, phone addiction app, stop scrolling app, digital detox app, focus app, productivity tracker, social media limiter, mindful phone use, habit tracker for phone, break phone addiction, reduce Instagram usage, stop TikTok addiction, phone usage tracker, app blocker alternative, mindful interventions, digital wellbeing Android, screen time app no account, offline screen time tracker, privacy screen time app, free screen time app, phone addiction help, reduce social media usage, digital minimalism app, focus app for students, self control app, behavioral science app, psychology-based screen time, gentle app reminder, screen time app without data collection" />
{readingTime && <meta name="estimated-reading-time" content={readingTime.toString()} />}

<!-- Article-specific meta tags (for blog posts) -->
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
{author && <meta property="article:author" content={author} />}
{section && <meta property="article:section" content={section} />}
{tags.length > 0 && <meta property="article:tag" content={tags.join(', ')} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:site_name" content="Intently" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:creator" content="@intently_app" />
<meta name="twitter:site" content="@intently_app" />
<meta property="twitter:domain" content="liveintently.app" />

<!-- Mobile App Meta Tags -->
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="Intently" />

<!-- App Linking for deep linking from web to mobile app -->
<meta property="al:android:url" content="intently://home" />
<meta property="al:android:package" content="app.intently" />
<meta property="al:android:app_name" content="Intently" />
<meta property="al:ios:url" content="intently://home" />
<meta property="al:ios:app_store_id" content="644xxxxxxxx" />
<meta property="al:ios:app_name" content="Intently" />
<meta property="al:web:url" content={canonicalURL} />
<meta property="al:web:should_fallback" content="true" />

<!-- Organization Schema -->
<OrganizationSchema />
