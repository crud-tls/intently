---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/features">Features</HeaderLink>
			<HeaderLink href="/download">Download</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
		<div class="cta-links">
			<HeaderLink href="/download" class="download-cta">Get the App</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: var(--intently-shadow-sm);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--intently-blue);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.75rem 0;
	}

	.internal-links {
		display: flex;
		gap: 0.5rem;
	}

	.internal-links a {
		padding: 0.5rem 0.75rem;
		color: var(--intently-text-primary);
		border-bottom: 2px solid transparent;
		transition: all var(--intently-transition-fast);
	}

	.internal-links a:hover {
		color: var(--intently-blue);
	}

	.internal-links a.active {
		font-weight: 600;
		border-bottom-color: var(--intently-blue);
	}

	.cta-links {
		display: flex;
		align-items: center;
	}

	.download-cta {
		background: var(--intently-blue);
		color: white !important;
		padding: 0.5rem 1rem !important;
		border-radius: var(--intently-radius-full);
		font-weight: 600;
		transition: all var(--intently-transition-normal);
	}

	.download-cta:hover {
		background: var(--intently-blue-dark);
		transform: translateY(-1px);
	}

	.download-cta.active {
		border-bottom-color: transparent;
	}

	@media (max-width: 720px) {
		.internal-links {
			display: none;
		}
	}
</style>
