---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="logo-link">
			<img src="/logo.svg" alt="Intently" class="logo" />
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/features">Features</HeaderLink>
			<HeaderLink href="/download">Download</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/quiz">Quiz</HeaderLink>
		</div>
		<div class="cta-links">
			<HeaderLink href="/download" class="download-cta">Get the App</HeaderLink>
		</div>
		<button
			class="hamburger"
			id="mobile-menu-toggle"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
			aria-controls="mobile-nav">
			<span></span>
			<span></span>
			<span></span>
		</button>
	</nav>
	<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/features">Features</HeaderLink>
		<HeaderLink href="/download">Download</HeaderLink>
		<HeaderLink href="/blog">Blog</HeaderLink>
		<HeaderLink href="/quiz">Quiz</HeaderLink>
		<HeaderLink href="/download" class="download-cta">Get the App</HeaderLink>
	</div>
</header>

<script>
	const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
	const mobileNav = document.getElementById('mobile-nav');

	function toggleMenu() {
		const isExpanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
		mobileMenuToggle.setAttribute('aria-expanded', !isExpanded);
		mobileNav.setAttribute('aria-hidden', isExpanded);
		mobileNav.classList.toggle('open', !isExpanded);
		document.body.classList.toggle('mobile-nav-open', !isExpanded);
	}

	mobileMenuToggle?.addEventListener('click', toggleMenu);

	// Close menu when clicking outside
	document.addEventListener('click', (event) => {
		if (mobileNav.classList.contains('open')) {
			const isClickInsideNav = mobileNav.contains(event.target as Node);
			const isClickOnToggle = mobileMenuToggle.contains(event.target as Node);
			if (!isClickInsideNav && !isClickOnToggle) {
				toggleMenu();
			}
		}
	});

	// Close menu when clicking a link
	const mobileNavLinks = mobileNav?.querySelectorAll('a');
	mobileNavLinks?.forEach(link => {
		link.addEventListener('click', () => {
			if (mobileNav.classList.contains('open')) {
				toggleMenu();
			}
		});
	});

	// Close menu on escape key
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && mobileNav.classList.contains('open')) {
			toggleMenu();
		}
	});
</script>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: var(--intently-shadow-sm);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	.logo-link {
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.logo {
		height: 40px;
		width: auto;
		display: block;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.75rem 0;
		position: relative;
	}

	.internal-links {
		display: flex;
		gap: 0.5rem;
	}

	.internal-links a {
		padding: 0.5rem 0.75rem;
		color: var(--intently-text-primary);
		border-bottom: 2px solid transparent;
		transition: all var(--intently-transition-fast);
	}

	.internal-links a:hover {
		color: var(--intently-blue);
	}

	.internal-links a.active {
		font-weight: 600;
		border-bottom-color: var(--intently-blue);
	}

	.cta-links {
		display: flex;
		align-items: center;
	}

	.download-cta {
		background: var(--intently-blue);
		color: white !important;
		padding: 0.5rem 1rem !important;
		border-radius: var(--intently-radius-full);
		font-weight: 600;
		transition: all var(--intently-transition-normal);
	}

	.download-cta:hover {
		background: var(--intently-blue-dark);
		transform: translateY(-1px);
	}

	.download-cta.active {
		border-bottom-color: transparent;
	}

	/* Hamburger button - hidden on desktop */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: space-around;
		width: 44px;
		min-height: 44px;
		padding: 0.5rem;
		background: transparent;
		border: none;
		cursor: pointer;
		z-index: 101;
	}

	.hamburger span {
		width: 24px;
		height: 2px;
		background: var(--intently-text-primary);
		border-radius: 2px;
		transition: all 0.3s ease;
		transform-origin: center;
	}

	.hamburger:hover span {
		background: var(--intently-blue);
	}

	/* Mobile navigation drawer */
	.mobile-nav {
		display: none;
		position: fixed;
		top: 0;
		right: 0;
		width: 100%;
		max-width: 300px;
		height: 100vh;
		background: white;
		box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
		padding: 5rem 1.5rem 2rem;
		flex-direction: column;
		gap: 0.5rem;
		transform: translateX(100%);
		transition: transform 0.3s ease;
		z-index: 99;
		overflow-y: auto;
	}

	.mobile-nav.open {
		display: flex;
		transform: translateX(0);
	}

	.mobile-nav a {
		padding: 0.875rem 0;
		min-height: 44px;
		display: flex;
		align-items: center;
		border-bottom: 1px solid var(--intently-border);
		font-size: 1.125rem;
	}

	.mobile-nav .download-cta {
		justify-content: center;
		text-align: center;
		margin-top: 1rem;
		border-radius: var(--intently-radius-md);
	}

	/* Overlay when mobile nav is open */
	body.mobile-nav-open::after {
		content: '';
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
		z-index: 98;
	}

	/* Hamburger animation when open */
	.hamburger[aria-expanded="true"] span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.hamburger[aria-expanded="true"] span:nth-child(2) {
		opacity: 0;
	}

	.hamburger[aria-expanded="true"] span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* Desktop: show desktop nav, hide hamburger */
	@media (min-width: 768px) {
		.internal-links {
			display: flex;
		}

		.hamburger {
			display: none;
		}

		.mobile-nav {
			display: none !important;
		}
	}

	/* Mobile: hide desktop nav, show hamburger */
	@media (max-width: 767px) {
		.logo {
			height: 32px;
		}

		.internal-links {
			display: none;
		}

		.hamburger {
			display: flex;
		}

		.mobile-nav {
			display: flex;
		}
	}
</style>
