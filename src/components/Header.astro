---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="logo-link">
			<img src="/logo.svg" alt="Intently" class="logo" />
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/features">Features</HeaderLink>
			<HeaderLink href="/download">Download</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<div class="tools-dropdown">
				<button class="tools-trigger" aria-expanded="false" aria-haspopup="true">
					Tools
					<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>
				<div class="tools-menu" role="menu">
					<a href="/quiz" role="menuitem">Phone Addiction Quiz</a>
					<a href="/screen-time-calculator" role="menuitem">Screen Time Calculator</a>
					<a href="/app-addiction-score" role="menuitem">App Addiction Score</a>
				</div>
			</div>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
		<div class="cta-links">
			<HeaderLink href="/download" class="download-cta">Get the App</HeaderLink>
		</div>
		<button
			class="hamburger"
			id="mobile-menu-toggle"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
			aria-controls="mobile-nav">
			<span></span>
			<span></span>
			<span></span>
		</button>
	</nav>
	<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/features">Features</HeaderLink>
		<HeaderLink href="/download">Download</HeaderLink>
		<HeaderLink href="/blog">Blog</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
		<div class="mobile-tools-section">
			<span class="mobile-tools-label">Tools</span>
			<HeaderLink href="/quiz">Phone Addiction Quiz</HeaderLink>
			<HeaderLink href="/screen-time-calculator">Screen Time Calculator</HeaderLink>
			<HeaderLink href="/app-addiction-score">App Addiction Score</HeaderLink>
		</div>
		<HeaderLink href="/contact">Contact</HeaderLink>
		<HeaderLink href="/download" class="download-cta">Get the App</HeaderLink>
	</div>
</header>

<script>
	const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
	const mobileNav = document.getElementById('mobile-nav');

	function toggleMenu() {
		const isExpanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
		mobileMenuToggle.setAttribute('aria-expanded', !isExpanded);
		mobileNav.setAttribute('aria-hidden', isExpanded);
		mobileNav.classList.toggle('open', !isExpanded);
		document.body.classList.toggle('mobile-nav-open', !isExpanded);
	}

	mobileMenuToggle?.addEventListener('click', toggleMenu);

	// Close menu when clicking outside
	document.addEventListener('click', (event) => {
		if (mobileNav.classList.contains('open')) {
			const isClickInsideNav = mobileNav.contains(event.target as Node);
			const isClickOnToggle = mobileMenuToggle.contains(event.target as Node);
			if (!isClickInsideNav && !isClickOnToggle) {
				toggleMenu();
			}
		}
	});

	// Close menu when clicking a link
	const mobileNavLinks = mobileNav?.querySelectorAll('a');
	mobileNavLinks?.forEach(link => {
		link.addEventListener('click', (event) => {
			const target = event.currentTarget as HTMLAnchorElement;
			const href = target.getAttribute('href');
			if (!href) {
				return;
			}

			// Let the browser perform cross-page navigation uninterrupted.
			// Only close the drawer immediately for same-page links.
			const targetUrl = new URL(href, window.location.origin);
			const isSamePage =
				targetUrl.pathname === window.location.pathname &&
				targetUrl.search === window.location.search;

			if (isSamePage && mobileNav.classList.contains('open')) {
				toggleMenu();
			}
		});
	});

	// Close menu on escape key
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && mobileNav.classList.contains('open')) {
			toggleMenu();
		}
	});

	// Tools dropdown
	const toolsTrigger = document.querySelector('.tools-trigger');
	const toolsMenu = document.querySelector('.tools-menu');

	toolsTrigger?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = toolsTrigger.getAttribute('aria-expanded') === 'true';
		toolsTrigger.setAttribute('aria-expanded', (!isOpen).toString());
		toolsMenu?.classList.toggle('open', !isOpen);
	});

	document.addEventListener('click', () => {
		toolsTrigger?.setAttribute('aria-expanded', 'false');
		toolsMenu?.classList.remove('open');
	});

	// Hide header on scroll down, show on scroll up
	let lastScrollY = window.scrollY;
	let isHeaderHidden = false;
	const header = document.querySelector('header') as HTMLElement;
	const scrollThreshold = 100;

	function updateHeaderVisibility() {
		const currentScrollY = window.scrollY;

		// Don't hide if at top of page
		if (currentScrollY < scrollThreshold) {
			header.style.transform = 'translateY(0)';
			isHeaderHidden = false;
			return;
		}

		// Don't hide if mobile nav is open
		if (mobileNav?.classList.contains('open')) {
			return;
		}

		// Detect scroll direction
		const scrollDirection = currentScrollY > lastScrollY ? 'down' : 'up';

		if (scrollDirection === 'down' && !isHeaderHidden && currentScrollY > scrollThreshold) {
			// Hide header when scrolling down
			header.style.transform = 'translateY(-100%)';
			isHeaderHidden = true;
		} else if (scrollDirection === 'up' && isHeaderHidden) {
			// Show header when scrolling up
			header.style.transform = 'translateY(0)';
			isHeaderHidden = false;
		}

		lastScrollY = currentScrollY;
	}

	// Throttle scroll events for better performance
	let ticking = false;
	window.addEventListener('scroll', () => {
		if (!ticking) {
			window.requestAnimationFrame(() => {
				updateHeaderVisibility();
				ticking = false;
			});
			ticking = true;
		}
	}, { passive: true });
</script>

<style>
	header {
		margin: 0;
		padding: 0;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		display: flex;
		justify-content: center;
		padding-top: 2rem;
		pointer-events: none;
		transition: transform 0.3s ease-in-out;
		will-change: transform;
	}

	html {
		scroll-padding-top: 8rem;
		scroll-behavior: smooth;
	}

	.logo-link {
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.logo {
		height: 36px;
		width: auto;
		display: block;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.875rem 1.5rem;
		background: color-mix(in srgb, var(--intently-bg-primary) 70%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid color-mix(in srgb, var(--intently-bg-primary) 30%, transparent);
		border-radius: 1rem;
		box-shadow:
			var(--intently-shadow-sm),
			inset 0 1px 0 color-mix(in srgb, var(--intently-bg-primary) 50%, transparent);
		pointer-events: auto;
		transition: all 0.3s ease;
	}

	nav:hover {
		box-shadow:
			var(--intently-shadow-md),
			inset 0 1px 0 color-mix(in srgb, var(--intently-bg-primary) 50%, transparent);
	}

	.internal-links {
		display: flex;
		gap: 0.25rem;
	}

	.internal-links a {
		padding: 0.625rem 0.875rem;
		color: var(--intently-text-secondary);
		border-radius: 0.625rem;
		transition: all var(--intently-transition-fast);
		font-weight: 500;
		font-size: 0.9375rem;
		border-bottom: none;
	}

	.internal-links a:hover {
		color: var(--intently-blue);
		background: rgba(59, 130, 246, 0.08);
	}

	.internal-links a.active {
		color: var(--intently-blue);
		background: rgba(59, 130, 246, 0.12);
		font-weight: 600;
	}

	.cta-links {
		display: flex;
		align-items: center;
	}

	.download-cta {
		background: rgba(33, 150, 243, 0.85);
		backdrop-filter: blur(12px) saturate(150%);
		-webkit-backdrop-filter: blur(12px) saturate(150%);
		color: white !important;
		padding: 0.625rem 1.125rem !important;
		border-radius: 0.75rem;
		font-weight: 600;
		font-size: 0.9375rem;
		transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
		border: 1px solid rgba(255, 255, 255, 0.25);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.3),
			0 2px 10px rgba(33, 150, 243, 0.25);
		border-bottom: none;
	}

	.download-cta:hover {
		background: rgba(33, 150, 243, 0.95);
		transform: translateY(-2px);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.35),
			0 6px 20px rgba(33, 150, 243, 0.35);
	}

	.download-cta.active {
		background: rgba(25, 118, 210, 0.9);
	}

	/* Hamburger button - hidden on desktop */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: space-around;
		width: 44px;
		min-height: 44px;
		padding: 0.625rem;
		background: color-mix(in srgb, var(--intently-bg-primary) 50%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid color-mix(in srgb, var(--intently-bg-primary) 30%, transparent);
		border-radius: 0.75rem;
		cursor: pointer;
		z-index: 101;
		transition: all 0.3s ease;
	}

	.hamburger:hover {
		background: color-mix(in srgb, var(--intently-bg-primary) 70%, transparent);
	}

	.hamburger span {
		width: 20px;
		height: 2px;
		background: var(--intently-text-primary);
		border-radius: 2px;
		transition: all 0.3s ease;
		transform-origin: center;
	}

	.hamburger:hover span {
		background: var(--intently-blue);
	}

	/* Mobile navigation drawer */
	.mobile-nav {
		display: none;
		position: fixed;
		top: 0;
		right: 0;
		width: 100%;
		max-width: 300px;
		height: 100vh;
		background: var(--intently-bg-primary);
		box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
		padding: 5rem 1.5rem 2rem;
		flex-direction: column;
		gap: 0.5rem;
		transform: translateX(100%);
		transition: transform 0.3s ease;
		z-index: 99;
		overflow-y: auto;
		pointer-events: auto;
	}

	.mobile-nav.open {
		display: flex;
		transform: translateX(0);
	}

	.mobile-nav a {
		padding: 0.875rem 0;
		min-height: 44px;
		display: flex;
		align-items: center;
		border-bottom: 1px solid var(--intently-border);
		font-size: 1.125rem;
	}

	.mobile-nav .download-cta {
		justify-content: center;
		text-align: center;
		margin-top: 1rem;
		border-radius: var(--intently-radius-md);
	}

	/* Overlay when mobile nav is open */
	body.mobile-nav-open::after {
		content: '';
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: color-mix(in srgb, var(--intently-bg-primary) 50%, transparent);
		z-index: 98;
	}

	/* Hamburger animation when open */
	.hamburger[aria-expanded="true"] span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.hamburger[aria-expanded="true"] span:nth-child(2) {
		opacity: 0;
	}

	.hamburger[aria-expanded="true"] span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* Desktop: show desktop nav, hide hamburger */
	@media (min-width: 768px) {
		.internal-links {
			display: flex;
		}

		.hamburger {
			display: none;
		}

		.mobile-nav {
			display: none !important;
		}

		nav {
			max-width: 90%;
		}
	}

	/* Tools dropdown */
	.tools-dropdown {
		position: relative;
		display: flex;
		align-items: center;
	}

	.tools-trigger {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.625rem 0.875rem;
		color: var(--intently-text-secondary);
		border-radius: 0.625rem;
		transition: all var(--intently-transition-fast);
		font-weight: 500;
		font-size: 0.9375rem;
		background: none;
		border: none;
		cursor: pointer;
		font-family: inherit;
	}

	.tools-trigger:hover,
	.tools-trigger[aria-expanded="true"] {
		color: var(--intently-blue);
		background: rgba(59, 130, 246, 0.08);
	}

	.tools-trigger svg {
		transition: transform 0.2s ease;
	}

	.tools-trigger[aria-expanded="true"] svg {
		transform: rotate(180deg);
	}

	.tools-menu {
		display: none;
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 50%;
		transform: translateX(-50%);
		min-width: 220px;
		padding: 0.5rem;
		background: color-mix(in srgb, var(--intently-bg-primary) 85%, transparent);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid color-mix(in srgb, var(--intently-bg-primary) 30%, transparent);
		border-radius: 0.75rem;
		box-shadow: var(--intently-shadow-lg);
		z-index: 200;
	}

	.tools-menu.open {
		display: block;
	}

	.tools-menu a {
		display: block;
		padding: 0.625rem 0.875rem;
		color: var(--intently-text-secondary);
		text-decoration: none;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		font-weight: 500;
		transition: all var(--intently-transition-fast);
		white-space: nowrap;
	}

	.tools-menu a:hover {
		color: var(--intently-blue);
		background: rgba(59, 130, 246, 0.08);
	}

	/* Mobile tools section */
	.mobile-tools-section {
		display: flex;
		flex-direction: column;
	}

	.mobile-tools-label {
		padding: 0.875rem 0 0.25rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--intently-text-hint);
	}

	.mobile-tools-section a {
		padding-left: 0.75rem;
		font-size: 1rem;
	}

	/* Mobile: hide desktop nav, show hamburger */
	@media (max-width: 767px) {
		header {
			padding-top: 1rem;
		}

		.logo {
			height: 28px;
		}

		.internal-links {
			display: none;
		}

		.hamburger {
			display: flex;
		}

		.mobile-nav {
			display: flex;
		}

		nav {
			padding: 0.75rem 1rem;
			gap: 1rem;
			max-width: 95%;
		}

		.download-cta {
			padding: 0.5rem 0.875rem !important;
			font-size: 0.875rem;
		}
	}
</style>
