---
/**
 * Button Component
 * Variants: primary, secondary, ghost
 * Sizes: sm, md, lg
 */
interface Props {
	variant?: 'primary' | 'secondary' | 'ghost';
	size?: 'sm' | 'md' | 'lg';
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	class?: string;
	[attr: string]: any;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	type = 'button',
	class: className = '',
	...attrs
} = Astro.props;

const classes = Astro.slots.has('default')
	? `btn btn-${variant} btn-${size} ${className}`.trim()
	: `btn btn-${variant} btn-${size} ${className}`.trim();
---

{href ? (
	<a href={href} class={classes} {...attrs}>
		<slot />
	</a>
) : (
	<button type={type} class={classes} {...attrs}>
		<slot />
	</button>
)}

<style>
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-weight: 600;
		text-decoration: none;
		border-radius: 9999px;
		transition: all var(--intently-transition-normal);
		cursor: pointer;
		border: 2px solid transparent;
		font-family: inherit;
	}

	.btn:hover {
		transform: translateY(-1px);
	}

	.btn:active {
		transform: translateY(0);
	}

	/* Primary variant — glassmorphic */
	.btn-primary {
		background: rgba(33, 150, 243, 0.85);
		backdrop-filter: blur(12px) saturate(150%);
		-webkit-backdrop-filter: blur(12px) saturate(150%);
		color: white;
		border: 1px solid rgba(255, 255, 255, 0.25);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.3),
			0 4px 16px rgba(33, 150, 243, 0.3);
	}

	.btn-primary:hover {
		background: rgba(33, 150, 243, 0.95);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.35),
			0 8px 24px rgba(33, 150, 243, 0.4);
		transform: translateY(-2px);
	}

	.btn-primary:active {
		background: rgba(25, 118, 210, 0.95);
	}

	/* Secondary variant — glassmorphic */
	.btn-secondary {
		background: rgba(255, 255, 255, 0.15);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		color: var(--intently-blue);
		border: 1px solid rgba(33, 150, 243, 0.3);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.3);
		border-color: rgba(33, 150, 243, 0.5);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.3),
			0 4px 16px rgba(33, 150, 243, 0.1);
		transform: translateY(-2px);
	}

	@media (prefers-color-scheme: dark) {
		.btn-secondary {
			background: rgba(255, 255, 255, 0.08);
			border-color: rgba(66, 165, 245, 0.3);
		}

		.btn-secondary:hover {
			background: rgba(255, 255, 255, 0.15);
			border-color: rgba(66, 165, 245, 0.5);
		}
	}

	/* Ghost variant */
	.btn-ghost {
		background-color: transparent;
		color: var(--intently-text-primary);
	}

	.btn-ghost:hover {
		background-color: var(--intently-gray-100);
	}

	/* Sizes */
	.btn-sm {
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
		min-height: 44px;
	}

	.btn-md {
		padding: 0.75rem 1.5rem;
		font-size: 1rem;
		min-height: 48px;
	}

	.btn-lg {
		padding: 1rem 2rem;
		font-size: 1.125rem;
		min-height: 52px;
	}

	/* Mobile: optimize button sizing */
	@media (max-width: 767px) {
		.btn-sm {
			padding: 0.625rem 1rem;
			font-size: 0.875rem;
		}

		.btn-md {
			padding: 0.875rem 1.5rem;
			font-size: 1rem;
		}

		.btn-lg {
			padding: 0.875rem 1.5rem;
			font-size: 1rem;
		}
	}
</style>
