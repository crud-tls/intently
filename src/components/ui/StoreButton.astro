---
/**
 * Store Button Component
 * For App Store, Play Store, and Chrome Web Store download buttons
 */
interface Props {
	store: 'appstore' | 'playstore' | 'chromestore';
	href: string;
	class?: string;
}

const { store, href, class: className = '' } = Astro.props;
---

<a href={href} class={`store-button store-button-${store} ${className}`} target="_blank" rel="noopener noreferrer">
	<div class="store-icon">
		{store === 'appstore' && (
			<svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
				<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
			</svg>
		)}
		{store === 'playstore' && (
			<svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
				<path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
			</svg>
		)}
		{store === 'chromestore' && (
			<svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
				<path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm0 3.6c1.7 0 3.27.5 4.6 1.35l-1.45 2.5c-.85-.5-1.85-.8-2.9-.8-1.05 0-2.05.3-2.9.8L7.9 4.95C9.23 4.1 10.8 3.6 12 3.6zM3.6 12c0-1.7.5-3.27 1.35-4.6l2.5 1.45c-.5.85-.8 1.85-.8 2.9 0 1.05.3 2.05.8 2.9l-2.5 1.45C4.1 15.27 3.6 13.7 3.6 12zm8.4 8.4c-1.7 0-3.27-.5-4.6-1.35l1.45-2.5c.85.5 1.85.8 2.9.8 1.05 0 2.05-.3 2.9-.8l1.45 2.5c-1.33.85-2.9 1.35-4.6 1.35z"/>
			</svg>
		)}
	</div>
	<div class="store-text">
		<span class="store-subtitle">{store === 'chromestore' ? '' : store === 'appstore' ? 'Download on the' : 'GET IT ON'}</span>
		<span class="store-name">{store === 'appstore' ? 'App Store' : store === 'playstore' ? 'Google Play' : 'Chrome'}</span>
	</div>
</a>

<style>
	.store-button {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 1rem;
		background-color: var(--intently-gray-900);
		color: white;
		border-radius: var(--intently-radius-md);
		text-decoration: none;
		transition: all var(--intently-transition-normal);
		min-height: 48px;
	}

	.store-button:hover {
		transform: translateY(-2px);
		box-shadow: var(--intently-shadow-lg);
		background-color: black;
	}

	.store-button:active {
		transform: translateY(0);
	}

	.store-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.store-icon svg {
		width: 24px;
		height: 24px;
	}

	.store-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.store-subtitle {
		font-size: 0.625rem;
		opacity: 0.9;
		line-height: 1.2;
	}

	.store-name {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.2;
	}

	@media (max-width: 767px) {
		.store-button {
			padding: 0.5rem 0.875rem;
			min-height: 44px;
		}

		.store-name {
			font-size: 0.9rem;
		}
	}
</style>
