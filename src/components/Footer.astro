---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<div class="footer-brand">
			<h3>Intently</h3>
			<p>Build healthier digital habits through mindful interventions.</p>
		</div>
		<div class="footer-links">
			<div class="footer-section">
				<h4>Product</h4>
				<a href="/features">Features</a>
				<a href="/download">Download</a>
				<a href="/privacy">Privacy</a>
				<a href="/terms">Terms</a>
			</div>
			<div class="footer-section">
				<h4>Company</h4>
				<a href="/about">About</a>
				<a href="/blog">Blog</a>
			</div>
		</div>
	</div>
	<div class="footer-bottom">
		<p>&copy; {today.getFullYear()} Intently. All rights reserved.</p>
		<div class="footer-badges">
			<span class="privacy-badge">
				<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
					<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
				</svg>
				Privacy-First
			</span>
			<span class="offline-badge">
				<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
					<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
				</svg>
				100% Offline
			</span>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: var(--intently-space-3xl) 1rem var(--intently-space-xl);
		background: var(--intently-gray-50);
		color: var(--intently-text-secondary);
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 2fr 3fr;
		gap: var(--intently-space-3xl);
		margin-bottom: var(--intently-space-2xl);
	}

	.footer-brand h3 {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--intently-blue);
		margin: 0 0 var(--intently-space-sm) 0;
	}

	.footer-brand p {
		margin: 0;
		max-width: 300px;
		line-height: 1.6;
	}

	.footer-links {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--intently-space-xl);
	}

	.footer-section h4 {
		font-size: 0.875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--intently-text-primary);
		margin: 0 0 var(--intently-space-md) 0;
	}

	.footer-section a {
		display: block;
		text-decoration: none;
		color: var(--intently-text-secondary);
		padding: 0.25rem 0;
		transition: color var(--intently-transition-fast);
	}

	.footer-section a:hover {
		color: var(--intently-blue);
	}

	.footer-bottom {
		max-width: 1200px;
		margin: 0 auto;
		padding-top: var(--intently-space-xl);
		border-top: 1px solid var(--intently-gray-200);
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--intently-space-md);
	}

	.footer-bottom p {
		margin: 0;
		font-size: 0.875rem;
	}

	.footer-badges {
		display: flex;
		gap: var(--intently-space-md);
	}

	.footer-badges span {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.8125rem;
		font-weight: 500;
	}

	.privacy-badge {
		color: var(--intently-green);
	}

	.offline-badge {
		color: var(--intently-blue);
	}

	@media (max-width: 767px) {
		.footer-content {
			grid-template-columns: 1fr;
			gap: var(--intently-space-xl);
		}

		.footer-links {
			grid-template-columns: 1fr;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
