---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlogPostSchema from '../components/SEO/BlogPostSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import SpeakableSchema from '../components/SEO/SpeakableSchema.astro';
import AuthorBio from '../components/blog/AuthorBio.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, faq } = Astro.props;
const { currentPath } = Astro.url;
const postUrl = `https://liveintently.app${currentPath}`;

// Calculate estimated reading time (average 200 words per minute)
const wordsPerMinute = 200;
const wordCount = description.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / wordsPerMinute));

// Default tags for SEO if not specified in frontmatter
const defaultTags = ["digital wellbeing", "screen time", "mindful tech"];
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			pubDate={pubDate}
			modifiedDate={updatedDate}
			author="Intently Team"
			section="Digital Wellbeing"
			tags={defaultTags}
			readingTime={readingTime}
			ogType="article"
		/>
		<BlogPostSchema
			title={title}
			description={description}
			publishedAt={pubDate}
			modifiedAt={updatedDate}
			image={heroImage}
			url={postUrl}
			section="Digital Wellbeing"
			tags={defaultTags}
		/>
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "Blog", url: "https://liveintently.app/blog" },
				{ name: title, url: postUrl }
			]}
		/>
		<SpeakableSchema
			title={title}
			speakableSelectors={["#article-intro", "#article-conclusion"]}
		/>
		{faq && <FAQSchema faqs={faq} />}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt={`${title} - Intently blog post illustration`} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<!-- Speakable section for voice search optimization -->
					<div id="article-intro" class="speakable-content">
						<slot />
					</div>
					<div id="article-conclusion" class="speakable-content" style="display: none;">
						{title} - A comprehensive guide on digital wellbeing and screen time management by Intently.
					</div>
					<AuthorBio />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
