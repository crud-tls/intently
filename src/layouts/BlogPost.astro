---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlogPostSchema from '../components/SEO/BlogPostSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';

import HowToSchema from '../components/SEO/HowToSchema.astro';
import AuthorBio from '../components/blog/AuthorBio.astro';
import { Image } from 'astro:assets';

type Props = CollectionEntry<'blog'>['data'] & { wordCount?: number; readingTime?: number };

const { title, description, pubDate, updatedDate, heroImage, faq, howToSteps, wordCount = 0, readingTime = 1 } = Astro.props;
const { currentPath } = Astro.url;
const postUrl = `https://liveintently.app${currentPath}`;

// Default tags for SEO if not specified in frontmatter
const defaultTags = ["digital wellbeing", "screen time", "mindful tech"];
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			pubDate={pubDate}
			modifiedDate={updatedDate}
			author="Intently Team"
			section="Digital Wellbeing"
			tags={defaultTags}
			readingTime={readingTime}
			ogType="article"
		/>
		<BlogPostSchema
			title={title}
			description={description}
			publishedAt={pubDate}
			modifiedAt={updatedDate}
			image={heroImage}
			url={postUrl}
			section="Digital Wellbeing"
			tags={defaultTags}
			wordCount={wordCount}
		/>
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "Blog", url: "https://liveintently.app/blog" },
				{ name: title, url: postUrl }
			]}
		/>

		{faq && <FAQSchema faqs={faq} />}
		{howToSteps && (
			<HowToSchema
				name={title}
				description={description}
				image={heroImage}
				steps={howToSteps}
			/>
		)}
		<style>
			body {
				background: var(--intently-bg-primary);
			}

			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				max-width: 720px;
				margin: auto;
				padding: 1em;
				color: var(--intently-text-primary);
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}

			.title::before {
				content: '';
				display: block;
				height: 6rem;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--intently-text-secondary);
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={`${title} - Intently blog post illustration`} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<div id="article-intro">
						<slot />
					</div>
					<AuthorBio />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
