---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			html {
				scroll-behavior: smooth;
			}

			main {
				width: 100%;
			}

			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 var(--intently-space-xl);
			}

			section {
				padding: var(--intently-space-4xl) 0;
				background: var(--intently-bg-primary);
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: var(--intently-space-xl);
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: var(--intently-transition-normal);
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.5rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--intently-text-primary);
				line-height: 1;
			}
			.date {
				margin: 0;
				color: var(--intently-text-secondary);
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--intently-blue);
			}
			ul a:hover img {
				box-shadow: var(--intently-shadow-lg);
			}

			a:focus-visible,
			button:focus-visible {
				outline: 2px solid var(--intently-blue);
				outline-offset: 2px;
			}
			@media (max-width: 768px) {
				ul {
					gap: var(--intently-space-md);
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="container">
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<img
										width={720}
										height={360}
										src={post.data.heroImage}
										alt={post.data.title}
										loading="lazy"
									/>
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
