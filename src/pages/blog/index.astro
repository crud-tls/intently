---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BreadcrumbSchema from '../../components/SEO/BreadcrumbSchema.astro';
import CollectionPageSchema from '../../components/SEO/CollectionPageSchema.astro';
import Picture from '../../components/ui/Picture.astro';
import {
	BLOG_CATEGORIES,
	getBlogCategoryId,
	getBlogCategoryMeta,
	getNormalizedHeroImage,
} from '../../data/blogMeta';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function getWordCount(markdownBody = ''): number {
	const plainText = markdownBody
		.replace(/```[\s\S]*?```/g, ' ')
		.replace(/`[^`]*`/g, ' ')
		.replace(/\[(.*?)\]\(.*?\)/g, '$1')
		.replace(/https?:\/\/\S+/g, ' ')
		.replace(/[#*_>~|!-]/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();

	if (!plainText) {
		return 0;
	}

	return plainText.split(' ').length;
}

const postsWithMeta = posts.map((post) => {
	const wordCount = getWordCount(post.body || '');
	const readingTime = Math.max(1, Math.ceil(wordCount / 200));
	const categoryId = getBlogCategoryId(post.id);
	const category = getBlogCategoryMeta(post.id);
	const heroImage = getNormalizedHeroImage(post.data.heroImage);

	return {
		...post,
		categoryId,
		category,
		heroImage,
		readingTime,
		searchText: `${post.data.title} ${post.data.description} ${category.label}`.toLowerCase(),
	};
});

const featuredPost = postsWithMeta[0];
const regularPosts = postsWithMeta.slice(1);

const categoryFilters = BLOG_CATEGORIES
	.map((category) => ({
		...category,
		count: postsWithMeta.filter((post) => post.categoryId === category.id).length,
	}))
	.filter((category) => category.count > 0);

const collectionItems = postsWithMeta.map((post) => ({
	name: post.data.title,
	url: `https://liveintently.app/blog/${post.id}/`,
	description: post.data.description,
	image: post.heroImage,
	datePublished: post.data.pubDate.toISOString(),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog & Resources - ${SITE_TITLE}`}
			description="Actionable digital wellbeing guides, behavior-change strategies, and app comparisons to help you build healthier phone habits."
		/>
		<BreadcrumbSchema
			items={[
				{ name: 'Home', url: 'https://liveintently.app' },
				{ name: 'Blog', url: 'https://liveintently.app/blog' },
			]}
		/>
		<CollectionPageSchema
			name="Intently Blog & Resources"
			description="Articles, guides, and research on digital wellbeing, screen time management, and building healthier relationships with technology."
			url="/blog"
			items={collectionItems}
		/>
	</head>
	<body>
		<Header />
		<main class="blog-page">
			<section class="blog-hero">
				<div class="hero-copy">
					<p class="hero-eyebrow">Intently Journal</p>
					<h1>Blog & Resources</h1>
					<p>
						Practical, research-backed content for people who want to reduce screen time without
						deleting the apps they care about.
					</p>
				</div>
				<div class="hero-actions">
					<a href="/quiz" class="hero-button primary">Take the Phone Habit Quiz</a>
					<a href="/download" class="hero-button secondary">Download Intently</a>
				</div>
			</section>

			<section class="blog-controls" aria-label="Filter and search blog posts">
				<div class="search-field">
					<label for="blog-search">Search articles</label>
					<input
						id="blog-search"
						type="search"
						placeholder="Try: doomscrolling, Instagram, alternatives, ADHD..."
						autocomplete="off"
					/>
				</div>

				<div class="filter-row" role="group" aria-label="Blog categories">
					<button
						type="button"
						class="filter-chip active"
						data-category="all"
						aria-pressed="true">
						All Posts
						<span>{postsWithMeta.length}</span>
					</button>
					{
						categoryFilters.map((category) => (
							<button
								type="button"
								class="filter-chip"
								data-category={category.id}
								aria-pressed="false">
								{category.label}
								<span>{category.count}</span>
							</button>
						))
					}
				</div>

				<p id="results-summary" class="results-summary">Showing {postsWithMeta.length} articles</p>
			</section>

			{featuredPost && (
				<article
					class="featured-post"
					data-post
					data-category={featuredPost.categoryId}
					data-search={featuredPost.searchText}>
					<a href={`/blog/${featuredPost.id}/`} class="featured-media" aria-label={`Read ${featuredPost.data.title}`}>
						<Picture
							src={featuredPost.heroImage}
							alt={featuredPost.data.title}
							width={960}
							height={540}
							loading="eager"
						/>
					</a>
					<div class="featured-content">
						<div class="post-meta">
							<span class="category-tag" style={`--category-accent: ${featuredPost.category.accentColor}`}>
								{featuredPost.category.label}
							</span>
							<span><FormattedDate date={featuredPost.data.pubDate} /></span>
							<span>{featuredPost.readingTime} min read</span>
						</div>
						<h2>
							<a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
						</h2>
						<p>{featuredPost.data.description}</p>
						<a href={`/blog/${featuredPost.id}/`} class="read-link">Read featured article</a>
					</div>
				</article>
			)}

			<section class="blog-grid" id="blog-grid" aria-live="polite">
				{
					regularPosts.map((post) => (
						<article
							class="blog-card"
							data-post
							data-category={post.categoryId}
							data-search={post.searchText}>
							<a href={`/blog/${post.id}/`} class="card-media" aria-label={`Read ${post.data.title}`}>
								<Picture
									src={post.heroImage}
									alt={post.data.title}
									width={720}
									height={405}
									loading="lazy"
								/>
							</a>
							<div class="card-content">
								<div class="post-meta">
									<span class="category-tag" style={`--category-accent: ${post.category.accentColor}`}>
										{post.category.label}
									</span>
									<span><FormattedDate date={post.data.pubDate} /></span>
									<span>{post.readingTime} min read</span>
								</div>
								<h3>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h3>
								<p>{post.data.description}</p>
								<a href={`/blog/${post.id}/`} class="read-link">Read article</a>
							</div>
						</article>
					))
				}
			</section>

			<p id="empty-state" class="empty-state" hidden>
				No articles match that filter. Try a different category or a broader search term.
			</p>

			<section class="blog-cta">
				<h2>Want a personalized starting point?</h2>
				<p>
					Take the 2-minute phone habit quiz to get targeted recommendations based on your biggest
					scrolling trigger.
				</p>
				<div class="cta-actions">
					<a href="/quiz" class="hero-button primary">Start the Quiz</a>
					<a href="/compare" class="hero-button secondary">Compare Alternatives</a>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const searchInput = document.getElementById('blog-search');
			const filterButtons = Array.from(document.querySelectorAll('.filter-chip'));
			const postCards = Array.from(document.querySelectorAll('[data-post]'));
			const emptyState = document.getElementById('empty-state');
			const resultsSummary = document.getElementById('results-summary');

			let activeCategory = 'all';

			function setActiveCategoryChip(category) {
				filterButtons.forEach((button) => {
					const isActive = button.getAttribute('data-category') === category;
					button.classList.toggle('active', isActive);
					button.setAttribute('aria-pressed', String(isActive));
				});
			}

			function applyFilters(updateHash) {
				const query = (searchInput?.value || '').trim().toLowerCase();
				let visibleCount = 0;

				postCards.forEach((card) => {
					const cardCategory = card.getAttribute('data-category') || '';
					const searchableText = card.getAttribute('data-search') || '';
					const matchesCategory = activeCategory === 'all' || cardCategory === activeCategory;
					const matchesSearch = query.length === 0 || searchableText.includes(query);
					const shouldShow = matchesCategory && matchesSearch;

					card.toggleAttribute('hidden', !shouldShow);
					if (shouldShow) {
						visibleCount += 1;
					}
				});

				if (resultsSummary) {
					const noun = visibleCount === 1 ? 'article' : 'articles';
					resultsSummary.textContent = query
						? `Showing ${visibleCount} ${noun} for "${query}"`
						: `Showing ${visibleCount} ${noun}`;
				}

				if (emptyState) {
					emptyState.toggleAttribute('hidden', visibleCount > 0);
				}

				if (updateHash) {
					history.replaceState(null, '', activeCategory === 'all' ? '/blog' : `/blog#${activeCategory}`);
				}
			}

			function applyHashCategory() {
				const hashCategory = window.location.hash.replace('#', '');
				const hashIsValid = filterButtons.some(
					(button) => button.getAttribute('data-category') === hashCategory,
				);
				activeCategory = hashCategory && hashIsValid ? hashCategory : 'all';
				setActiveCategoryChip(activeCategory);
				applyFilters(false);
			}

			filterButtons.forEach((button) => {
				button.addEventListener('click', () => {
					activeCategory = button.getAttribute('data-category') || 'all';
					setActiveCategoryChip(activeCategory);
					applyFilters(true);
				});
			});

			searchInput?.addEventListener('input', () => applyFilters(false));
			window.addEventListener('hashchange', applyHashCategory);

			applyHashCategory();
		</script>
	</body>
</html>

<style>
	body {
		background:
			radial-gradient(circle at 15% 15%, color-mix(in srgb, var(--intently-blue) 16%, transparent) 0%, transparent 35%),
			radial-gradient(circle at 90% 8%, color-mix(in srgb, var(--intently-green) 14%, transparent) 0%, transparent 32%),
			var(--intently-bg-primary);
	}

	.blog-page {
		max-width: 1160px;
		margin: 0 auto;
		padding: 9rem var(--intently-space-md) var(--intently-space-4xl);
		display: grid;
		gap: var(--intently-space-xl);
	}

	.blog-hero {
		border-radius: var(--intently-radius-xl);
		padding: clamp(1.5rem, 2.5vw, 2.5rem);
		background:
			linear-gradient(140deg, color-mix(in srgb, var(--intently-blue) 12%, transparent), transparent 50%),
			linear-gradient(210deg, color-mix(in srgb, var(--intently-green) 10%, transparent), transparent 55%),
			var(--intently-bg-secondary);
		border: 1px solid color-mix(in srgb, var(--intently-text-hint) 18%, transparent);
		box-shadow: var(--intently-shadow-sm);
		display: grid;
		gap: var(--intently-space-lg);
	}

	.hero-copy h1 {
		margin: 0 0 var(--intently-space-sm);
		font-size: clamp(1.8rem, 2.7vw, 2.8rem);
		line-height: 1.12;
		letter-spacing: -0.02em;
	}

	.hero-copy p {
		margin: 0;
		max-width: 60ch;
		color: var(--intently-text-secondary);
		line-height: 1.7;
	}

	.hero-eyebrow {
		display: inline-flex;
		margin: 0 0 var(--intently-space-sm);
		padding: 0.3rem 0.75rem;
		border-radius: var(--intently-radius-full);
		background: color-mix(in srgb, var(--intently-blue) 14%, transparent);
		color: var(--intently-blue);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.hero-actions,
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--intently-space-sm);
	}

	.hero-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: var(--touch-target-comfortable);
		padding: 0.7rem 1.2rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		border: 1px solid transparent;
		transition: transform var(--intently-transition-fast), box-shadow var(--intently-transition-fast), background var(--intently-transition-fast);
	}

	.hero-button.primary {
		background: var(--intently-blue);
		color: white;
		box-shadow: 0 10px 26px color-mix(in srgb, var(--intently-blue) 35%, transparent);
	}

	.hero-button.primary:hover {
		transform: translateY(-1px);
		background: var(--intently-blue-dark);
	}

	.hero-button.secondary {
		background: color-mix(in srgb, var(--intently-bg-primary) 88%, transparent);
		color: var(--intently-text-primary);
		border-color: color-mix(in srgb, var(--intently-text-hint) 22%, transparent);
	}

	.hero-button.secondary:hover {
		transform: translateY(-1px);
		border-color: color-mix(in srgb, var(--intently-blue) 45%, transparent);
		color: var(--intently-blue);
	}

	.blog-controls {
		background: var(--intently-bg-primary);
		border-radius: var(--intently-radius-lg);
		border: 1px solid color-mix(in srgb, var(--intently-text-hint) 20%, transparent);
		padding: var(--intently-space-lg);
		display: grid;
		gap: var(--intently-space-md);
		box-shadow: var(--intently-shadow-sm);
	}

	.search-field {
		display: grid;
		gap: 0.4rem;
	}

	.search-field label {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--intently-text-secondary);
	}

	.search-field input {
		width: 100%;
		box-sizing: border-box;
		padding: 0.72rem 0.9rem;
		border-radius: var(--intently-radius-md);
		border: 1px solid color-mix(in srgb, var(--intently-text-hint) 32%, transparent);
		background: color-mix(in srgb, var(--intently-bg-secondary) 75%, var(--intently-bg-primary));
		color: var(--intently-text-primary);
		font-family: inherit;
	}

	.search-field input:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--intently-blue) 70%, white);
		outline-offset: 2px;
	}

	.filter-row {
		display: flex;
		gap: var(--intently-space-sm);
		overflow-x: auto;
		padding-bottom: 0.2rem;
		scrollbar-width: thin;
	}

	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 0.95rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--intently-text-hint) 30%, transparent);
		background: var(--intently-bg-primary);
		color: var(--intently-text-secondary);
		font-size: 0.88rem;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		transition: all var(--intently-transition-fast);
	}

	.filter-chip span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.35rem;
		height: 1.35rem;
		padding: 0 0.35rem;
		border-radius: 999px;
		font-size: 0.75rem;
		background: color-mix(in srgb, var(--intently-text-hint) 18%, transparent);
		color: var(--intently-text-primary);
	}

	.filter-chip:hover {
		border-color: color-mix(in srgb, var(--intently-blue) 50%, transparent);
		color: var(--intently-blue);
	}

	.filter-chip.active {
		background: color-mix(in srgb, var(--intently-blue) 10%, transparent);
		border-color: color-mix(in srgb, var(--intently-blue) 40%, transparent);
		color: var(--intently-blue);
	}

	.results-summary {
		margin: 0;
		font-size: 0.9rem;
		color: var(--intently-text-secondary);
	}

	.featured-post {
		display: grid;
		grid-template-columns: 1fr;
		background: var(--intently-bg-primary);
		border-radius: var(--intently-radius-xl);
		border: 1px solid color-mix(in srgb, var(--intently-text-hint) 22%, transparent);
		overflow: hidden;
		box-shadow: var(--intently-shadow-md);
	}

	.featured-media {
		display: block;
		aspect-ratio: 16 / 9;
		background: color-mix(in srgb, var(--intently-bg-secondary) 80%, transparent);
	}

	.featured-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}

	.featured-content {
		padding: var(--intently-space-lg);
		display: grid;
		gap: var(--intently-space-sm);
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		font-size: 0.82rem;
		color: var(--intently-text-secondary);
	}

	.category-tag {
		display: inline-flex;
		align-items: center;
		padding: 0.24rem 0.6rem;
		border-radius: var(--intently-radius-full);
		background: color-mix(in srgb, var(--category-accent) 14%, transparent);
		color: var(--category-accent);
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.featured-content h2,
	.card-content h3 {
		margin: 0;
		font-size: clamp(1.35rem, 2.1vw, 2rem);
		line-height: 1.2;
	}

	.card-content h3 {
		font-size: 1.2rem;
	}

	.featured-content h2 a,
	.card-content h3 a {
		text-decoration: none;
		color: var(--intently-text-primary);
	}

	.featured-content p,
	.card-content p {
		margin: 0;
		color: var(--intently-text-secondary);
		line-height: 1.68;
	}

	.read-link {
		display: inline-flex;
		align-items: center;
		font-weight: 700;
		text-decoration: none;
		color: var(--intently-blue);
		margin-top: var(--intently-space-xs);
	}

	.read-link:hover {
		color: var(--intently-blue-dark);
	}

	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-md);
	}

	.blog-card {
		display: grid;
		grid-template-rows: auto 1fr;
		background: var(--intently-bg-primary);
		border-radius: var(--intently-radius-lg);
		border: 1px solid color-mix(in srgb, var(--intently-text-hint) 20%, transparent);
		overflow: hidden;
		box-shadow: var(--intently-shadow-sm);
		transition: transform var(--intently-transition-normal), box-shadow var(--intently-transition-normal), border-color var(--intently-transition-normal);
	}

	.blog-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--intently-shadow-md);
		border-color: color-mix(in srgb, var(--intently-blue) 28%, transparent);
	}

	.card-media {
		display: block;
		aspect-ratio: 16 / 10;
		background: color-mix(in srgb, var(--intently-bg-secondary) 78%, transparent);
	}

	.card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}

	.card-content {
		display: grid;
		gap: var(--intently-space-sm);
		padding: var(--intently-space-md) var(--intently-space-md) var(--intently-space-lg);
	}

	.empty-state {
		margin: 0;
		padding: var(--intently-space-lg);
		text-align: center;
		border: 1px dashed color-mix(in srgb, var(--intently-text-hint) 35%, transparent);
		background: var(--intently-bg-primary);
		border-radius: var(--intently-radius-lg);
		color: var(--intently-text-secondary);
	}

	.blog-cta {
		padding: clamp(1.4rem, 2.4vw, 2.2rem);
		border-radius: var(--intently-radius-xl);
		background:
			linear-gradient(145deg, color-mix(in srgb, var(--intently-blue) 12%, transparent), transparent 50%),
			linear-gradient(220deg, color-mix(in srgb, var(--intently-purple) 10%, transparent), transparent 60%),
			var(--intently-bg-secondary);
		border: 1px solid color-mix(in srgb, var(--intently-text-hint) 18%, transparent);
		display: grid;
		gap: var(--intently-space-sm);
	}

	.blog-cta h2 {
		margin: 0;
		font-size: clamp(1.2rem, 2.3vw, 1.8rem);
	}

	.blog-cta p {
		margin: 0;
		color: var(--intently-text-secondary);
		max-width: 56ch;
	}

	[data-post][hidden] {
		display: none !important;
	}

	a:focus-visible,
	button:focus-visible,
	input:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--intently-blue) 70%, white);
		outline-offset: 2px;
	}

	@media (min-width: 760px) {
		.blog-page {
			padding-top: 9.5rem;
		}

		.blog-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--intently-space-lg);
		}

		.featured-post {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		}

		.featured-media {
			aspect-ratio: auto;
			height: 100%;
			min-height: 100%;
		}

		.featured-content {
			padding: var(--intently-space-xl);
			align-content: center;
		}
	}

	@media (min-width: 1080px) {
		.blog-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (prefers-color-scheme: dark) {
		.blog-hero,
		.blog-controls,
		.featured-post,
		.blog-card,
		.blog-cta,
		.empty-state {
			border-color: color-mix(in srgb, var(--intently-text-hint) 32%, transparent);
		}
	}
</style>
