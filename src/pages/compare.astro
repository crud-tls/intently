---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';

const comparisons = [
	{
		title: "Intently vs Opal",
		description: "Free mindful pause vs $99/yr app blocking. Compare approaches, features, privacy, and effectiveness.",
		href: "/blog/intently-vs-opal",
		badge: "Most Popular",
		badgeColor: "blue"
	},
	{
		title: "Intently vs One Sec",
		description: "Free customizable prompts vs $50 breathing exercises. Head-to-head of two mindful pause apps.",
		href: "/blog/intently-vs-one-sec",
		badge: "Direct Competitor",
		badgeColor: "purple"
	},
	{
		title: "Intently vs Freedom",
		description: "Free mindful intervention vs $120/yr cross-device blocking. Different philosophies compared.",
		href: "/blog/intently-vs-freedom",
		badge: null,
		badgeColor: null
	},
	{
		title: "Intently vs Forest",
		description: "Mindful pause vs gamification with virtual trees. Which approach builds better habits?",
		href: "/blog/intently-vs-forest",
		badge: null,
		badgeColor: null
	},
	{
		title: "Intently vs ScreenZen",
		description: "Two free mindful screen time apps compared. Features, platforms, and privacy side by side.",
		href: "/blog/intently-vs-screenzen",
		badge: "Both Free",
		badgeColor: "green"
	},
	{
		title: "Intently vs Brick",
		description: "Free software pause vs $59 physical NFC device. Digital friction vs physical friction.",
		href: "/blog/intently-vs-brick",
		badge: null,
		badgeColor: null
	},
	{
		title: "Intently vs Google Digital Wellbeing",
		description: "Advanced mindful interventions vs basic built-in Android tools. Why you might need more.",
		href: "/blog/intently-vs-google-digital-wellbeing",
		badge: null,
		badgeColor: null
	}
];

const alternatives = [
	{
		title: "Best Opal Alternatives",
		description: "8 free and paid alternatives to Opal's $99/yr screen time app.",
		href: "/blog/opal-alternatives",
		competitor: "Opal"
	},
	{
		title: "Best Freedom Alternatives",
		description: "Top app blockers and mindful tools to replace Freedom's $120/yr subscription.",
		href: "/blog/freedom-alternatives",
		competitor: "Freedom"
	},
	{
		title: "Best One Sec Alternatives",
		description: "Free apps that pause before scrolling — especially for Android users.",
		href: "/blog/one-sec-alternatives",
		competitor: "One Sec"
	},
	{
		title: "Best Apple Screen Time Alternatives",
		description: "Better phone habit apps for iPhone that go beyond basic limits.",
		href: "/blog/apple-screen-time-alternatives",
		competitor: "Apple Screen Time"
	},
	{
		title: "Best Forest App Alternatives",
		description: "Focus and digital wellness apps for those who want more than gamification.",
		href: "/blog/forest-app-alternatives",
		competitor: "Forest"
	},
	{
		title: "Best Google Digital Wellbeing Alternatives",
		description: "Top 8 privacy-first apps that outperform Android's built-in tools.",
		href: "/blog/google-digital-wellbeing-alternatives",
		competitor: "Google Digital Wellbeing"
	}
];

const faqs = [
	{
		question: "What is the best free screen time app?",
		answer: "Intently is the best free screen time app. It offers mindful interventions, usage tracking, streak tracking, and detailed analytics — all completely free with no account required and no data collection. Unlike competitors that charge $50-120/year, Intently has no premium tier or paywalls."
	},
	{
		question: "Is Intently better than Opal?",
		answer: "For most users seeking lasting behavior change, yes. Intently uses mindful interventions proven more effective long-term than Opal's app blocking approach. Intently is also free (vs Opal's $99/yr) and fully private with no data collection. Opal may be better for iOS users needing immediate hard blocking."
	},
	{
		question: "What's the difference between app blocking and mindful interventions?",
		answer: "App blocking prevents access to apps entirely, which triggers psychological reactance (wanting what you can't have). Mindful interventions create a brief pause before apps open, prompting awareness and conscious choice. Research shows interventions lead to 73% better long-term results than blocking."
	},
	{
		question: "Do I need to pay for a screen time app?",
		answer: "No. Intently offers all features for free — usage tracking, mindful interventions, streak tracking, analytics, and more. Paid apps like Opal ($99/yr) and Freedom ($120/yr) offer additional features but aren't necessary for effective screen time management."
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Screen Time App Comparison: Intently vs Top Alternatives"
			description="Compare Intently with Opal, One Sec, Freedom, Forest, ScreenZen, Brick, and more. Find the best screen time app for your needs with our detailed feature, pricing, and privacy comparisons."
		/>
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "Compare Apps", url: "https://liveintently.app/compare" }
			]}
		/>
		<FAQSchema faqs={faqs} />
	</head>
	<body>
		<Header />

		<main>
			<!-- Hero -->
			<section class="hero">
				<div class="container">
					<h1>Compare Screen Time Apps</h1>
					<p class="subtitle">Honest, detailed comparisons to help you choose the right digital wellbeing tool. See how Intently stacks up against every major competitor.</p>
					<div class="hero-stats">
						<div class="stat">
							<span class="stat-value">$0</span>
							<span class="stat-label">Intently cost</span>
						</div>
						<div class="stat">
							<span class="stat-value">4.7</span>
							<span class="stat-label">Star rating</span>
						</div>
						<div class="stat">
							<span class="stat-value">12K+</span>
							<span class="stat-label">Downloads</span>
						</div>
						<div class="stat">
							<span class="stat-value">100%</span>
							<span class="stat-label">Private</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Head-to-Head Comparisons -->
			<section class="section">
				<div class="container">
					<h2 class="section-title">Head-to-Head Comparisons</h2>
					<p class="section-description">See how Intently compares directly with each competitor on features, pricing, privacy, and effectiveness.</p>

					<div class="card-grid">
						{comparisons.map((item) => (
							<a href={item.href} class="compare-card">
								{item.badge && (
									<span class={`card-badge badge-${item.badgeColor}`}>{item.badge}</span>
								)}
								<h3>{item.title}</h3>
								<p>{item.description}</p>
								<span class="card-link">Read comparison →</span>
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- Alternatives Guides -->
			<section class="section section-alt">
				<div class="container">
					<h2 class="section-title">Alternatives Guides</h2>
					<p class="section-description">Looking for alternatives to a specific app? These guides compare all the top options side by side.</p>

					<div class="card-grid">
						{alternatives.map((item) => (
							<a href={item.href} class="compare-card alt-card">
								<span class="competitor-badge">{item.competitor}</span>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
								<span class="card-link">See alternatives →</span>
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- Quick Comparison Matrix -->
			<section class="section">
				<div class="container">
					<h2 class="section-title">Quick Comparison Matrix</h2>
					<p class="section-description">How the top screen time apps compare at a glance.</p>

					<div class="table-wrapper">
						<table class="comparison-table">
							<thead>
								<tr>
									<th>Feature</th>
									<th class="highlight">Intently</th>
									<th>Opal</th>
									<th>One Sec</th>
									<th>Freedom</th>
									<th>Forest</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td>Price</td>
									<td class="highlight">Free</td>
									<td>$99/yr</td>
									<td>$50</td>
									<td>$120/yr</td>
									<td>$2-4</td>
								</tr>
								<tr>
									<td>Approach</td>
									<td class="highlight">Mindful pause</td>
									<td>Blocking</td>
									<td>Breathing</td>
									<td>Blocking</td>
									<td>Gamification</td>
								</tr>
								<tr>
									<td>Privacy</td>
									<td class="highlight">100% offline</td>
									<td>Cloud sync</td>
									<td>Good</td>
									<td>Account req.</td>
									<td>Good</td>
								</tr>
								<tr>
									<td>Android</td>
									<td class="highlight">✓</td>
									<td>✓</td>
									<td>✗</td>
									<td>✓</td>
									<td>✓</td>
								</tr>
								<tr>
									<td>iOS</td>
									<td class="highlight">Coming soon</td>
									<td>✓</td>
									<td>✓</td>
									<td>✓</td>
									<td>✓</td>
								</tr>
								<tr>
									<td>Chrome</td>
									<td class="highlight">✓</td>
									<td>✓</td>
									<td>✓</td>
									<td>✓</td>
									<td>✗</td>
								</tr>
								<tr>
									<td>Account Required</td>
									<td class="highlight">No</td>
									<td>Yes</td>
									<td>No</td>
									<td>Yes</td>
									<td>Optional</td>
								</tr>
								<tr>
									<td>Usage Analytics</td>
									<td class="highlight">✓</td>
									<td>✓</td>
									<td>Limited</td>
									<td>✓</td>
									<td>Limited</td>
								</tr>
								<tr>
									<td>Streak Tracking</td>
									<td class="highlight">✓</td>
									<td>✓</td>
									<td>✓</td>
									<td>✗</td>
									<td>✓</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section class="cta-section">
				<div class="container">
					<h2>Ready to Take Control?</h2>
					<p>Intently is free, private, and takes 30 seconds to set up. No account needed.</p>
					<div class="cta-buttons">
						<Button href="/download" variant="primary" size="lg">Download Free</Button>
						<Button href="/quiz" variant="secondary" size="lg">Take the Quiz</Button>
					</div>
				</div>
			</section>

			<!-- FAQ -->
			<section class="section section-alt">
				<div class="container faq-container">
					<h2 class="section-title">Frequently Asked Questions</h2>
					{faqs.map((faq) => (
						<details class="faq-item">
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* Hero */
	.hero {
		width: 100%;
		padding: var(--intently-space-3xl) 0 var(--intently-space-2xl);
		background: linear-gradient(135deg, var(--intently-blue) 0%, #00BCD4 100%);
		text-align: center;
		color: white;
	}

	.hero h1 {
		font-size: 2.5rem;
		font-weight: 800;
		margin: 0 0 var(--intently-space-md);
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: white;
	}

	.subtitle {
		font-size: 1.125rem;
		margin: 0 auto var(--intently-space-xl);
		opacity: 0.95;
		max-width: 600px;
	}

	.hero-stats {
		display: flex;
		justify-content: center;
		gap: var(--intently-space-xl);
		flex-wrap: wrap;
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.stat-value {
		font-size: 1.75rem;
		font-weight: 800;
	}

	.stat-label {
		font-size: 0.8125rem;
		opacity: 0.85;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	/* Sections */
	.section {
		width: 100%;
		padding: var(--intently-space-3xl) 0;
		background: var(--intently-bg-primary);
	}

	.section-alt {
		background: var(--intently-bg-secondary);
	}

	.section-title {
		font-size: 2rem;
		font-weight: 800;
		text-align: center;
		margin: 0 0 var(--intently-space-sm);
		color: var(--intently-text-primary);
	}

	.section-description {
		text-align: center;
		color: var(--intently-text-secondary);
		max-width: 600px;
		margin: 0 auto var(--intently-space-2xl);
		line-height: 1.6;
	}

	/* Card Grid */
	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: var(--intently-space-lg);
	}

	.compare-card {
		position: relative;
		display: block;
		padding: var(--intently-space-xl);
		background: var(--intently-bg-primary);
		border: 1px solid var(--intently-gray-200);
		border-radius: var(--intently-radius-lg);
		text-decoration: none;
		transition: all var(--intently-transition-normal);
	}

	.compare-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--intently-shadow-lg);
		border-color: var(--intently-blue);
	}

	.compare-card h3 {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--intently-text-primary);
		margin: 0 0 var(--intently-space-sm);
	}

	.compare-card p {
		font-size: 0.9375rem;
		color: var(--intently-text-secondary);
		margin: 0 0 var(--intently-space-md);
		line-height: 1.5;
	}

	.card-link {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--intently-blue);
	}

	.card-badge {
		position: absolute;
		top: var(--intently-space-md);
		right: var(--intently-space-md);
		padding: 0.2rem 0.6rem;
		border-radius: var(--intently-radius-full);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.badge-blue {
		background: rgba(33, 150, 243, 0.1);
		color: var(--intently-blue);
	}

	.badge-purple {
		background: rgba(156, 39, 176, 0.1);
		color: var(--intently-purple);
	}

	.badge-green {
		background: rgba(76, 175, 80, 0.1);
		color: var(--intently-green);
	}

	.alt-card {
		background: var(--intently-bg-primary);
	}

	.competitor-badge {
		display: inline-block;
		padding: 0.2rem 0.6rem;
		border-radius: var(--intently-radius-full);
		font-size: 0.75rem;
		font-weight: 600;
		background: var(--intently-bg-secondary);
		color: var(--intently-text-secondary);
		margin-bottom: var(--intently-space-sm);
	}

	/* Comparison Table */
	.table-wrapper {
		overflow-x: auto;
		border-radius: var(--intently-radius-lg);
		border: 1px solid var(--intently-gray-200);
	}

	.comparison-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
		min-width: 600px;
	}

	.comparison-table th,
	.comparison-table td {
		padding: var(--intently-space-md);
		text-align: left;
		border-bottom: 1px solid var(--intently-gray-200);
	}

	.comparison-table thead th {
		background: var(--intently-bg-secondary);
		font-weight: 700;
		color: var(--intently-text-primary);
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.comparison-table td {
		color: var(--intently-text-secondary);
	}

	.comparison-table .highlight {
		background: rgba(33, 150, 243, 0.05);
		color: var(--intently-blue);
		font-weight: 600;
	}

	.comparison-table thead .highlight {
		background: rgba(33, 150, 243, 0.1);
		color: var(--intently-blue);
	}

	.comparison-table tbody tr:last-child td {
		border-bottom: none;
	}

	/* CTA Section */
	.cta-section {
		width: 100%;
		padding: var(--intently-space-3xl) 0;
		background: linear-gradient(135deg, var(--intently-blue) 0%, var(--intently-purple) 100%);
		text-align: center;
		color: white;
	}

	.cta-section h2 {
		font-size: 2rem;
		font-weight: 800;
		margin: 0 0 var(--intently-space-sm);
		color: white;
	}

	.cta-section p {
		font-size: 1.125rem;
		margin: 0 0 var(--intently-space-xl);
		opacity: 0.95;
	}

	.cta-buttons {
		display: flex;
		gap: var(--intently-space-md);
		justify-content: center;
		flex-wrap: wrap;
	}

	/* FAQ */
	.faq-container {
		max-width: 800px;
	}

	.faq-item {
		border: 1px solid var(--intently-gray-200);
		border-radius: var(--intently-radius-md);
		margin-bottom: var(--intently-space-sm);
		overflow: hidden;
		background: var(--intently-bg-primary);
	}

	.faq-item summary {
		padding: var(--intently-space-md) var(--intently-space-lg);
		font-weight: 600;
		color: var(--intently-text-primary);
		cursor: pointer;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.faq-item summary::after {
		content: "+";
		font-size: 1.25rem;
		color: var(--intently-blue);
		flex-shrink: 0;
	}

	.faq-item[open] summary::after {
		content: "-";
	}

	.faq-item p {
		padding: 0 var(--intently-space-lg) var(--intently-space-md);
		margin: 0;
		color: var(--intently-text-secondary);
		line-height: 1.6;
	}

	/* Responsive */
	@media (max-width: 767px) {
		.hero h1 {
			font-size: 2rem;
		}

		.hero-stats {
			gap: var(--intently-space-lg);
		}

		.stat-value {
			font-size: 1.5rem;
		}

		.section-title {
			font-size: 1.5rem;
		}

		.card-grid {
			grid-template-columns: 1fr;
		}

		.cta-buttons {
			flex-direction: column;
			align-items: center;
		}
	}

	@media (min-width: 1024px) {
		.hero h1 {
			font-size: 3rem;
		}
	}
</style>
