---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import { SITE_TITLE } from '../consts';

const features = [
	{
		icon: "BarChart3",
		title: "Finally See the Truth",
		description: "You tell yourself it's only 20 minutes. The data tells a different story. Intently shows you exactly where your time goes—without judgment.",
		details: ["Daily time summaries", "Per-app usage breakdown", "Weekly and monthly trends", "Category-based grouping"],
		color: "blue"
	},
	{
		icon: "Target",
		title: "Set Boundaries You Actually Keep",
		description: "Choose how much time feels right for each app. When you're getting close, Intently lets you know. No locking, no lectures—just a gentle heads-up.",
		details: ["Custom time limits per app", "Visual progress rings", "Goal achievement celebrations", "Flexible limit adjustments"],
		color: "green"
	},
	{
		icon: "Bell",
		title: "The 3-Second Pause That Changes Everything",
		description: "Before an app opens, a simple screen appears: 'Is this what you want to be doing right now?' That tiny moment is all it takes.",
		details: ["Customizable reminder messages", "Timer-based interventions", "Multiple intervention types", "Reflection prompts"],
		color: "purple"
	},
	{
		icon: "Trophy",
		title: "Celebrate Every Win (Even the Small Ones)",
		description: "Day 1 feels small. Day 7 feels like something. Day 30 feels like you're becoming someone new. Intently tracks your streaks because lasting change deserves recognition.",
		details: ["Daily streak tracking", "Milestone celebrations", "Achievement badges", "Streak recovery options"],
		color: "orange"
	},
	{
		icon: "TrendingUp",
		title: "Watch Your Progress Unfold",
		description: "Beautiful charts show your journey over days, weeks, and months. See your baseline shrink, and feel the pride of measurable progress.",
		details: ["Usage trend charts", "Baseline comparisons", "Improvement metrics", "Exportable reports"],
		color: "blue"
	},
	{
		icon: "Brain",
		title: "Ask Yourself: Is This What I Want?",
		description: "Custom prompts invite you to pause and reflect before diving into an app. Breathing exercises calm the impulse. It's mindfulness, built into your phone.",
		details: ["Custom reflection prompts", "Breathing exercises", "Intention setting", "Usage journaling"],
		color: "green"
	},
	{
		icon: "Smartphone",
		title: "Your Progress, At a Glance",
		description: "A beautiful widget on your home screen shows your streak and today's progress. One look is often enough to remind you of who you're becoming.",
		details: ["Home screen widgets", "Quick settings toggle", "One-tap stats view", "Notification center integration"],
		color: "purple"
	},
	{
		icon: "Lock",
		title: "We Literally Cannot See Your Data",
		description: "No cloud. No servers. No account. Not even we can access your usage patterns. Your digital life is yours alone. Period.",
		details: ["100% offline functionality", "Local data storage only", "No account required", "No tracking or analytics"],
		color: "green"
	}
];

const featureFAQs = [
	{
		question: "How does Intently track app usage?",
		answer: "Intently runs locally on your device, monitoring which apps you use and how long you spend in each one. All data stays on your phone - we never collect or send anything to our servers. This approach gives you complete privacy while providing accurate usage insights."
	},
	{
		question: "Is Intently better than other screen time apps?",
		answer: "Unlike blocking-based solutions that use shame and restriction, Intently uses psychology-backed mindful interventions. Instead of preventing app access, we create moments of awareness so you can make conscious choices about your time. Studies show this compassionate approach leads to more lasting behavior change."
	},
	{
		question: "Does Intently work offline?",
		answer: "Yes, Intently is 100% offline-first. All tracking, analytics, and interventions happen on your device. You don't need an account, internet connection, or cloud sync. Your data belongs entirely to you."
	},
	{
		question: "Can I use Intently on multiple devices?",
		answer: "Intently works independently on each device (Android, iOS, Chrome). Currently, data doesn't sync between devices, keeping everything local and private. Each device maintains its own usage history and settings."
	},
	{
		question: "What makes Intently privacy-first?",
		answer: "Intently stores zero data in the cloud. No servers, no analytics, no advertising networks, no tracking. You don't need to create an account. We make money through optional premium features on-device, not through selling your data."
	}
];

const colorMap: Record<string, string> = {
	blue: 'var(--intently-blue)',
	green: 'var(--intently-green)',
	orange: 'var(--intently-orange)',
	purple: 'var(--intently-purple)'
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="How Intently Works | Mindful Screen Time Features" description="Usage tracking that opens your eyes. Interventions that feel like a deep breath. Streaks that build quiet pride. See how Intently helps 12,000+ people choose presence over scrolling." />
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "Features", url: "https://liveintently.app/features" }
			]}
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- Features Hero - Glass -->
			<section class="features-hero">
				<div class="hero-glow" aria-hidden="true"></div>
				<div class="container">
					<h1 class="text-gradient">Everything You Need to Take Back Control</h1>
					<p class="hero-subtitle">Intently uses behavioral science—not shame—to help you become the person who puts their phone down and doesn't think twice about it.</p>
				</div>
			</section>

			<!-- What is Intently - Glass Intro -->
			<section class="intro-section">
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<h2>What is Intently?</h2>
						<div class="glass-intro-card">
							<p class="direct-answer">
								Intently is a <strong>privacy-first digital wellbeing app</strong> that helps you build healthier relationships with technology. Instead of blocking apps, it uses <strong>mindful interventions</strong> to create moments of awareness, helping you make conscious choices about screen time. All data stays on your device—no account, no tracking, 100% offline.
							</p>
						</div>
						<p class="intro-links">
							Learn more about <a href="/privacy">our privacy-first approach</a> or <a href="/download">download Intently today</a> to start building healthier digital habits.
						</p>
					</ScrollReveal>
				</div>
			</section>

			<!-- Core Features - Asymmetric Bento Grid -->
			<section class="bento-section">
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<h2 class="section-title">Core Features</h2>
					</ScrollReveal>

					<ScrollReveal animation="fadeUp">
						<div class="bento-grid">
							{features.map((feature, index) => (
								<div class={`bento-card ${index === 0 ? 'bento-hero-card' : index === 7 ? 'bento-privacy-card' : 'bento-standard'}`} style={`--card-delay: ${[0, 0, 100, 200, 0, 100, 0, 100][index]}ms`}>
									<div class="bento-feature-header">
										<div class={`bento-icon bento-icon-${feature.color}`}>
											<Icon name={feature.icon} size={index === 0 ? 32 : 24} color={colorMap[feature.color]} />
										</div>
										<h3>{feature.title}</h3>
									</div>
									<p class="bento-description">{feature.description}</p>
									<ul class="bento-details">
										{feature.details.map(detail => <li>{detail}</li>)}
									</ul>
								</div>
							))}
						</div>
					</ScrollReveal>
				</div>
			</section>

			<!-- How It Works - Glass Step Cards -->
			<section class="how-it-works">
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<h2 class="section-title">How Intently Works</h2>
					</ScrollReveal>

					<ScrollReveal animation="fadeUp">
					<div class="steps-timeline">
						<div class="timeline-step">
							<div class="step-number-wrapper">
								<div class="step-marker step-1">
									<span class="step-number">1</span>
								</div>
								<div class="timeline-connector"></div>
							</div>
							<div class="step-glass-card">
								<h3>Notice</h3>
								<p>Intently quietly observes which apps pull you in. Within a day, you'll see exactly where your time goes.</p>
							</div>
						</div>

						<div class="timeline-step">
							<div class="step-number-wrapper">
								<div class="step-marker step-2">
									<span class="step-number">2</span>
								</div>
								<div class="timeline-connector"></div>
							</div>
							<div class="step-glass-card">
								<h3>Pause</h3>
								<p>When you reach for a distracting app on autopilot, a gentle prompt appears. Not to scold you—to ask: 'Is this what you want right now?'</p>
							</div>
						</div>

						<div class="timeline-step">
							<div class="step-number-wrapper">
								<div class="step-marker step-3">
									<span class="step-number">3</span>
								</div>
							</div>
							<div class="step-glass-card">
								<h3>Transform</h3>
								<p>Small choices compound. After a week, the pull weakens. After a month, you reach for your phone less. After three months, people start asking what changed about you.</p>
							</div>
							</div>
					</div>
				</ScrollReveal>
				</div>
			</section>

			<!-- FAQ Section - Glass Cards -->
			<section class="faq-section">
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<h2 class="section-title">Frequently Asked Questions</h2>
					</ScrollReveal>

					<ScrollReveal animation="fadeUp">
						<div class="faq-list">
							{featureFAQs.map((faq) => (
								<details class="faq-glass-card">
									<summary>{faq.question}</summary>
									<p>{faq.answer}</p>
								</details>
							))}
						</div>
					</ScrollReveal>
				</div>
			</section>

			<!-- FAQ Schema -->
			<FAQSchema faqs={featureFAQs} />

			<!-- CTA Section - Enhanced -->
			<section class="cta-section">
				<div class="cta-divider" aria-hidden="true"></div>
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<div class="cta-glass">
							<h2>Ready to Take Back Control?</h2>
							<p>Join 12,000+ people who've transformed their relationship with their phone. One gentle pause at a time.</p>
							<div class="cta-buttons">
								<Button href="/download" variant="primary" size="lg">Download Now</Button>
								<Button href="/privacy" variant="secondary" size="lg">Learn About Privacy</Button>
							</div>
						</div>
					</ScrollReveal>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* ============================
	   HERO - Glass with gradient
	   ============================ */
	.features-hero {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: linear-gradient(180deg, var(--intently-bg-accent) 0%, var(--intently-bg-secondary) 100%);
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.features-hero::before {
		content: '';
		display: block;
		height: 7rem;
	}

	.hero-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 600px;
		height: 400px;
		background: radial-gradient(ellipse, rgba(33, 150, 243, 0.12) 0%, transparent 70%);
		filter: blur(60px);
		pointer-events: none;
	}

	.text-gradient {
		font-size: 2rem;
		font-weight: 800;
		margin: 0 0 var(--intently-space-md);
		letter-spacing: -0.02em;
		line-height: 1.2;
		background: linear-gradient(135deg, var(--intently-blue) 0%, var(--intently-purple) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		max-width: 700px;
		margin: 0 auto;
		color: var(--intently-text-secondary);
		line-height: 1.6;
	}

	@media (prefers-color-scheme: dark) {
		.hero-glow {
			background: radial-gradient(ellipse, rgba(66, 165, 245, 0.08) 0%, transparent 70%);
		}
	}

	/* ============================
	   INTRO SECTION - Glass card
	   ============================ */
	.intro-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
		text-align: center;
	}

	.intro-section h2 {
		font-size: 2rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-lg);
		color: var(--intently-text-primary);
	}

	.glass-intro-card {
		max-width: 800px;
		margin: 0 auto;
		padding: var(--intently-space-2xl);
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		border-radius: 24px;
	}

	.direct-answer {
		font-size: 1.125rem;
		line-height: 1.75;
		color: var(--intently-text-secondary);
		margin: 0;
	}

	.direct-answer strong {
		color: var(--intently-text-primary);
		font-weight: 600;
	}

	.intro-links {
		font-size: 1rem;
		max-width: 800px;
		margin: var(--intently-space-lg) auto 0;
		color: var(--intently-text-secondary);
	}

	.intro-links a {
		color: var(--intently-blue);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: var(--intently-transition-normal);
	}

	.intro-links a:hover {
		border-bottom-color: var(--intently-blue);
	}

	@media (prefers-color-scheme: dark) {
		.glass-intro-card {
			background: rgba(30, 30, 30, 0.75);
			border: 1px solid rgba(255, 255, 255, 0.12);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 4px 20px rgba(0, 0, 0, 0.4);
		}
	}

	/* ============================
	   BENTO SECTION - Asymmetric
	   ============================ */
	.bento-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
	}

	.section-title {
		font-size: 2rem;
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--intently-space-2xl);
		color: var(--intently-text-primary);
	}

	.bento-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		max-width: 1100px;
		margin: 0 auto;
	}

	/* Base glass card */
	.bento-card {
		position: relative;
		border-radius: 24px;
		overflow: hidden;
		padding: 1.5rem;
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@media (hover: hover) {
		.bento-card:hover {
			transform: scale(1.02);
		}

		.bento-card:hover .bento-icon::before {
			opacity: 0.25;
			transform: scale(1.3);
		}
	}

	@media (prefers-color-scheme: dark) {
		.bento-card {
			background: rgba(30, 30, 30, 0.75);
			border: 1px solid rgba(255, 255, 255, 0.12);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 4px 20px rgba(0, 0, 0, 0.4);
		}
	}

	/* Hero card: full width */
	.bento-hero-card {
		padding: 2rem;
	}

	.bento-hero-card h3 {
		font-size: 1.375rem;
	}

	/* Privacy card: wider */
	.bento-privacy-card {
		padding: 2rem;
	}

	/* Feature header with icon */
	.bento-feature-header {
		display: flex;
		align-items: flex-start;
		gap: var(--intently-space-md);
		margin-bottom: var(--intently-space-md);
	}

	/* Icon with glow */
	.bento-icon {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		flex-shrink: 0;
	}

	.bento-icon::before {
		content: '';
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		opacity: 0.15;
		transition: opacity 0.4s ease, transform 0.4s ease;
	}

	.bento-icon-blue::before { background: radial-gradient(circle, var(--intently-blue), transparent 70%); }
	.bento-icon-green::before { background: radial-gradient(circle, var(--intently-green), transparent 70%); }
	.bento-icon-purple::before { background: radial-gradient(circle, var(--intently-purple), transparent 70%); }
	.bento-icon-orange::before { background: radial-gradient(circle, var(--intently-orange), transparent 70%); }

	.bento-feature-header h3 {
		font-size: 1.125rem;
		font-weight: 700;
		margin: 0.5rem 0 0;
		color: var(--intently-text-primary);
		line-height: 1.3;
		letter-spacing: -0.01em;
	}

	.bento-description {
		color: var(--intently-text-secondary);
		line-height: 1.6;
		margin: 0 0 var(--intently-space-md);
		font-size: 0.9375rem;
	}

	.bento-details {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.bento-details li {
		padding: 0.25rem 0 0.25rem 1.25rem;
		position: relative;
		font-size: 0.875rem;
		color: var(--intently-text-secondary);
		line-height: 1.5;
	}

	.bento-details li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 6px;
		height: 6px;
		background: var(--intently-blue);
		border-radius: 50%;
	}

	/* ============================
	   HOW IT WORKS - Glass Steps
	   ============================ */
	.how-it-works {
		width: 100%;
		padding: var(--intently-space-2xl) 0 var(--intently-space-4xl);
		background: var(--intently-bg-primary);
	}

	.steps-timeline {
		max-width: 800px;
		margin: 0 auto;
	}

	.timeline-step {
		display: flex;
		gap: var(--intently-space-lg);
		margin-bottom: var(--intently-space-xl);
		align-items: flex-start;
	}

	.timeline-step:last-child {
		margin-bottom: 0;
	}

	.step-number-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		position: relative;
		flex-shrink: 0;
	}

	.step-marker {
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 2;
	}

	.step-marker.step-1 { background: var(--intently-blue); }
	.step-marker.step-2 { background: var(--intently-purple); }
	.step-marker.step-3 { background: var(--intently-green); }

	.step-number {
		color: white;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.timeline-connector {
		width: 3px;
		height: calc(100% + var(--intently-space-xl) - 48px);
		background: linear-gradient(180deg, var(--intently-blue) 0%, var(--intently-purple) 50%, var(--intently-green) 100%);
		position: absolute;
		top: 48px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1;
		border-radius: 2px;
		opacity: 0.4;
	}

	/* Glass card for step content */
	.step-glass-card {
		flex: 1;
		padding: var(--intently-space-lg) var(--intently-space-xl);
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		border-radius: 24px;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@media (hover: hover) {
		.step-glass-card:hover {
			transform: scale(1.02);
		}
	}

	@media (prefers-color-scheme: dark) {
		.step-glass-card {
			background: rgba(30, 30, 30, 0.75);
			border: 1px solid rgba(255, 255, 255, 0.12);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 4px 20px rgba(0, 0, 0, 0.4);
		}
	}

	.step-glass-card h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-sm);
		color: var(--intently-text-primary);
	}

	.step-glass-card p {
		color: var(--intently-text-secondary);
		line-height: 1.6;
		margin: 0;
		font-size: 0.9375rem;
	}

	/* ============================
	   FAQ SECTION - Glass Cards
	   ============================ */
	.faq-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: var(--intently-space-md);
		max-width: 900px;
		margin: 0 auto;
	}

	.faq-glass-card {
		padding: 0;
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		border-radius: 16px;
		transition: all 0.3s ease;
	}

	.faq-glass-card[open] {
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 8px 30px rgba(0, 0, 0, 0.08);
	}

	@media (prefers-color-scheme: dark) {
		.faq-glass-card {
			background: rgba(30, 30, 30, 0.75);
