---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import { SITE_TITLE } from '../consts';

const features = [
	{
		icon: "📊",
		title: "Smart Usage Tracking",
		description: "Automatically track how much time you spend in different apps. See detailed breakdowns of your daily, weekly, and monthly usage patterns.",
		details: ["Daily time summaries", "Per-app usage breakdown", "Weekly and monthly trends", "Category-based grouping"],
		color: "blue"
	},
	{
		icon: "🎯",
		title: "Daily Goals & Limits",
		description: "Set personalized daily time limits for your most distracting apps. Visual progress indicators show how you're doing throughout the day.",
		details: ["Custom time limits per app", "Visual progress rings", "Goal achievement celebrations", "Flexible limit adjustments"],
		color: "green"
	},
	{
		icon: "🔔",
		title: "Mindful Interventions",
		description: "Gentle, full-screen reminders when you open tracked apps. Take a breath and decide if you really want to scroll or do something more meaningful.",
		details: ["Customizable reminder messages", "Timer-based interventions", "Multiple intervention types", "Reflection prompts"],
		color: "purple"
	},
	{
		icon: "🏆",
		title: "Gamification & Streaks",
		description: "Build momentum with streak tracking and achievements. Celebrate milestones as you develop healthier digital habits.",
		details: ["Daily streak tracking", "Milestone celebrations", "Achievement badges", "Streak recovery options"],
		color: "orange"
	},
	{
		icon: "📈",
		title: "Analytics Dashboard",
		description: "Understand your digital habits with beautiful charts and insights. See patterns, improvements, and areas for growth.",
		details: ["Usage trend charts", "Baseline comparisons", "Improvement metrics", "Exportable reports"],
		color: "blue"
	},
	{
		icon: "🧘",
		title: "Reflection Mode",
		description: "Take mindful pauses before accessing apps. Custom prompts help you reflect on your intentions and make conscious choices.",
		details: ["Custom reflection prompts", "Breathing exercises", "Intention setting", "Usage journaling"],
		color: "green"
	},
	{
		icon: "📱",
		title: "Widgets & Quick Access",
		description: "Check your progress at a glance with beautiful home screen widgets. Quick access to settings and stats.",
		details: ["Home screen widgets", "Quick settings toggle", "One-tap stats view", "Notification center integration"],
		color: "purple"
	},
	{
		icon: "🔒",
		title: "Privacy-First Design",
		description: "Your data never leaves your device. No cloud sync, no analytics, no account required. Complete privacy guaranteed.",
		details: ["100% offline functionality", "Local data storage only", "No account required", "No tracking or analytics"],
		color: "green"
	}
];

const featureFAQs = [
	{
		question: "How does Intently track app usage?",
		answer: "Intently runs locally on your device, monitoring which apps you use and how long you spend in each one. All data stays on your phone - we never collect or send anything to our servers. This approach gives you complete privacy while providing accurate usage insights."
	},
	{
		question: "Is Intently better than other screen time apps?",
		answer: "Unlike blocking-based solutions that use shame and restriction, Intently uses psychology-backed mindful interventions. Instead of preventing app access, we create moments of awareness so you can make conscious choices about your time. Studies show this compassionate approach leads to more lasting behavior change."
	},
	{
		question: "Does Intently work offline?",
		answer: "Yes, Intently is 100% offline-first. All tracking, analytics, and interventions happen on your device. You don't need an account, internet connection, or cloud sync. Your data belongs entirely to you."
	},
	{
		question: "Can I use Intently on multiple devices?",
		answer: "Intently works independently on each device (Android, iOS, Chrome). Currently, data doesn't sync between devices, keeping everything local and private. Each device maintains its own usage history and settings."
	},
	{
		question: "What makes Intently privacy-first?",
		answer: "Intently stores zero data in the cloud. No servers, no analytics, no advertising networks, no tracking. You don't need to create an account. We make money through optional premium features on-device, not through selling your data."
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Features - ${SITE_TITLE}`} description="Explore Intently's features: smart usage tracking, mindful interventions, gamification, and privacy-first design." />
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "Features", url: "https://liveintently.app/features" }
			]}
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- Features Hero -->
			<section class="features-hero">
				<div class="container">
					<h1>Features That Build Better Habits</h1>
					<p class="hero-subtitle">Intently combines psychology and design to help you develop a healthier relationship with technology.</p>
				</div>
			</section>

			<!-- What is Intently - Featured Snippet Optimization -->
			<section class="intro-section">
				<div class="container">
					<h2>What is Intently?</h2>
					<p class="direct-answer">
						Intently is a <strong>privacy-first digital wellbeing app</strong> that helps you build healthier relationships with technology. Instead of blocking apps, it uses <strong>mindful interventions</strong> to create moments of awareness, helping you make conscious choices about screen time. All data stays on your device—no account, no tracking, 100% offline.
					</p>
					<p class="intro-links">
						Learn more about <a href="/privacy">our privacy-first approach</a> or <a href="/download">download Intently today</a> to start building healthier digital habits.
					</p>
				</div>
			</section>

			<!-- Core Features Grid -->
			<section class="features-grid-section">
				<div class="container">
					<h2 class="section-title">Core Features</h2>
					<div class="features-grid">
						{features.map(feature => (
							<Card variant="elevated" hover={true}>
								<div class="feature-header">
								<div class={`feature-icon-wrapper ${feature.color}`}>
								<span class="feature-icon">{feature.icon}</span>
							</div>
									<h3>{feature.title}</h3>
								</div>
								<p class="feature-description">{feature.description}</p>
								<ul class="feature-details">
									{feature.details.map(detail => <li>{detail}</li>)}
								</ul>
							</Card>
						))}
					</div>
				</div>
			</section>

			<!-- How It Works -->
			<section class="how-it-works">
				<div class="container">
					<h2 class="section-title">How Intently Works</h2>
					<div class="steps-timeline">
					<div class="timeline-step">
						<div class="step-number-wrapper">
							<div class="step-marker step-1">
								<span class="step-number">1</span>
							</div>
							<div class="timeline-connector"></div>
						</div>
						<div class="step-content">
							<h3>Track Your Usage</h3>
							<p>Intently runs quietly in the background, automatically tracking which apps you use and for how long. Get detailed insights without lifting a finger.</p>
						</div>
					</div>
					<div class="timeline-step">
						<div class="step-number-wrapper">
							<div class="step-marker step-2">
								<span class="step-number">2</span>
							</div>
							<div class="timeline-connector"></div>
						</div>
						<div class="step-content">
							<h3>Receive Gentle Reminders</h3>
							<p>When you approach your limit or open a tracked app, gentle full-screen reminders prompt mindful reflection. Take a breath and make a conscious choice.</p>
						</div>
					</div>
					<div class="timeline-step">
						<div class="step-number-wrapper">
							<div class="step-marker step-3">
								<span class="step-number">3</span>
							</div>
						</div>
						<div class="step-content">
							<h3>Transform Your Habits</h3>
							<p>Over time, these mindful moments add up to lasting habit change. Build a healthier relationship with technology, one choice at a time.</p>
						</div>
					</div>
				</div>
		</section>

		<!-- FAQ Section -->
		<section class="faq-section">
			<div class="container">
				<h2 class="section-title">Frequently Asked Questions</h2>
				<div class="faq-grid">
					{featureFAQs.map((faq) => (
						<div class="faq-item">
							<h3>{faq.question}</h3>
							<p>{faq.answer}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- FAQ Schema -->
		<FAQSchema faqs={featureFAQs} />

		<!-- CTA Section -->
		<section class="cta-section">
			<div class="container">
					<div class="cta-content">
						<h2>Ready to Build Healthier Habits?</h2>
						<p>Join thousands of users who have transformed their relationship with technology using Intently.</p>
						<div class="cta-buttons">
							<Button href="/download" variant="primary" size="lg">Download Now</Button>
							<Button href="/privacy" variant="secondary" size="lg">Learn About Privacy</Button>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	.features-hero {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: linear-gradient(135deg, var(--intently-blue) 0%, #00BCD4 100%);
		text-align: center;
	}

	.features-hero h1 {
		font-size: 2rem;
		font-weight: 800;
		margin: 0 0 var(--intently-space-md);
		color: white;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		max-width: 700px;
		margin: 0 auto;
		color: white;
		opacity: 0.95;
		line-height: 1.6;
	}

	/* What is Intently Section - Featured Snippet Optimization */
	.intro-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
		text-align: center;
	}

	.intro-section h2 {
		font-size: 2rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-lg);
		color: var(--intently-text-primary);
	}

	.direct-answer {
		font-size: 1.125rem;
		line-height: 1.75;
		max-width: 800px;
		margin: 0 auto;
		color: var(--intently-text-secondary);
		padding: var(--intently-space-xl);
		background: white;
		border-radius: var(--intently-radius-lg);
		border-left: 4px solid var(--intently-blue);
		box-shadow: var(--intently-shadow-sm);
	}

	.direct-answer strong {
		color: var(--intently-text-primary);
		font-weight: 600;
	}

	.intro-links {
		font-size: 1rem;
		max-width: 800px;
		margin: var(--intently-space-lg) auto 0;
		color: var(--intently-text-secondary);
	}

	.intro-links a {
		color: var(--intently-blue);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: var(--intently-transition-normal);
	}

	.intro-links a:hover {
		border-bottom-color: var(--intently-blue);
	}

	.features-grid-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-primary);
	}

	.section-title {
		font-size: 2rem;
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--intently-space-2xl);
		color: var(--intently-text-primary);
	}

	.features-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-lg);
	}

	.feature-header {
		display: flex;
		align-items: flex-start;
		gap: var(--intently-space-md);
		margin-bottom: var(--intently-space-lg);
	}

	.feature-icon-wrapper {
		width: 48px;
		height: 48px;
		border-radius: var(--intently-radius-md);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.feature-icon-wrapper.blue {
		background: rgba(33, 150, 243, 0.08);
	}

	.feature-icon-wrapper.green {
		background: rgba(76, 175, 80, 0.08);
	}

	.feature-icon-wrapper.purple {
		background: rgba(156, 39, 176, 0.08);
	}

	.feature-icon-wrapper.orange {
		background: rgba(255, 152, 0, 0.08);
	}

	.feature-icon {
		font-size: 1.5rem;
		line-height: 1;
	}

	.feature-header h3 {
		font-size: 1.125rem;
		font-weight: 700;
		margin: 0.125rem 0 0;
		color: var(--intently-text-primary);
		line-height: 1.4;
	}

	.feature-description {
		color: var(--intently-text-secondary);
		line-height: 1.6;
		margin: 0 0 var(--intently-space-md);
		font-size: 0.9375rem;
	}

	.feature-details {
		list-style: none;
		padding: 0 1rem;
		margin: 0;
	}

	.feature-details li {
		padding: 0.25rem 0 0.25rem 1.25rem;
		position: relative;
		font-size: 0.875rem;
		color: var(--intently-text-secondary);
		line-height: 1.5;
	}

	.feature-details li::before {
		content: "•";
		position: absolute;
		left: 0;
		color: var(--intently-blue);
		font-weight: 700;
	}

	/* How It Works */
	.how-it-works {
		width: 100%;
		padding: var(--intently-space-2xl) 0 var(--intently-space-4xl);
		background: var(--intently-bg-secondary);
	}

	.steps-timeline {
		max-width: 1000px;
		margin: 0 auto;
	}

	.timeline-step {
		display: flex;
		gap: var(--intently-space-lg);
		margin-bottom: var(--intently-space-xl);
		align-items: flex-start;
	}

	.timeline-step:last-child {
		margin-bottom: 0;
	}

	.step-number-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		position: relative;
		flex-shrink: 0;
	}

	.step-marker {
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 2;
	}

	.step-marker.step-1 {
		background: var(--intently-blue);
	}

	.step-marker.step-2 {
		background: var(--intently-purple);
	}

	.step-marker.step-3 {
		background: var(--intently-green);
	}

	.step-number {
		color: white;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.timeline-connector {
		width: 2px;
		height: calc(100% + var(--intently-space-xl) - 48px);
		background: var(--intently-gray-300);
		position: absolute;
		top: 48px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1;
	}

	.step-content {
		flex: 1;
	}

	.step-content h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-sm);
		color: var(--intently-text-primary);
	}

	.step-content p {
		color: var(--intently-text-secondary);
		line-height: 1.6;
		margin: 0;
		font-size: 0.9375rem;
	}

	/* FAQ Section */
	.faq-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
	}

	.faq-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-lg);
		margin-top: var(--intently-space-xl);
	}

	.faq-item {
		background: white;
		padding: var(--intently-space-xl);
		border-radius: var(--intently-radius-lg);
		border-left: 4px solid var(--intently-blue);
	}

	.faq-item h3 {
		font-size: 1.125rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-md);
		color: var(--intently-text-primary);
	}

	.faq-item p {
		margin: 0;
		color: var(--intently-text-secondary);
		line-height: 1.6;
		font-size: 0.9375rem;
	}

	/* CTA Section */
	.cta-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-primary);
		text-align: center;
	}

	.cta-content h2 {
		font-size: 2.5rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-md);
		color: var(--intently-text-primary);
	}

	.cta-content p {
		font-size: 1.125rem;
		color: var(--intently-text-secondary);
		max-width: 600px;
		margin: 0 auto var(--intently-space-xl);
	}

	.cta-buttons {
		display: flex;
		gap: var(--intently-space-md);
		justify-content: center;
		flex-wrap: wrap;
	}

	.container {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* Responsive - Mobile First */
	/* Tablet: more spacing and larger grids */
	@media (min-width: 768px) {
		.features-hero,
		.features-grid-section,
		.faq-section,
		.cta-section {
			padding: var(--intently-space-3xl) 0;
		}

		.features-hero h1 {
			font-size: 2.5rem;
		}

		.intro-section h2 {
			font-size: 1.75rem;
		}

		.section-title {
			font-size: 1.75rem;
		}

		.features-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--intently-space-xl);
		}

		.faq-grid {
			grid-template-columns: 1fr;
		}

		.cta-content h2 {
			font-size: 2rem;
		}

		.timeline-step {
			gap: var(--intently-space-md);
		}
	}

	/* Desktop: even more spacing and larger grids */
	@media (min-width: 1024px) {
		.features-hero,
		.features-grid-section,
		.faq-section,
		.cta-section {
			padding: var(--intently-space-4xl) 0;
		}

		.features-hero h1 {
			font-size: 3.5rem;
		}

		.intro-section h2 {
			font-size: 2rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.features-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.faq-grid {
			grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		}

		.cta-content h2 {
			font-size: 2.5rem;
		}
	}

	/* Mobile: optimize small screens */
	@media (max-width: 767px) {
		.hero-subtitle {
			font-size: 1rem;
		}

		.intro-section h2 {
			font-size: 1.5rem;
		}

		.direct-answer {
			font-size: 1rem;
			padding: var(--intently-space-lg);
		}

		.intro-links {
			font-size: 0.9375rem;
		}

		.cta-buttons {
			flex-direction: column;
		}

		.timeline-connector {
			display: none;
		}
	}

	html {
		scroll-behavior: smooth;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--intently-blue);
		outline-offset: 2px;
	}
</style>
