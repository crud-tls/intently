---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Privacy Policy (Chrome Extension) - ${SITE_TITLE}`} description="Privacy Policy for Intently Chrome Extension - Digital wellbeing browser extension for building healthier browsing habits" />
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "Privacy Policy (Chrome)", url: "https://liveintently.app/privacy-chrome" }
			]}
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- Privacy Hero -->
			<section class="privacy-hero">
				<div class="container">
					<h1>Privacy Policy for Intently (Chrome Extension)</h1>
					<p class="updated"><strong>Last Updated:</strong> January 23, 2026</p>
				</div>
			</section>

			<!-- Privacy Content -->
			<section class="privacy-content">
				<div class="container">
					<div class="content-wrapper">
						<h2>Introduction</h2>
						<p>Intently is a Chrome browser extension designed to help you build healthier browsing habits through mindful interventions and usage tracking. This privacy policy explains how the extension collects, uses, and protects your information.</p>

						<h2>Developer Information</h2>
						<p><strong>Extension Name:</strong> Intently - Intentful Browsing<br>
						<strong>Version:</strong> 1.1.0<br>
						<strong>Developer:</strong> Intently Team<br>
						<strong>Contact Email:</strong> <a href="mailto:info@liveintently.app">info@liveintently.app</a><br>
						<strong>Chrome Web Store:</strong> <a href="https://chromewebstore.google.com/detail/intently-intentful-browsi/acjndeeecacgplloeefjjhlnlpgnonop" target="_blank" rel="noopener noreferrer">Extension Page</a></p>

						<h2>Our Commitment to Privacy</h2>
						<div class="highlight">
							<p><strong>Intently is built with privacy as a core principle. Your data stays local on your device by default. Cloud sync is completely optional - the extension works fully without an account. We do not sell, share, or use your data for advertising.</strong></p>
						</div>

						<h2>Chrome Extension Permissions Explained</h2>
						<p>Chrome displays permission warnings when you install extensions. Here's exactly what each permission does and why we need it:</p>

						<h3>1. "Read your browsing history" (tabs permission)</h3>
						<div class="permission-box">
							<p><strong>Chrome Warning:</strong> "Read your browsing history"</p>
							<p><strong>Why We Need It:</strong> To track time spent on websites you choose to monitor</p>
							<p><strong>What We Actually Access:</strong> Only the current active tab's URL and title - NOT your full browsing history</p>
							<p><strong>What We DON'T Access:</strong> Past browsing history, browsing from other tabs, incognito browsing, passwords, or form data</p>
							<p><strong>Your Control:</strong> You choose which websites to track. We only monitor sites you explicitly add to your tracking list.</p>
						</div>

						<h3>2. "Display notifications" (notifications permission)</h3>
						<div class="permission-box">
							<p><strong>Chrome Warning:</strong> "Display notifications"</p>
							<p><strong>Why We Need It:</strong> To show optional usage alerts and goal reminders</p>
							<p><strong>Your Control:</strong> Notifications are optional and can be completely disabled in extension settings</p>
						</div>

						<h3>3. "Know your email address" (identity permission)</h3>
						<div class="permission-box">
							<p><strong>Chrome Warning:</strong> "Know your email address"</p>
							<p><strong>Why We Need It:</strong> For optional Google Sign-In to enable cloud sync</p>
							<p><strong>Important:</strong> This permission is ONLY used when you explicitly click "Sign in with Google"</p>
							<p><strong>Your Control:</strong> Completely optional - the extension works fully offline without signing in</p>
						</div>

						<h3>4. "Read and change all your data on all websites" (host_permissions: &lt;all_urls&gt;)</h3>
						<div class="warning">
							<p><strong>⚠️ Chrome Warning:</strong> "Read and change all your data on all websites"</p>
							<p><strong>Why This Warning Appears:</strong> Chrome shows this scary warning for ANY extension that can display content on web pages</p>
							<p><strong>What We Actually Do:</strong></p>
							<ul>
								<li>Display intervention overlays ONLY on websites you configure for tracking</li>
								<li>Detect when you visit a tracked website to start/stop timers</li>
								<li>Show mindfulness prompts when you open distracting sites</li>
							</ul>
							<p><strong>What We DON'T Do:</strong></p>
							<ul class="no-collect">
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> We do NOT read website content</strong> (no passwords, form data, or personal information)</li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> We do NOT modify websites</strong> (except showing our own intervention screens)</li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> We do NOT track all your browsing</strong> (only user-configured sites)</li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> We do NOT inject ads or change search results</strong></li>
							</ul>
							<p><strong>Your Control:</strong> You choose which websites to track. We ONLY interact with sites on your tracking list.</p>
						</div>

						<h3>5. Other Permissions (No Chrome Warnings)</h3>
						<div class="toggle-info">
							<p><strong>storage</strong> - Save your goals and statistics locally in Chrome's secure storage</p>
							<p><strong>alarms</strong> - Schedule periodic tracking checks for accurate time monitoring</p>
							<p><strong>idle</strong> - Detect when you're away from computer to pause tracking (more accurate statistics)</p>
							<p><strong>activeTab</strong> - Detect when you visit a tracked website (no access to other tabs)</p>
							<p><strong>contextMenus</strong> - Add right-click menu option to snooze interventions</p>
						</div>

						<h2>Information We Collect</h2>

						<h3>Local Storage (Always Active - Stored on Your Device)</h3>
						<p>The following data is stored <strong>locally on your device</strong> using Chrome's storage API and never leaves your computer unless you enable cloud sync:</p>
						<ul>
							<li><strong>Website URLs:</strong> Only for sites you choose to track</li>
							<li><strong>Time Tracking:</strong> Time spent on tracked websites</li>
							<li><strong>Daily Usage Statistics:</strong> Aggregated daily usage data</li>
							<li><strong>Goals and Limits:</strong> Daily time limits you set for yourself</li>
							<li><strong>Settings and Preferences:</strong> Extension configuration</li>
							<li><strong>Session History:</strong> Last 100 browsing sessions (automatically cleaned up)</li>
							<li><strong>Intervention Interactions:</strong> How you respond to mindfulness prompts</li>
							<li><strong>Streaks and Achievements:</strong> Progress toward your goals</li>
						</ul>

						<h3>Cloud Sync (Optional - User Must Enable)</h3>
						<p>Cloud sync is <strong>completely optional</strong>. The extension works fully offline. If you choose to sign in with Google:</p>
						<ul class="collect">
							<li><strong>Email Address:</strong> Used for authentication only</li>
							<li><strong>Synced Data:</strong> Goals, statistics, settings, session history (encrypted)</li>
							<li><strong>Authentication Tokens:</strong> Securely stored to maintain your session (7-day expiration)</li>
						</ul>

						<h3>What We DON'T Collect</h3>
						<div class="success">
							<ul class="no-collect">
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> Full browsing history</strong> (only user-configured tracked sites)</li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> Website content, passwords, or form data</strong></li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> Search queries or downloads</strong></li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> Bookmarks or saved passwords</strong></li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> Browsing from other tabs or windows</strong></li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> Incognito/private browsing activity</strong></li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> Personal information without explicit consent</strong></li>
								<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> Credit card or payment information</strong></li>
							</ul>
						</div>

						<h2>How We Use Your Information</h2>

						<h3>Local Data Usage (No Internet Required)</h3>
						<p>Your locally stored data is used exclusively to:</p>
						<ul>
							<li><strong>Track Progress:</strong> Monitor time spent on websites you choose to track</li>
							<li><strong>Display Statistics:</strong> Show personalized usage insights and charts</li>
							<li><strong>Show Interventions:</strong> Determine when to display mindfulness prompts</li>
							<li><strong>Save Preferences:</strong> Remember your settings and goals</li>
							<li><strong>Calculate Streaks:</strong> Track achievements and goal progress</li>
						</ul>

						<h3>Cloud Sync Data (If Enabled)</h3>
						<ul>
							<li><strong>Backup:</strong> Securely backup your data</li>
							<li><strong>Multi-Device Sync:</strong> Access your goals and stats across devices</li>
							<li><strong>Restore Data:</strong> Recover data if you reinstall the extension</li>
						</ul>

						<h2>Third-Party Services</h2>

						<h3>What We DON'T Do</h3>
						<div class="highlight">
							<p><strong>We do not share, sell, or rent your personal data to third parties. Ever.</strong></p>
						</div>
						<ul class="no-collect">
							<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> No data selling to advertisers</strong></li>
							<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> No marketing partners</strong></li>
							<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> No data brokers</strong></li>
							<li><strong><Icon name="X" size={16} color="var(--intently-red)" /> No third-party analytics on your browsing</strong></li>
						</ul>

						<h3>Third-Party Services We Use (When You Opt-In)</h3>

						<h4>Supabase (Optional - Cloud Sync Only)</h4>
						<ul class="collect">
							<li><strong>Purpose:</strong> Database and authentication for cloud sync</li>
							<li><strong>Data Shared:</strong> Goals, statistics, settings, email (only when signed in)</li>
							<li><strong>Privacy Policy:</strong> <a href="https://supabase.com/privacy" target="_blank" rel="noopener noreferrer">https://supabase.com/privacy</a></li>
							<li><strong>Data Location:</strong> United States</li>
							<li><strong>Encryption:</strong> All data transmitted via HTTPS, encrypted at rest</li>
							<li><strong>Your Control:</strong> Sign out anytime to stop sync</li>
						</ul>

						<h4>Google OAuth (Optional - Sign-In Only)</h4>
						<ul class="collect">
							<li><strong>Purpose:</strong> Secure authentication for cloud sync</li>
							<li><strong>Data Shared:</strong> Email address, authentication tokens</li>
							<li><strong>Privacy Policy:</strong> <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">https://policies.google.com/privacy</a></li>
							<li><strong>Use:</strong> Only when you click "Sign in with Google"</li>
							<li><strong>Security:</strong> OAuth 2.0 industry standard</li>
						</ul>

						<h4>Firebase Analytics (Optional - Anonymous)</h4>
						<div class="toggle-info">
							<p><strong>Purpose:</strong> Anonymous usage analytics to improve extension features</p>
							<p><strong>Data Collected:</strong> Installation events, feature usage counts (no personal data)</p>
							<p><strong>Privacy Policy:</strong> <a href="https://firebase.google.com/support/privacy" target="_blank" rel="noopener noreferrer">https://firebase.google.com/support/privacy</a></p>
							<p><strong>Identifiable Data:</strong> None - all analytics are completely anonymous</p>
							<p><strong>Your Control:</strong> Can be disabled in extension settings</p>
						</div>

						<h2>Data Storage and Security</h2>

						<h3>Local Storage</h3>
						<ul>
							<li><strong>Chrome Storage API:</strong> All local data stored using Chrome's secure storage API</li>
							<li><strong>Encryption:</strong> Chrome automatically encrypts extension storage</li>
							<li><strong>Access Control:</strong> Only this extension can access its own storage</li>
							<li><strong>Location:</strong> Stored locally on your device</li>
						</ul>

						<h3>Cloud Storage (Optional)</h3>
						<ul>
							<li><strong>HTTPS Encryption:</strong> All cloud communications encrypted in transit</li>
							<li><strong>Database Encryption:</strong> Data encrypted at rest in Supabase</li>
							<li><strong>Authentication:</strong> OAuth 2.0 secure authentication</li>
							<li><strong>Token Storage:</strong> Securely stored using Chrome's secure storage</li>
							<li><strong>Access Control:</strong> Only you can access your synced data</li>
						</ul>

						<h3>Security Measures</h3>
						<ul>
							<li>🔒 <strong>HTTPS Only:</strong> All cloud communication encrypted</li>
							<li>🔐 <strong>Content Security Policy:</strong> Manifest V3 security standards</li>
							<li>🛡️ <strong>Minimal Permissions:</strong> Only request necessary permissions</li>
							<li>✅ <strong>Regular Updates:</strong> Security patches and improvements</li>
						</ul>

						<h2>Data Retention</h2>

						<h3>Local Data</h3>
						<ul>
							<li><strong>Session History:</strong> Last 100 sessions stored (older sessions automatically deleted)</li>
							<li><strong>Statistics:</strong> Stored indefinitely until you clear data or uninstall</li>
							<li><strong>Manual Deletion:</strong> Clear all data anytime from Settings → Advanced → Clear All Data</li>
							<li><strong>Uninstall:</strong> All local data permanently deleted when extension is uninstalled</li>
						</ul>

						<h3>Cloud Data (If Sync Enabled)</h3>
						<ul>
							<li><strong>Active Account:</strong> Data stored until you delete your account</li>
							<li><strong>Sign Out:</strong> Data remains in cloud but extension stops syncing</li>
							<li><strong>Account Deletion:</strong> Permanently delete all cloud data from extension settings</li>
							<li><strong>Session Expiration:</strong> Authentication sessions expire after 7 days of inactivity</li>
						</ul>

						<h3>Analytics Data</h3>
						<ul>
							<li>Anonymous analytics follow Firebase retention policies</li>
							<li>No personally identifiable information collected</li>
						</ul>

						<h2>Your Rights and Control</h2>

						<h3>You Have Full Control</h3>
						<ul>
							<li>✅ <strong>Use Completely Offline:</strong> No account required for core functionality</li>
							<li>✅ <strong>View All Data:</strong> See collected statistics in the Statistics tab</li>
							<li>✅ <strong>Choose What to Track:</strong> Only track websites you explicitly add</li>
							<li>✅ <strong>Pause Tracking:</strong> Disable monitoring anytime</li>
							<li>✅ <strong>Delete Local Data:</strong> Clear all data from Settings → Advanced</li>
							<li>✅ <strong>Optional Cloud Sync:</strong> Sign in only if you want backup/sync</li>
							<li>✅ <strong>Sign Out Anytime:</strong> Stop cloud sync immediately</li>
							<li>✅ <strong>Delete Cloud Data:</strong> Remove all synced data permanently</li>
							<li>✅ <strong>Disable Notifications:</strong> Turn off all alerts in settings</li>
							<li>✅ <strong>Export Data:</strong> Available in extension (coming soon)</li>
						</ul>

						<h3>Your Legal Rights (GDPR, CCPA, etc.)</h3>
						<p>Depending on your location, you may have these rights:</p>
						<ul>
							<li><strong>Right to Access:</strong> View all data through Statistics tab</li>
							<li><strong>Right to Delete:</strong> Clear all local and cloud data anytime</li>
							<li><strong>Right to Portability:</strong> Export your data in readable format</li>
							<li><strong>Right to Rectification:</strong> Modify goals and settings in extension</li>
							<li><strong>Right to Object:</strong> Disable tracking, analytics, or cloud sync</li>
							<li><strong>Right to Opt-Out:</strong> Don't sign in, disable notifications and analytics</li>
						</ul>
						<p>To exercise these rights, use the built-in data management features in Settings or contact us at <a href="mailto:info@liveintently.app">info@liveintently.app</a>.</p>

						<h2>Children's Privacy</h2>
						<p>Intently is not directed at children under 13 years of age. We do not knowingly collect personal information from children. The extension does not contain age-restricted content. If you believe a child has provided us with personal information, please contact us immediately at <a href="mailto:info@liveintently.app">info@liveintently.app</a>.</p>
						<p><strong>COPPA Compliance:</strong> This extension complies with the Children's Online Privacy Protection Act (COPPA).</p>

						<h2>International Data Transfers</h2>
						<p>If you use cloud sync, your data may be stored on Supabase servers in the United States. We ensure adequate safeguards for international data transfers:</p>
						<ul>
							<li><strong>EU Users:</strong> Data transfers comply with GDPR requirements</li>
							<li><strong>Encryption:</strong> All data encrypted in transit and at rest</li>
							<li><strong>Your Control:</strong> Cloud sync is completely optional</li>
						</ul>

						<h2>Changes to This Privacy Policy</h2>
						<p>We may update this privacy policy from time to time to reflect changes in our practices or legal requirements. When we make significant changes:</p>
						<ul>
							<li>We'll update the "Last Updated" date at the top of this policy</li>
							<li>We'll announce changes in extension release notes</li>
							<li>Significant changes will be announced via extension notification</li>
							<li>Continued use after changes constitutes acceptance of the updated policy</li>
						</ul>
						<p><strong>Previous Versions:</strong> Available at <a href="https://github.com/Fa-d/intently-extension/commits/main/PRIVACY.md" target="_blank" rel="noopener noreferrer">GitHub commits history</a></p>

						<h2>Data Breach Notification</h2>
						<p>In the unlikely event of a data breach affecting your personal information, we will:</p>
						<ul>
							<li>Notify affected users within 72 hours</li>
							<li>Describe the nature and scope of the breach</li>
							<li>Provide steps to protect yourself</li>
							<li>Report to relevant authorities as required by law (GDPR, state laws)</li>
						</ul>

						<h2>Contact Information</h2>
						<p>Questions, concerns, or requests about your privacy?</p>
						<p><strong>Email:</strong> <a href="mailto:info@liveintently.app">info@liveintently.app</a><br>
						<strong>Response Time:</strong> We aim to respond within 48 hours</p>

						<h2>Compliance</h2>
						<p>This privacy policy complies with:</p>
						<ul>
							<li>✅ <strong>Chrome Web Store Developer Program Policies</strong></li>
							<li>✅ <strong>General Data Protection Regulation (GDPR)</strong> - European Union</li>
							<li>✅ <strong>California Consumer Privacy Act (CCPA)</strong> - California</li>
							<li>✅ <strong>Children's Online Privacy Protection Act (COPPA)</strong></li>
							<li>✅ <strong>Google OAuth 2.0 Policies</strong></li>
							<li>✅ <strong>Chrome Extension Manifest V3 Security Standards</strong></li>
						</ul>

						<h2>Limited Use Disclosure</h2>
						<p>Intently's use and transfer of information received from Google APIs adheres to <a href="https://developers.google.com/terms/api-services-user-data-policy" target="_blank" rel="noopener noreferrer">Google API Services User Data Policy</a>, including the Limited Use requirements.</p>
						<p>We only use Google Sign-In for authentication purposes and do not share Google user data with third parties.</p>

						<h2>Disclaimer</h2>
						<p>This extension is provided "as is" without warranties of any kind. We are not responsible for:</p>
						<ul>
							<li>Third-party website content or privacy practices</li>
							<li>Data loss due to browser issues or user error</li>
							<li>Unauthorized access due to compromised device security</li>
						</ul>

						<hr>

						<h2>Summary (TL;DR)</h2>
						<div class="highlight">
							<p><strong>Privacy-First Approach:</strong></p>
							<ul>
								<li>📱 <strong>Works Offline:</strong> No account required, all data stays local by default</li>
								<li>🔒 <strong>No Data Selling:</strong> We never sell, share, or use your data for advertising</li>
								<li>☁️ <strong>Optional Sync:</strong> Cloud backup only if you choose to sign in with Google</li>
								<li>🛡️ <strong>Minimal Tracking:</strong> Only monitors websites YOU choose to track</li>
								<li>🔐 <strong>Secure:</strong> Industry-standard encryption and security practices</li>
								<li>✅ <strong>Your Control:</strong> Delete your data anytime, disable any feature</li>
								<li>⚖️ <strong>Compliant:</strong> Meets GDPR, CCPA, COPPA, and Chrome Web Store policies</li>
							</ul>
						</div>

						<p class="back-links">
							<a href="/privacy-policy-chrome.html">Standalone HTML Version</a> |
							<a href="/download">Download Extension</a> |
							<a href="/">Back to Home</a>
						</p>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	.privacy-hero {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: linear-gradient(135deg, var(--intently-blue) 0%, #00BCD4 100%);
		color: white;
		text-align: center;
	}

	.privacy-hero::before {
		content: '';
		display: block;
		height: 7rem;
	}

	.privacy-hero h1 {
		font-size: 2rem;
		font-weight: 800;
		margin: 0 0 var(--intently-space-md);
		color: white;
		line-height: 1.2;
	}

	.updated {
		font-size: 0.875rem;
		max-width: 700px;
		margin: 0 auto;
		opacity: 0.9;
		font-style: italic;
	}

	.privacy-content {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-primary);
	}

	.content-wrapper {
		max-width: 800px;
		margin: 0 auto;
		background: var(--intently-bg-primary);
		padding: var(--intently-space-2xl);
		border-radius: var(--intently-radius-lg);
		box-shadow: var(--intently-shadow-md);
	}

	.content-wrapper h2 {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--intently-text-primary);
		margin: var(--intently-space-xl) 0 var(--intently-space-md);
		border-bottom: 2px solid var(--intently-blue);
		padding-bottom: var(--intently-space-sm);
	}

	.content-wrapper h2:first-of-type {
		margin-top: 0;
	}

	.content-wrapper h3 {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--intently-text-secondary);
		margin: var(--intently-space-lg) 0 var(--intently-space-sm);
	}

	.content-wrapper h4 {
		font-size: 1rem;
		font-weight: 600;
		color: var(--intently-text-secondary);
		margin: var(--intently-space-md) 0 var(--intently-space-sm);
	}

	.content-wrapper p {
		line-height: 1.6;
		color: var(--intently-text-secondary);
		margin: var(--intently-space-md) 0;
	}

	.content-wrapper ul {
		list-style-type: none;
		padding-left: 0;
		margin: var(--intently-space-md) 0;
	}

	.content-wrapper ul li {
		position: relative;
		padding-left: 1.5rem;
		margin-bottom: var(--intently-space-sm);
		line-height: 1.6;
		color: var(--intently-text-secondary);
	}

	.content-wrapper ul li:before {
		content: "•";
		color: var(--intently-blue);
		font-weight: bold;
		position: absolute;
		left: 0;
	}

	.content-wrapper ul.no-collect li {
		color: var(--intently-red);
	}

	.content-wrapper ul.no-collect li:before {
		color: var(--intently-red);
	}

	.content-wrapper ul.collect li {
		color: var(--intently-green);
	}

	.content-wrapper ul.collect li:before {
		color: var(--intently-green);
	}

	.content-wrapper a {
		color: var(--intently-blue);
		text-decoration: none;
		transition: color var(--intently-transition-fast);
	}

