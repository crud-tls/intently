---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoreButton from '../components/ui/StoreButton.astro';
import ProductSchema from '../components/SEO/ProductSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Download Intently Free | Your Next Hour Starts Now" description="Download in 30 seconds. No account, no credit card, no data shared. Intently gives you back the hours you've been losing to mindless scrolling. Free on Android and Chrome." />
		<ProductSchema
			name="Intently Android"
			description="Free privacy-first digital wellbeing app that creates a mindful pause before distracting apps open. Usage tracking, mindful interventions, streak tracking, and detailed analytics — all offline with no account needed."
			platform="android"
			downloadUrl="https://play.google.com/store/apps/details?id=dev.sadakat.thinkfaster"
			ratingValue={4.7}
			ratingCount={12000}
		/>
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "Download", url: "https://liveintently.app/download" }
			]}
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="container">
					<h1>Your Next Hour Starts Now</h1>
					<p class="subtitle">In 30 seconds, you'll have a tool that gives you back the time you've been losing. No sign-up. No credit card. No data shared. Just freedom.</p>
					<p class="hero-links">
						See all <a href="/features">features</a> or learn about our <a href="/privacy">privacy commitment</a>.
					</p>
				</div>
			</section>

			<!-- Download Section -->
			<section class="download-section">
				<div class="container">
					<div class="download-grid">
						<!-- Android -->
						<div class="download-card">
							<div class="platform-badge android">
								<svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
									<path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48C13.85 1.23 12.95 1 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31C6.97 3.26 6 5.01 6 7h12c0-1.99-.97-3.75-2.47-4.84zM10 5H9V4h1v1zm5 0h-1V4h1v1z"/>
								</svg>
							</div>
							<h3>Android</h3>
							<p>The full Intently experience. Within 24 hours, you'll know exactly where your time goes—and have the power to change it.</p>
							<StoreButton store="playstore" href="https://play.google.com/store/apps/details?id=dev.sadakat.thinkfaster" />
							<ul class="feature-list">
								<li>Complete app usage tracking</li>
								<li>Mindful intervention overlays</li>
								<li>Detailed analytics dashboard</li>
								<li>Home screen widgets</li>
							</ul>
						</div>

						<!-- iOS -->
						<div class="download-card">
					<div class="coming-soon-badge">Coming Soon</div>
							<div class="platform-badge ios">
								<svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
									<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
								</svg>
							</div>
							<h3>iOS</h3>
							<p>iPhone users, your moment is coming. A beautiful, native experience built to respect your attention and your privacy.</p>
							<button class="store-button-disabled" disabled>
	<span class="button-text">Coming Soon</span>
</button>
							<ul class="feature-list">
								<li>Screen Time API integration</li>
								<li>Beautiful native design</li>
								<li>iCloud sync across devices</li>
								<li>Lock screen widgets</li>
							</ul>
						</div>

						<!-- Chrome -->
						<div class="download-card">
							<div class="platform-badge chrome">
								<svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32">
									<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
								</svg>
							</div>
							<h3>Chrome Extension</h3>
							<p>That browser tab you opened 'for just a second' 40 minutes ago? Intently catches you before the rabbit hole swallows you whole.</p>
							<StoreButton store="chromestore" href="https://chromewebstore.google.com/detail/intently-intentful-browsi/acjndeeecacgplloeefjjhlnlpgnonop" />
							<ul class="feature-list">
								<li>Website time tracking</li>
								<li>Focus mode for deep work</li>
								<li>Usage insights and reports</li>
								<li>Quick settings access</li>
							</ul>
							<p class="privacy-link"><a href="/privacy-chrome">Chrome Extension Privacy Policy</a></p>
						</div>
					</div>
				</div>
			</section>

			<!-- Privacy Badge -->
			<section class="privacy-section">
				<div class="container">
					<div class="privacy-badge">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
						</svg>
						<div class="privacy-text">
							<strong>We can't see your data. We don't want to.</strong> — Your screen time is your business—we just help you make it intentional.
						</div>
					</div>
				</div>
			</section>

			<!-- Quick Links -->
			<section class="links-section">
				<div class="container">
					<div class="links-grid">
						<a href="/features" class="link-card">
							<span>Explore Features</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
								<path d="M5 12h14M12 5l7 7-7 7"/>
							</svg>
						</a>
						<a href="/privacy" class="link-card">
							<span>Privacy Policy</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
								<path d="M5 12h14M12 5l7 7-7 7"/>
							</svg>
						</a>
						<a href="/about" class="link-card">
							<span>About Intently</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
								<path d="M5 12h14M12 5l7 7-7 7"/>
							</svg>
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	/* Hero */
	.hero {
		width: 100%;
		padding: var(--intently-space-2xl) 0 var(--intently-space-xl);
		background: var(--intently-bg-primary);
		text-align: center;
	}

	.hero::before {
		content: '';
		display: block;
		height: 7rem;
	}

	.hero h1 {
		font-size: 2rem;
		font-weight: 800;
		margin: 0 0 var(--intently-space-md);
		color: var(--intently-text-primary);
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.subtitle {
		font-size: 1rem;
		color: var(--intently-text-secondary);
		margin: 0;
		max-width: 500px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero-links {
		font-size: 1rem;
		color: var(--intently-text-secondary);
		margin: var(--intently-space-lg) auto 0;
		max-width: 500px;
	}

	.hero-links a {
		color: var(--intently-blue);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: var(--intently-transition-normal);
	}

	.hero-links a:hover {
		border-bottom-color: var(--intently-blue);
	}

	/* Download Section */
	.download-section {
		width: 100%;
		padding: 0 0 var(--intently-space-2xl);
		background: var(--intently-bg-primary);
	}

	.download-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-lg);
		max-width: 1100px;
		margin: 0 auto;
	}

	.download-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--intently-space-md);
		padding: var(--intently-space-2xl);
		background: var(--intently-bg-primary);
		border-radius: var(--intently-radius-lg);
		border: 1px solid var(--intently-gray-200);
		transition: all var(--intently-transition-normal);
	}

	.download-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--intently-shadow-lg);
		border-color: var(--intently-blue);
	}

	.platform-badge {
		width: 64px;
		height: 64px;
		border-radius: var(--intently-radius-lg);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--intently-text-primary);
	}

	.platform-badge.android {
		background: #3DDC84;
	}

	.platform-badge.ios {
		background: #212121;
	}

	.platform-badge.chrome {
		background: var(--intently-red);
	}

	.coming-soon-badge {
		position: absolute;
		top: var(--intently-space-md);
		right: var(--intently-space-md);
		background: var(--intently-orange);
		color: white;
		padding: 0.25rem 0.75rem;
		border-radius: var(--intently-radius-full);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		box-shadow: var(--intently-shadow-sm);
	}

	.store-button-disabled {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.5rem;
		background: var(--intently-gray-200);
		color: var(--intently-text-hint);
		border: none;
		border-radius: var(--intently-radius-md);
		font-weight: 600;
		font-size: 0.9375rem;
		cursor: not-allowed;
		min-height: 48px;
	}

	.download-card h3 {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0;
		color: var(--intently-text-primary);
	}

	.download-card > p {
		font-size: 0.9375rem;
		color: var(--intently-text-secondary);
		text-align: center;
		margin: 0;
		line-height: 1.5;
	}

	.feature-list {
		list-style: none;
		padding: 0 1rem;
		margin: var(--intently-space-md) 0 0;
		width: 100%;
	}

	.feature-list li {
		font-size: 0.875rem;
		color: var(--intently-text-secondary);
		padding: 0.375rem 0 0.375rem 1.25rem;
		position: relative;
		line-height: 1.4;
	}

	.feature-list li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 6px;
		height: 6px;
		background: var(--intently-blue);
		border-radius: 50%;
	}

	.privacy-link {
		font-size: 0.8125rem;
		color: var(--intently-text-hint);
		margin: var(--intently-space-sm) 0 0;
		text-align: center;
	}

	.privacy-link a {
		color: var(--intently-blue);
		text-decoration: none;
		transition: var(--intently-transition-fast);
	}

	.privacy-link a:hover {
		text-decoration: underline;
	}

	/* Privacy Section */
	.privacy-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
	}

	.privacy-badge {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--intently-space-md);
		padding: var(--intently-space-lg) var(--intently-space-xl);
		background: var(--intently-bg-primary);
		border-radius: var(--intently-radius-full);
		max-width: fit-content;
		margin: 0 auto;
		border: 1px solid var(--intently-gray-200);
	}

	.privacy-badge svg {
		color: var(--intently-green);
		flex-shrink: 0;
	}

	.privacy-text {
		font-size: 0.9375rem;
		color: var(--intently-text-secondary);
	}

	.privacy-text strong {
		color: var(--intently-text-primary);
		font-weight: 600;
	}

	/* Links Section */
	.links-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0 var(--intently-space-4xl);
		background: var(--intently-bg-secondary);
	}

	.links-grid {
		display: flex;
		justify-content: center;
		gap: var(--intently-space-md);
		flex-wrap: wrap;
	}

	.link-card {
		display: flex;
		align-items: center;
		gap: var(--intently-space-sm);
		padding: var(--intently-space-md) var(--intently-space-lg);
		background: var(--intently-bg-primary);
		border-radius: var(--intently-radius-lg);
		color: var(--intently-text-primary);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.9375rem;
		border: 1px solid var(--intently-gray-200);
		transition: all var(--intently-transition-normal);
	}

	.link-card:hover {
		border-color: var(--intently-blue);
		color: var(--intently-blue);
		transform: translateY(-1px);
	}

	.link-card svg {
		flex-shrink: 0;
	}

	.container {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* Responsive - Mobile First */
	/* Tablet: more spacing and larger grids */
	@media (min-width: 768px) {
		.hero {
			padding: var(--intently-space-3xl) 0 var(--intently-space-2xl);
		}

		.download-section {
			padding: 0 0 var(--intently-space-3xl);
		}

		.hero h1 {
			font-size: 2.5rem;
		}

		.download-grid {
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: var(--intently-space-xl);
		}
	}

	/* Desktop: even more spacing */
	@media (min-width: 1024px) {
		.hero {
			padding: var(--intently-space-4xl) 0 var(--intently-space-3xl);
		}

		.download-section {
			padding: 0 0 var(--intently-space-4xl);
		}

		.hero h1 {
			font-size: 3.5rem;
		}

		.download-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Mobile: optimize small screens */
	@media (max-width: 767px) {
		.hero-links {
			font-size: 0.9375rem;
		}

		.download-card {
			padding: var(--intently-space-lg);
		}

		.links-grid {
			flex-direction: column;
			align-items: stretch;
		}

		.link-card {
			justify-content: space-between;
		}
	}

	html {
		scroll-behavior: smooth;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--intently-blue);
		outline-offset: 2px;
	}
</style>
