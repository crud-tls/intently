---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/marketing/Hero.astro';
import FeatureCard from '../components/marketing/FeatureCard.astro';
import PlatformCard from '../components/marketing/PlatformCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import WebSiteSchema from '../components/SEO/WebSiteSchema.astro';
import { getCollection } from 'astro:content';

const androidFeatures = ["Complete app blocking", "Usage analytics", "Streak tracking", "Widget support"];
const iosFeatures = ["Screen Time API", "Widget support", "iCloud sync", "Beautiful design"];
const chromeFeatures = ["Site tracking", "Focus mode", "Usage insights", "Quick settings"];

// Get latest 3 blog posts
const allPosts = await getCollection('blog');
const latestPosts = allPosts
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Intently - Take Back Your Time | Free Screen Time App That Respects Your Privacy"
			description="Stop losing 3+ hours a day to mindless scrolling. Intently creates a gentle pause before distracting apps open—helping you choose what matters. 100% free, 100% private, zero data collected."
		/>
		<WebSiteSchema />
	</head>
	<body>
		<Header />

		<main>
			<Hero />

			<!-- Features Section -->
			<section class="features-section">
				<div class="container">
					<h2 class="section-title">What Changes When You Use Intently</h2>
					<p class="section-subtitle">People who use Intently report feeling calmer, more present, and genuinely surprised at how much time they get back.</p>
					<div class="features-grid">
						<FeatureCard
							icon="📊"
							title="See Where Your Hours Go"
							description="Most people are shocked to discover they spend 3-4 hours daily on apps they don't even enjoy. Intently reveals the truth—gently—so you can decide what deserves your attention."
							color="blue"
						/>
						<FeatureCard
							icon="🔔"
							title="A Breath Between You and the Scroll"
							description="When you reach for Instagram or TikTok on autopilot, Intently creates a quiet pause. In that moment, you remember: you can choose."
							color="purple"
						/>
						<FeatureCard
							icon="🏆"
							title="Watch Yourself Transform"
							description="Every day you choose presence over scrolling, your streak grows. It's not about perfection—it's about the quiet pride of becoming someone who's in control."
							color="orange"
						/>
						<FeatureCard
							icon="🔒"
							title="Your Secrets Stay Yours"
							description="We'll never know which apps you use or how long you scroll. Because that's your business. Everything stays on your device—always."
							color="green"
						/>
					</div>
				</div>
			</section>

			<!-- Before/After Section -->
			<section class="before-after-section">
				<div class="container">
					<div class="before-after-grid">
						<div class="before-column">
							<h3 class="before-after-heading before-heading">Before Intently</h3>
							<ul class="before-after-list">
								<li>"Just 5 more minutes" turns into an hour</li>
								<li>Picking up your phone 80+ times without thinking</li>
								<li>Feeling guilty but unable to stop</li>
								<li>Losing evenings to mindless scrolling</li>
								<li>Waking up and immediately checking notifications</li>
							</ul>
						</div>
						<div class="after-column">
							<h3 class="before-after-heading after-heading">After Intently</h3>
							<ul class="before-after-list">
								<li>You catch yourself before the spiral starts</li>
								<li>Reaching for your phone becomes a conscious choice</li>
								<li>Feeling proud of small wins that add up</li>
								<li>Having evenings for books, walks, or real conversations</li>
								<li>Starting your morning on your own terms</li>
							</ul>
						</div>
					</div>
					<p class="before-after-closing">This isn't about willpower. It's about awareness. Intently gives you the pause that changes everything.</p>
				</div>
			</section>

			<!-- Platforms Section -->
			<section class="platforms-section">
				<div class="container">
					<h2 class="section-title">Wherever You Scroll, We're There</h2>
					<p class="section-subtitle">Whether it's your phone in bed, your browser at work, or your tablet on the couch—Intently quietly has your back.</p>
					<div class="platforms-grid">
						<PlatformCard
							platform="android"
							title="Android"
							description="Your phone is the biggest time thief. Take it back with the full Intently experience."
							features={androidFeatures}
							downloadUrl="#"
							storeType="playstore"
						/>
						<PlatformCard
							platform="ios"
							title="iOS"
							description="iPhone users, your turn is coming. A beautiful, native experience designed to respect your attention."
							features={iosFeatures}
							downloadUrl="#"
							storeType="appstore"
						/>
						<PlatformCard
							platform="chrome"
							title="Chrome Extension"
							description="That 'quick check' at work that turns into 45 minutes? Intently catches you before the rabbit hole swallows you whole."
							features={chromeFeatures}
							downloadUrl="https://chromewebstore.google.com/detail/intently-intentful-browsi/acjndeeecacgplloeefjjhlnlpgnonop"
							storeType="chromestore"
						/>
					</div>
				</div>
			</section>

			<!-- Blog Section -->
			<section class="blog-section">
				<div class="container">
					<h2 class="section-title">Latest from Our Blog</h2>
					<p class="section-subtitle">Expert tips and insights on digital wellbeing, phone addiction, and mindful tech use.</p>
					<div class="blog-grid">
						{latestPosts.map((post) => (
							<article class="blog-card">
								{post.data.heroImage && (
									<a href={`/blog/${post.id}`} class="blog-image-link">
										<img src={post.data.heroImage} alt={post.data.title} class="blog-image" />
									</a>
								)}
								<div class="blog-content">
									<h3 class="blog-title">
										<a href={`/blog/${post.id}`}>{post.data.title}</a>
									</h3>
									<p class="blog-description">{post.data.description}</p>
									<a href={`/blog/${post.id}`} class="blog-link">Read More →</a>
								</div>
							</article>
						))}
					</div>
					<div class="blog-cta">
						<a href="/blog" class="view-all-button">View All Articles</a>
						<a href="/quiz" class="quiz-button">📱 Take Our Phone Addiction Quiz</a>
					</div>
				</div>
			</section>

			<!-- Testimonials Section -->
			<section class="testimonials-section">
				<div class="container">
					<div class="testimonials-grid">
						<div class="testimonial-card">
							<p class="testimonial-quote">"I got back 2 hours a day. That's 14 hours a week I spend with my kids now."</p>
							<span class="testimonial-author">— Android user</span>
						</div>
						<div class="testimonial-card">
							<p class="testimonial-quote">"Other apps made me feel broken. Intently just... helped me notice. That was enough."</p>
							<span class="testimonial-author">— Chrome user</span>
						</div>
						<div class="testimonial-card">
							<p class="testimonial-quote">"I didn't even realize I was spending 4 hours on TikTok. Now I choose 30 minutes—and I actually enjoy it more."</p>
							<span class="testimonial-author">— Android user</span>
						</div>
					</div>
					<div class="stats-bar">
						<div class="stat-item">
							<span class="stat-value">12,000+</span>
							<span class="stat-label">Downloads</span>
						</div>
						<div class="stat-item">
							<span class="stat-value">4.7</span>
							<span class="stat-label">Star Average</span>
						</div>
						<div class="stat-item">
							<span class="stat-value">45%</span>
							<span class="stat-label">Average Reduction</span>
						</div>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section class="cta-section">
				<div class="container">
					<div class="cta-content">
						<h2>Tomorrow, You Could Wake Up With an Extra Hour</h2>
						<p>12,000+ people have already taken back their mornings, their evenings, and their weekends. The only thing standing between you and them is one free download.</p>
						<a href="/download" class="cta-button">Start Reclaiming Your Time</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	/* Features Section */
	.features-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-primary);
	}

	/* Platforms Section */
	.platforms-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.section-title {
		font-size: 2.5rem;
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--intently-space-md) 0;
		color: var(--intently-text-primary);
	}

	.section-subtitle {
		font-size: 1.125rem;
		text-align: center;
		max-width: 600px;
		margin: 0 auto var(--intently-space-3xl);
		color: var(--intently-text-secondary);
	}

	.features-grid,
	.platforms-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-xl);
	}

	.features-grid .feature-card,
	.platforms-grid .platform-card {
		height: auto;
	}

	/* Tablet: 2 columns */
	@media (min-width: 768px) {
		.features-grid,
		.platforms-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.features-grid .feature-card,
		.platforms-grid .platform-card {
			height: 100%;
		}
	}

	/* Desktop: 4 columns for features, 3 for platforms */
	@media (min-width: 1024px) {
		.features-grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.platforms-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Blog Section */
	.blog-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-primary);
	}

	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-xl);
		margin-bottom: var(--intently-space-2xl);
	}

	.blog-card {
		background: white;
		border-radius: var(--intently-radius-lg);
		overflow: hidden;
		border: 1px solid var(--intently-gray-200);
		transition: all var(--intently-transition-normal);
		display: flex;
		flex-direction: column;
	}

	.blog-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--intently-shadow-lg);
		border-color: var(--intently-blue);
	}

	.blog-image-link {
		display: block;
		overflow: hidden;
	}

	.blog-image {
		width: 100%;
		height: 200px;
		object-fit: cover;
		transition: transform var(--intently-transition-normal);
	}

	.blog-image-link:hover .blog-image {
		transform: scale(1.05);
	}

	.blog-content {
		padding: var(--intently-space-lg);
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.blog-title {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-sm);
		line-height: 1.3;
	}

	.blog-title a {
		color: var(--intently-text-primary);
		text-decoration: none;
		transition: color var(--intently-transition-fast);
	}

	.blog-title a:hover {
		color: var(--intently-blue);
	}

	.blog-description {
		font-size: 0.9375rem;
		color: var(--intently-text-secondary);
		margin: 0 0 var(--intently-space-md);
		line-height: 1.5;
		flex: 1;
	}

	.blog-link {
		color: var(--intently-blue);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.9375rem;
		transition: color var(--intently-transition-fast);
		align-self: flex-start;
	}

	.blog-link:hover {
		color: var(--intently-purple);
	}

	.blog-cta {
		display: flex;
		gap: var(--intently-space-md);
		justify-content: center;
		flex-wrap: wrap;
	}

	.view-all-button,
	.quiz-button {
		display: inline-block;
		padding: 0.875rem 1.75rem;
		border-radius: var(--intently-radius-full);
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		transition: all var(--intently-transition-normal);
	}

	.view-all-button {
		background: var(--intently-blue);
		color: white;
		border: 2px solid var(--intently-blue);
	}

	.view-all-button:hover {
		background: var(--intently-blue-dark);
		transform: translateY(-2px);
		box-shadow: var(--intently-shadow-md);
	}

	.quiz-button {
		background: white;
		color: var(--intently-blue);
		border: 2px solid var(--intently-blue);
	}

	.quiz-button:hover {
		background: var(--intently-bg-secondary);
		transform: translateY(-2px);
	}

	@media (min-width: 768px) {
		.blog-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.blog-image {
			height: 180px;
		}
	}

	/* Before/After Section */
	.before-after-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
	}

	.before-after-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-xl);
		max-width: 900px;
		margin: 0 auto var(--intently-space-xl);
	}

	.before-column,
	.after-column {
		padding: var(--intently-space-xl);
		border-radius: var(--intently-radius-lg);
	}

	.before-column {
		background: #FFF5F5;
		border: 1px solid #FED7D7;
	}

	.after-column {
		background: #F0FFF4;
		border: 1px solid #C6F6D5;
	}

	.before-after-heading {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-md);
	}

	.before-heading {
		color: #E53E3E;
	}

	.after-heading {
		color: #38A169;
	}

	.before-after-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.before-after-list li {
		padding: 0.5rem 0;
		font-size: 0.9375rem;
		color: var(--intently-text-secondary);
		line-height: 1.5;
		position: relative;
		padding-left: 1.5rem;
	}

	.before-column .before-after-list li::before {
		content: "✕";
		position: absolute;
		left: 0;
		color: #E53E3E;
		font-weight: 700;
	}

	.after-column .before-after-list li::before {
		content: "✓";
		position: absolute;
		left: 0;
		color: #38A169;
		font-weight: 700;
	}

	.before-after-closing {
		text-align: center;
		font-size: 1.125rem;
		font-style: italic;
		color: var(--intently-text-secondary);
		max-width: 700px;
		margin: 0 auto;
		line-height: 1.6;
	}

	/* Testimonials Section */
	.testimonials-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-lg);
		max-width: 1000px;
		margin: 0 auto var(--intently-space-2xl);
	}

	.testimonial-card {
		background: white;
		padding: var(--intently-space-xl);
		border-radius: var(--intently-radius-lg);
		border: 1px solid var(--intently-gray-200);
		text-align: center;
	}

	.testimonial-quote {
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--intently-text-primary);
		margin: 0 0 var(--intently-space-md);
		font-style: italic;
	}

	.testimonial-author {
		font-size: 0.875rem;
		color: var(--intently-text-hint);
		font-weight: 500;
	}

	.stats-bar {
		display: flex;
		justify-content: center;
		gap: var(--intently-space-2xl);
		flex-wrap: wrap;
		padding: var(--intently-space-xl);
		background: white;
		border-radius: var(--intently-radius-lg);
		max-width: 700px;
		margin: 0 auto;
		border: 1px solid var(--intently-gray-200);
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.stat-value {
		font-size: 1.75rem;
		font-weight: 800;
		color: var(--intently-blue);
	}

	.stat-label {
		font-size: 0.875rem;
		color: var(--intently-text-secondary);
		font-weight: 500;
	}

	/* CTA Section */
	.cta-section {
		padding: var(--intently-space-2xl) 0;
		background: linear-gradient(135deg, var(--intently-blue) 0%, #00BCD4 100%);
		color: white;
	}

	.cta-content {
		text-align: center;
		max-width: 600px;
		margin: 0 auto;
	}

	.cta-content h2 {
		font-size: 2rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-md);
		color: white;
	}

	.cta-content p {
		font-size: 1.125rem;
		margin: 0 0 var(--intently-space-xl);
		opacity: 0.95;
	}

	.cta-button {
		display: inline-block;
		padding: 1rem 2rem;
		background: white;
		color: var(--intently-blue);
		text-decoration: none;
		font-weight: 700;
		font-size: 1.125rem;
		border-radius: var(--intently-radius-full);
		transition: all var(--intently-transition-normal);
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: var(--intently-shadow-lg);
	}

	/* Responsive - Mobile First */
	/* Tablet: more spacing */
	@media (min-width: 768px) {
		.features-section,
		.platforms-section,
		.blog-section,
		.before-after-section,
		.testimonials-section,
		.cta-section {
			padding: var(--intently-space-3xl) 0;
		}

		.before-after-grid {
			grid-template-columns: 1fr 1fr;
		}

		.testimonials-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Desktop: even more spacing */
	@media (min-width: 1024px) {
		.features-section,
		.platforms-section,
		.blog-section,
		.before-after-section,
		.testimonials-section,
		.cta-section {
			padding: var(--intently-space-4xl) 0;
		}
	}

	/* Mobile: optimize layouts */
	@media (max-width: 767px) {
		.section-title {
			font-size: 1.75rem;
		}

		.section-subtitle {
			font-size: 1rem;
		}

		.cta-content h2 {
			font-size: 1.5rem;
		}

		.cta-content p {
			font-size: 1rem;
		}
	}
</style>
