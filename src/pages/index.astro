---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/marketing/Hero.astro';
import GlassBentoCard from '../components/marketing/GlassBentoCard.astro';
import PlatformCard from '../components/marketing/PlatformCard.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import WebSiteSchema from '../components/SEO/WebSiteSchema.astro';
import { getCollection } from 'astro:content';

const androidFeatures = ["Complete app blocking", "Usage analytics", "Streak tracking", "Widget support"];
const iosFeatures = ["Screen Time API", "Widget support", "iCloud sync", "Beautiful design"];
const chromeFeatures = ["Site tracking", "Focus mode", "Usage insights", "Quick settings"];

// Get latest 3 blog posts
const allPosts = await getCollection('blog');
const latestPosts = allPosts
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Intently - Take Back Your Time | Free Screen Time App That Respects Your Privacy"
			description="Stop losing 3+ hours a day to mindless scrolling. Intently creates a gentle pause before distracting apps open—helping you choose what matters. 100% free, 100% private, zero data collected."
		/>
		<WebSiteSchema />
	</head>
	<body>
		<Header />

		<main>
			<Hero />

			<!-- Features Section - Glass Bento Grid -->
			<section class="bento-glass-section">
				<div class="container">
					<div class="section-header">
						<h2 class="section-title">What Changes When You Use Intently</h2>
						<p class="section-subtitle">Four ways your relationship with your phone transforms.</p>
					</div>
					<div class="bento-grid">
						<GlassBentoCard
							size="hero"
							color="blue"
							glassLevel="heavy"
							icon="Clock"
							stat="2.3 hrs"
							statLabel="average time saved daily"
							title="See Where Your Hours Go"
							description="Most people are shocked to discover they spend 3-4 hours daily on apps they don't even enjoy. Intently reveals the truth gently."
						/>
						<GlassBentoCard
							size="medium"
							color="purple"
							glassLevel="soft"
							icon="Pause"
							title="A Breath Between You and the Scroll"
							description="When you reach for apps on autopilot, Intently creates a quiet pause. In that moment, you remember: you can choose."
						/>
						<GlassBentoCard
							size="medium"
							color="orange"
							glassLevel="soft"
							icon="TrendingUp"
							title="Watch Yourself Transform"
							description="Every day you choose presence over scrolling, your streak grows. It's not about perfection—it's about becoming someone in control."
						/>
						<GlassBentoCard
							size="wide"
							color="green"
							glassLevel="soft"
							icon="ShieldCheck"
							title="Your Secrets Stay Yours"
							description="We'll never know which apps you use or how long you scroll. Everything stays on your device—always. Your business, your progress, your data. Private."
						/>
					</div>
				</div>
			</section>

			<!-- Transformation Journey Section -->
			<section class="journey-section">
				<div class="container">
					<div class="journey-header">
						<span class="journey-eyebrow">The shift</span>
						<h2 class="journey-title">One Small Pause.<br/>Everything Changes.</h2>
					</div>

					<div class="journey-track">
						<!-- Central timeline -->
						<div class="timeline-line" aria-hidden="true">
							<div class="timeline-glow"></div>
						</div>

						<!-- Row 1 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="AlarmClock" size={20} color="var(--intently-red)" /></span>
									<p>"Just 5 more minutes" turns into an hour</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="Hand" size={20} color="var(--intently-green)" /></span>
									<p>You catch yourself before the spiral starts</p>
								</div>
							</div>
						</div>

						<!-- Row 2 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="Smartphone" size={20} color="var(--intently-red)" /></span>
									<p>Picking up your phone 80+ times without thinking</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="Brain" size={20} color="var(--intently-green)" /></span>
									<p>Reaching for your phone becomes a conscious choice</p>
								</div>
							</div>
						</div>

						<!-- Row 3 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="Frown" size={20} color="var(--intently-red)" /></span>
									<p>Feeling guilty but unable to stop</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="Trophy" size={20} color="var(--intently-green)" /></span>
									<p>Feeling proud of small wins that add up</p>
								</div>
							</div>
						</div>

						<!-- Row 4 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="Moon" size={20} color="var(--intently-red)" /></span>
									<p>Losing evenings to mindless scrolling</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="BookOpen" size={20} color="var(--intently-green)" /></span>
									<p>Having evenings for books, walks, or real conversations</p>
								</div>
							</div>
						</div>

						<!-- Row 5 -->
						<div class="journey-row">
							<div class="journey-before">
								<div class="journey-card journey-card-before">
									<span class="journey-icon journey-icon-before"><Icon name="Bell" size={20} color="var(--intently-red)" /></span>
									<p>Waking up and immediately checking notifications</p>
								</div>
							</div>
							<div class="timeline-node" aria-hidden="true"><div class="node-dot"></div></div>
							<div class="journey-after">
								<div class="journey-card journey-card-after">
									<span class="journey-icon journey-icon-after"><Icon name="Sun" size={20} color="var(--intently-green)" /></span>
									<p>Starting your morning on your own terms</p>
								</div>
							</div>
						</div>

						<!-- Labels -->
						<div class="journey-labels" aria-hidden="true">
							<span class="journey-label journey-label-before">Before</span>
							<span class="journey-label journey-label-after">After</span>
						</div>
					</div>

					<div class="journey-closing">
						<p>This isn't about willpower. It's about <em>awareness</em>.</p>
						<span class="journey-closing-sub">Intently gives you the pause that changes everything.</span>
					</div>
				</div>
			</section>

			<!-- Platforms Section -->
			<section class="platforms-section">
				<div class="container">
					<h2 class="section-title">Wherever You Scroll, We're There</h2>
					<p class="section-subtitle">Whether it's your phone in bed, your browser at work, or your tablet on the couch—Intently quietly has your back.</p>
					<div class="platforms-grid">
						<PlatformCard
							platform="android"
							title="Android"
							description="Your phone is the biggest time thief. Take it back with the full Intently experience."
							features={androidFeatures}
							downloadUrl="https://play.google.com/store/apps/details?id=dev.sadakat.thinkfaster"
							storeType="playstore"
						/>
						<PlatformCard
							platform="ios"
							title="iOS"
							description="iPhone users, your turn is coming. A beautiful, native experience designed to respect your attention."
							features={iosFeatures}
							downloadUrl="#"
							storeType="appstore"
							available={false}
						/>
						<PlatformCard
							platform="chrome"
							title="Chrome Extension"
							description="That 'quick check' at work that turns into 45 minutes? Intently catches you before the rabbit hole swallows you whole."
							features={chromeFeatures}
							downloadUrl="https://chromewebstore.google.com/detail/intently-intentful-browsi/acjndeeecacgplloeefjjhlnlpgnonop"
							storeType="chromestore"
						/>
					</div>
				</div>
			</section>

			<!-- Blog Section -->
			<section class="blog-section">
				<div class="container">
					<h2 class="section-title">Latest from Our Blog</h2>
					<p class="section-subtitle">Expert tips and insights on digital wellbeing, phone addiction, and mindful tech use.</p>
					<div class="blog-grid">
						{latestPosts.map((post) => (
							<article class="blog-card">
								{post.data.heroImage && (
									<a href={`/blog/${post.id}`} class="blog-image-link">
										<img src={post.data.heroImage} alt={post.data.title} class="blog-image" />
									</a>
								)}
								<div class="blog-content">
									<h3 class="blog-title">
										<a href={`/blog/${post.id}`}>{post.data.title}</a>
									</h3>
									<p class="blog-description">{post.data.description}</p>
									<a href={`/blog/${post.id}`} class="blog-link">Read More →</a>
								</div>
							</article>
						))}
					</div>
					<div class="blog-cta">
						<a href="/blog" class="view-all-button">View All Articles</a>
						<a href="/quiz" class="quiz-button"><Icon name="Smartphone" size={20} /> Take Our Phone Addiction Quiz</a>
					</div>
				</div>
			</section>

			<!-- Testimonials Section -->
			<section class="testimonials-section">
				<div class="container">
					<div class="testimonials-grid">
						<div class="testimonial-card">
							<p class="testimonial-quote">"I got back 2 hours a day. That's 14 hours a week I spend with my kids now."</p>
							<span class="testimonial-author">— Android user</span>
						</div>
						<div class="testimonial-card">
							<p class="testimonial-quote">"Other apps made me feel broken. Intently just... helped me notice. That was enough."</p>
							<span class="testimonial-author">— Chrome user</span>
						</div>
						<div class="testimonial-card">
							<p class="testimonial-quote">"I didn't even realize I was spending 4 hours on TikTok. Now I choose 30 minutes—and I actually enjoy it more."</p>
							<span class="testimonial-author">— Android user</span>
						</div>
					</div>
					<div class="stats-bar">
						<div class="stat-item">
							<span class="stat-value">12,000+</span>
							<span class="stat-label">Downloads</span>
						</div>
						<div class="stat-item">
							<span class="stat-value">4.7</span>
							<span class="stat-label">Star Average</span>
						</div>
						<div class="stat-item">
							<span class="stat-value">45%</span>
							<span class="stat-label">Average Reduction</span>
						</div>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section class="cta-section">
				<div class="container">
					<div class="cta-content">
						<h2>Tomorrow, You Could Wake Up With an Extra Hour</h2>
						<p>12,000+ people have already taken back their mornings, their evenings, and their weekends. The only thing standing between you and them is one free download.</p>
						<a href="/download" class="cta-button">Start Reclaiming Your Time</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	/* Bento Glass Section */
	.bento-glass-section {
		width: 100%;
		padding: var(--intently-space-4xl) 0;
		background: var(--intently-bg-secondary);
		position: relative;
		transition: background-color 0.3s ease;
	}

	.section-header {
		text-align: center;
		max-width: 600px;
		margin: 0 auto var(--intently-space-3xl);
		padding: 0 1rem;
		position: relative;
	}

	.section-header .section-title {
		font-size: 2rem;
		font-weight: 800;
		margin: 0 0 var(--intently-space-md) 0;
		color: var(--intently-text-primary);
		letter-spacing: -0.03em;
		line-height: 1.2;
	}

	.section-header .section-subtitle {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--intently-text-secondary);
		margin: 0;
		font-weight: 400;
	}

	/* Bento grid layout */
	.bento-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		max-width: 900px;
		margin: 0 auto;
		padding: 0 1rem;
		position: relative;
		z-index: 1;
	}

	/* Tablet: 2 columns */
	@media (min-width: 768px) {
		.bento-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}

		.section-header .section-title {
			font-size: 2.5rem;
		}

		.section-header .section-subtitle {
			font-size: 1.0625rem;
		}
	}

	/* Desktop */
	@media (min-width: 1024px) {
		.bento-glass-section {
			padding: var(--intently-space-5xl) 0;
		}

		.bento-grid {
			max-width: 1000px;
			gap: 1.75rem;
		}
	}

	/* Features Section - keeping for backward compatibility */
	.features-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-primary);
	}

	/* Platforms Section */
	.platforms-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.section-title {
		font-size: 2.5rem;
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--intently-space-md) 0;
		color: var(--intently-text-primary);
	}

	.section-subtitle {
		font-size: 1.125rem;
		text-align: center;
		max-width: 600px;
		margin: 0 auto var(--intently-space-3xl);
		color: var(--intently-text-secondary);
	}

	.features-grid,
	.platforms-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-xl);
	}

	.features-grid .feature-card,
	.platforms-grid .platform-card {
		height: auto;
	}

	/* Tablet: 2 columns */
	@media (min-width: 768px) {
		.features-grid,
		.platforms-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.features-grid .feature-card,
		.platforms-grid .platform-card {
			height: 100%;
		}
	}

	/* Desktop: 4 columns for features, 3 for platforms */
	@media (min-width: 1024px) {
		.features-grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.platforms-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Blog Section */
	.blog-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-primary);
	}

	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-xl);
		margin-bottom: var(--intently-space-2xl);
	}

	.blog-card {
		background: var(--intently-bg-primary);
		border-radius: var(--intently-radius-lg);
		overflow: hidden;
		border: 1px solid var(--intently-gray-200);
		transition: all var(--intently-transition-normal);
		display: flex;
		flex-direction: column;
	}

	.blog-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--intently-shadow-lg);
		border-color: var(--intently-blue);
	}

	.blog-image-link {
		display: block;
		overflow: hidden;
	}

	.blog-image {
		width: 100%;
		height: 200px;
		object-fit: cover;
		transition: transform var(--intently-transition-normal);
	}

	.blog-image-link:hover .blog-image {
		transform: scale(1.05);
	}

	.blog-content {
		padding: var(--intently-space-lg);
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.blog-title {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-sm);
		line-height: 1.3;
	}

	.blog-title a {
		color: var(--intently-text-primary);
		text-decoration: none;
		transition: color var(--intently-transition-fast);
	}

	.blog-title a:hover {
		color: var(--intently-blue);
	}

	.blog-description {
		font-size: 0.9375rem;
		color: var(--intently-text-secondary);
		margin: 0 0 var(--intently-space-md);
		line-height: 1.5;
		flex: 1;
	}

	.blog-link {
		color: var(--intently-blue);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.9375rem;
		transition: color var(--intently-transition-fast);
		align-self: flex-start;
	}

	.blog-link:hover {
		color: var(--intently-purple);
	}

	.blog-cta {
		display: flex;
		gap: var(--intently-space-md);
		justify-content: center;
		flex-wrap: wrap;
	}

	.view-all-button,
	.quiz-button {
		display: inline-block;
		padding: 0.875rem 1.75rem;
		border-radius: var(--intently-radius-full);
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		transition: all var(--intently-transition-normal);
	}

	.view-all-button {
		background: var(--intently-blue);
		color: white;
		border: 2px solid var(--intently-blue);
	}

	.view-all-button:hover {
		background: var(--intently-blue-dark);
		transform: translateY(-2px);
		box-shadow: var(--intently-shadow-md);
	}

	.quiz-button {
		background: white;
		color: var(--intently-blue);
		border: 2px solid var(--intently-blue);
	}

	.quiz-button:hover {
		background: var(--intently-bg-secondary);
		transform: translateY(-2px);
	}

	@media (min-width: 768px) {
		.blog-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.blog-image {
			height: 180px;
		}
	}

	/* Journey / Transformation Section */
	.journey-section {
		width: 100%;
		padding: var(--intently-space-3xl) 0;
		background: var(--intently-bg-primary);
		position: relative;
		overflow: hidden;
	}

	.journey-header {
		text-align: center;
		max-width: 560px;
		margin: 0 auto var(--intently-space-3xl);
		padding: 0 1rem;
	}

	.journey-eyebrow {
		display: inline-block;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--intently-blue);
		margin-bottom: 0.75rem;
	}

	.journey-title {
		font-size: 2rem;
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: -0.03em;
		color: var(--intently-text-primary);
		margin: 0;
	}

	/* The track that holds timeline + rows */
	.journey-track {
		position: relative;
		max-width: 820px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* Central vertical line */
	.timeline-line {
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 2px;
		background: linear-gradient(
			180deg,
			var(--intently-red) 0%,
			var(--intently-gray-300) 40%,
			var(--intently-gray-300) 60%,
			var(--intently-green) 100%
		);
		transform: translateX(-50%);
		border-radius: 2px;
		z-index: 0;
	}

	.timeline-glow {
		position: absolute;
		inset: 0;
		width: 100%;
		filter: blur(6px);
		background: inherit;
		opacity: 0.4;
	}

	/* Before / After labels floating at top */
	.journey-labels {
		display: none;
	}

	@media (min-width: 768px) {
		.journey-labels {
			display: flex;
			justify-content: space-between;
			padding: 0 2rem;
			margin-bottom: 1.5rem;
			position: relative;
			z-index: 1;
		}

		.journey-label {
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			padding: 0.375rem 1rem;
			border-radius: 100px;
		}

		.journey-label-before {
			color: var(--intently-red);
			background: rgba(244, 67, 54, 0.08);
		}

		.journey-label-after {
			color: var(--intently-green);
			background: rgba(76, 175, 80, 0.08);
		}
	}

	/* Each row: before | node | after */
	.journey-row {
		display: grid;
		grid-template-columns: 1fr 40px 1fr;
		align-items: center;
		gap: 0;
		margin-bottom: 1rem;
		position: relative;
		z-index: 1;
	}

	.journey-row:last-of-type {
		margin-bottom: 0;
	}

	/* Timeline dot at center */
	.timeline-node {
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 2;
	}

	.node-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--intently-gray-400);
		border: 2px solid var(--intently-bg-primary);
		box-shadow: 0 0 0 2px var(--intently-gray-300);
		transition: all 0.3s ease;
	}

	.journey-row:first-of-type .node-dot {
		background: var(--intently-red);
		box-shadow: 0 0 0 2px rgba(244, 67, 54, 0.2);
	}

