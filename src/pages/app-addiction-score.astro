---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import Icon from '../components/ui/Icon.astro';

const faqs = [
	{
		question: "How is the app addiction score calculated?",
		answer: "The score is based on 6 scientifically-recognized addiction factors: infinite scroll, variable rewards, push notifications, autoplay, social comparison, and dark patterns. Each app is rated on these factors, and a weighted average produces the overall toxicity score (0-100)."
	},
	{
		question: "Is TikTok more addictive than Instagram?",
		answer: "Based on our scoring model, TikTok typically scores higher due to its heavy use of variable reward algorithms, infinite scroll, and autoplay. However, Instagram also scores high due to social comparison features and notification strategies. Both use multiple addiction mechanisms."
	},
	{
		question: "What are dark patterns in apps?",
		answer: "Dark patterns are design choices that manipulate users into behaviors they wouldn't otherwise choose — like hiding unsubscribe buttons, using guilt-trip language when you try to leave, auto-opting you into notifications, or making it confusing to delete your account."
	},
	{
		question: "Can I actually become addicted to an app?",
		answer: "Yes. Behavioral addiction to apps is well-documented in psychology research. Apps use variable reward schedules (like slot machines), social validation loops, and infinite content feeds that trigger dopamine responses, creating compulsive usage patterns."
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="App Addiction Score: How Toxic Are Your Apps? (Free Test) | Intently"
			description="Get your free digital toxicity report. See how addictive your apps really are with FDA-style nutrition labels and RPG trading cards. Science-backed scoring across 6 addiction factors. 100% private."
		/>
		<FAQSchema faqs={faqs} />
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "App Addiction Score", url: "https://liveintently.app/app-addiction-score" }
			]}
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- Hero -->
			<section class="score-hero">
				<div class="hero-glow" aria-hidden="true"></div>
				<div class="container">
					<h1 class="text-gradient">App Addiction Score</h1>
					<p class="hero-subtitle">How toxic are your apps? Get your free Digital Toxicity Report</p>
					<div class="quiz-meta-pills">
						<span class="meta-pill">Science-backed</span>
						<span class="meta-pill">6 addiction factors</span>
						<span class="meta-pill">100% private</span>
					</div>
				</div>
			</section>

			<!-- Main content -->
			<section class="score-section">
				<div class="container">
					<ScrollReveal animation="fadeUp">
						<div class="score-glass-card">

							<!-- Phase 1: App Selection -->
							<div id="phase-select" class="phase">
								<h2 class="phase-title">Select your apps</h2>
								<p class="phase-hint">Choose 3-8 apps you use regularly</p>

								<div id="app-icon-sprites" style="display:none" aria-hidden="true">
									<span data-app="tiktok"><Icon name="Music" size={20} color="#111" /></span>
									<span data-app="instagram"><Icon name="Instagram" size={20} color="white" /></span>
									<span data-app="youtube"><Icon name="Youtube" size={20} color="white" /></span>
									<span data-app="facebook"><Icon name="Facebook" size={20} color="white" /></span>
									<span data-app="x"><Icon name="Twitter" size={20} color="white" /></span>
									<span data-app="reddit"><Icon name="Bot" size={20} color="white" /></span>
									<span data-app="snapchat"><Icon name="Ghost" size={20} color="#111" /></span>
									<span data-app="whatsapp"><Icon name="MessageCircle" size={20} color="white" /></span>
									<span data-app="netflix"><Icon name="Tv" size={20} color="white" /></span>
									<span data-app="spotify"><Icon name="Headphones" size={20} color="white" /></span>
									<span data-app="pinterest"><Icon name="Pin" size={20} color="white" /></span>
									<span data-app="linkedin"><Icon name="Linkedin" size={20} color="white" /></span>
									<span data-app="telegram"><Icon name="Send" size={20} color="white" /></span>
									<span data-app="twitch"><Icon name="Twitch" size={20} color="white" /></span>
									<span data-app="discord"><Icon name="Gamepad2" size={20} color="white" /></span>
									<span data-app="threads"><Icon name="AtSign" size={20} color="white" /></span>
								</div>
								<div class="app-select-grid" role="group" aria-label="Select apps to analyze">
								</div>

								<div id="analyze-bar" class="analyze-bar" style="display:none;">
									<span id="selected-count">0 selected</span>
									<button id="analyze-btn" class="analyze-btn">Analyze My Apps</button>
								</div>
							</div>

							<!-- Phase 2: Scanning Animation -->
							<div id="phase-scan" class="phase" style="display:none;">
								<div class="scan-container">
									<div class="scan-label">Analyzing your apps...</div>
									<div id="scan-icon" class="scan-icon"></div>
									<div id="scan-name" class="scan-name"></div>
									<div class="scan-ring" aria-hidden="true">
										<svg viewBox="0 0 100 100">
											<circle cx="50" cy="50" r="45" fill="none" stroke="rgba(33,150,243,0.15)" stroke-width="4" />
											<circle cx="50" cy="50" r="45" fill="none" stroke="var(--intently-blue)" stroke-width="4"
												stroke-dasharray="283" stroke-dashoffset="283" stroke-linecap="round"
												class="scan-progress" />
										</svg>
									</div>
								</div>
							</div>

							<!-- Phase 3: Results -->
							<div id="phase-results" class="phase" style="display:none;">

								<!-- Overall Score Gauge -->
								<div class="gauge-section">
									<div class="gauge-overline">Your Digital Toxicity Score</div>
									<div class="gauge-container">
										<svg viewBox="0 0 200 120" class="gauge-svg" aria-label="Toxicity score gauge">
											<defs>
												<linearGradient id="gauge-grad" x1="0%" y1="0%" x2="100%" y2="0%">
													<stop offset="0%" stop-color="var(--intently-green)" />
													<stop offset="40%" stop-color="var(--intently-orange)" />
													<stop offset="100%" stop-color="var(--intently-red)" />
												</linearGradient>
											</defs>
											<!-- Background arc -->
											<path d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="rgba(0,0,0,0.08)" stroke-width="14" stroke-linecap="round" />
											<!-- Value arc -->
											<path id="gauge-arc" d="M 20 100 A 80 80 0 0 1 180 100" fill="none" stroke="url(#gauge-grad)" stroke-width="14" stroke-linecap="round"
												stroke-dasharray="251" stroke-dashoffset="251" />
											<!-- Score text -->
											<text x="100" y="85" text-anchor="middle" fill="currentColor" class="gauge-score-text" id="gauge-score">0</text>
											<text x="100" y="105" text-anchor="middle" fill="currentColor" class="gauge-label-text" id="gauge-label">Calculating...</text>
										</svg>
									</div>
								</div>

								<!-- View toggle -->
								<div class="view-toggle">
									<button class="toggle-btn active" data-view="nutrition" aria-pressed="true">Nutrition Labels</button>
									<button class="toggle-btn" data-view="trading" aria-pressed="false">Trading Cards</button>
								</div>

								<!-- Nutrition Label Cards -->
								<div id="nutrition-view" class="cards-view"></div>

								<!-- Trading Card View -->
								<div id="trading-view" class="cards-view" style="display:none;"></div>

								<!-- Top Risk Factors -->
								<div class="risk-section">
									<h3 class="risk-title">Your Top 3 Risk Factors</h3>
									<div id="risk-factors" class="risk-factors"></div>
								</div>

								<!-- Recommendations -->
								<div class="recs-section">
									<h3 class="recs-title">Personalized Tips</h3>
									<div id="recs-list" class="recs-list"></div>
								</div>

								<!-- Share & CTA -->
								<div class="share-section">
									<button id="share-copy-score" class="share-btn share-copy" aria-label="Copy link">Copy Link</button>
								</div>

								<div class="cta-buttons">
									<Button href="/download" variant="primary" size="lg">Try Intently Free</Button>
									<Button href="/screen-time-calculator" variant="secondary" size="lg">Calculate Your Screen Time</Button>
								</div>

								<button id="retake-score" class="retake-button">Start Over</button>
							</div>
						</div>
					</ScrollReveal>

					<!-- Cross-links -->
					<ScrollReveal animation="fadeUp">
						<div class="cross-links-card">
							<h3>More Tools</h3>
							<div class="tools-grid">
								<a href="/screen-time-calculator" class="tool-link">
									<span class="tool-link-icon">📊</span>
									<span class="tool-link-text">
										<strong>Screen Time Calculator</strong>
										<span>Your lifetime on screens</span>
									</span>
								</a>
								<a href="/quiz" class="tool-link">
									<span class="tool-link-icon">📋</span>
									<span class="tool-link-text">
										<strong>Phone Addiction Quiz</strong>
										<span>8 science-backed questions</span>
									</span>
								</a>
							</div>
						</div>
					</ScrollReveal>

					<!-- FAQ -->
					<ScrollReveal animation="fadeUp">
						<div class="info-glass-card">
							<h3>About This Tool</h3>
							<p>This digital toxicity score is based on publicly available research into app design patterns and behavioral psychology. Each app is scored on 6 addiction factors. All calculations happen in your browser — no data is stored or sent anywhere.</p>

							<h3>Frequently Asked Questions</h3>
							{faqs.map((faq) => (
								<details class="faq-glass-item">
									<summary>{faq.question}</summary>
									<p>{faq.answer}</p>
								</details>
							))}

							<div class="quiz-links">
								<p>Explore the <a href="/blog/psychology-of-app-addiction">psychology of app addiction</a>, learn about <a href="/blog/mindful-tech-interventions-vs-blocking">mindful interventions vs blocking</a>, or <a href="/download">download Intently free</a>.</p>
							</div>
						</div>
					</ScrollReveal>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			// ===== APP DATABASE =====
			interface AppData {
				name: string;
				icon: string;
				color: string;
				avgMinutes: number;
				scores: { infiniteScroll: number; variableRewards: number; notifications: number; autoplay: number; socialComparison: number; darkPatterns: number; };
			}

			const appsDB: Record<string, AppData> = {
				tiktok: {
					name: 'TikTok', icon: '🎵', color: '#00f2ea', avgMinutes: 52,
					scores: { infiniteScroll: 98, variableRewards: 95, notifications: 82, autoplay: 98, socialComparison: 70, darkPatterns: 75 }
				},
				instagram: {
					name: 'Instagram', icon: '📸', color: '#E1306C', avgMinutes: 45,
					scores: { infiniteScroll: 92, variableRewards: 88, notifications: 85, autoplay: 80, socialComparison: 95, darkPatterns: 72 }
				},
				youtube: {
					name: 'YouTube', icon: '▶️', color: '#FF0000', avgMinutes: 48,
					scores: { infiniteScroll: 85, variableRewards: 80, notifications: 78, autoplay: 95, socialComparison: 40, darkPatterns: 65 }
				},
				facebook: {
					name: 'Facebook', icon: '👤', color: '#1877F2', avgMinutes: 35,
					scores: { infiniteScroll: 90, variableRewards: 82, notifications: 90, autoplay: 85, socialComparison: 88, darkPatterns: 80 }
				},
				x: {
					name: 'X / Twitter', icon: '𝕏', color: '#1DA1F2', avgMinutes: 34,
					scores: { infiniteScroll: 88, variableRewards: 85, notifications: 80, autoplay: 70, socialComparison: 75, darkPatterns: 60 }
				},
				reddit: {
					name: 'Reddit', icon: '🤖', color: '#FF4500', avgMinutes: 38,
					scores: { infiniteScroll: 95, variableRewards: 90, notifications: 55, autoplay: 60, socialComparison: 45, darkPatterns: 50 }
				},
				snapchat: {
					name: 'Snapchat', icon: '👻', color: '#FFFC00', avgMinutes: 30,
					scores: { infiniteScroll: 65, variableRewards: 80, notifications: 88, autoplay: 55, socialComparison: 82, darkPatterns: 78 }
				},
				whatsapp: {
					name: 'WhatsApp', icon: '💬', color: '#25D366', avgMinutes: 28,
					scores: { infiniteScroll: 30, variableRewards: 50, notifications: 85, autoplay: 20, socialComparison: 35, darkPatterns: 40 }
				},
				netflix: {
					name: 'Netflix', icon: '🎬', color: '#E50914', avgMinutes: 60,
					scores: { infiniteScroll: 70, variableRewards: 65, notifications: 60, autoplay: 98, socialComparison: 15, darkPatterns: 70 }
				},
				spotify: {
					name: 'Spotify', icon: '🎧', color: '#1DB954', avgMinutes: 45,
					scores: { infiniteScroll: 40, variableRewards: 55, notifications: 50, autoplay: 85, socialComparison: 30, darkPatterns: 45 }
				},
				pinterest: {
					name: 'Pinterest', icon: '📌', color: '#E60023', avgMinutes: 25,
					scores: { infiniteScroll: 92, variableRewards: 75, notifications: 65, autoplay: 40, socialComparison: 60, darkPatterns: 55 }
				},
				linkedin: {
					name: 'LinkedIn', icon: '💼', color: '#0A66C2', avgMinutes: 20,
					scores: { infiniteScroll: 80, variableRewards: 70, notifications: 88, autoplay: 60, socialComparison: 85, darkPatterns: 72 }
				},
				telegram: {
					name: 'Telegram', icon: '✈️', color: '#26A5E4', avgMinutes: 22,
					scores: { infiniteScroll: 35, variableRewards: 45, notifications: 80, autoplay: 25, socialComparison: 20, darkPatterns: 30 }
				},
				twitch: {
					name: 'Twitch', icon: '🎮', color: '#9146FF', avgMinutes: 55,
					scores: { infiniteScroll: 75, variableRewards: 85, notifications: 70, autoplay: 90, socialComparison: 50, darkPatterns: 65 }
				},
				discord: {
					name: 'Discord', icon: '🎙️', color: '#5865F2', avgMinutes: 40,
					scores: { infiniteScroll: 50, variableRewards: 65, notifications: 90, autoplay: 30, socialComparison: 40, darkPatterns: 45 }
				},
				threads: {
					name: 'Threads', icon: '🧵', color: '#000000', avgMinutes: 18,
					scores: { infiniteScroll: 90, variableRewards: 80, notifications: 75, autoplay: 50, socialComparison: 78, darkPatterns: 60 }
				},
			};

			const factorWeights: Record<string, number> = {
				infiniteScroll: 0.20, variableRewards: 0.25, notifications: 0.15,
				autoplay: 0.15, socialComparison: 0.15, darkPatterns: 0.10
			};

			const factorLabels: Record<string, string> = {
				infiniteScroll: 'Infinite Scroll', variableRewards: 'Variable Rewards',
				notifications: 'Push Notifications', autoplay: 'Autoplay',
				socialComparison: 'Social Comparison', darkPatterns: 'Dark Patterns'
			};

			const factorTips: Record<string, string> = {
				infiniteScroll: 'Set a timer before opening apps with infinite feeds. Intently can create a mindful pause before you start scrolling.',
				variableRewards: 'Turn off like counts and follower notifications. The unpredictability of rewards is what makes them addictive.',
				notifications: 'Disable all non-essential notifications. Keep only messages from real people, not engagement bait.',
				autoplay: 'Turn off autoplay in every app that has it. Make the next video a conscious choice, not a default.',
				socialComparison: 'Remember that feeds are highlight reels. Unfollow accounts that make you feel inadequate.',
				darkPatterns: 'Be aware of manipulation tactics. If an app makes it hard to leave or guilts you for reducing usage, that\'s a red flag.'
			};

			function computeAppScore(app: AppData): number {
				return Math.round(
					app.scores.infiniteScroll * factorWeights.infiniteScroll +
					app.scores.variableRewards * factorWeights.variableRewards +
					app.scores.notifications * factorWeights.notifications +
					app.scores.autoplay * factorWeights.autoplay +
					app.scores.socialComparison * factorWeights.socialComparison +
					app.scores.darkPatterns * factorWeights.darkPatterns
				);
			}

			function getRarity(score: number): { label: string; class: string } {
				if (score >= 85) return { label: 'LEGENDARY', class: 'rarity-legendary' };
				if (score >= 70) return { label: 'RARE', class: 'rarity-rare' };
				if (score >= 50) return { label: 'UNCOMMON', class: 'rarity-uncommon' };
				return { label: 'COMMON', class: 'rarity-common' };
			}

			function getLevel(score: number): { label: string; color: string } {
				if (score >= 76) return { label: 'Critical', color: 'var(--intently-red)' };
				if (score >= 51) return { label: 'High', color: 'var(--intently-orange)' };
				if (score >= 26) return { label: 'Moderate', color: 'var(--intently-orange)' };
				return { label: 'Low', color: 'var(--intently-green)' };
			}

			function getIntensity(val: number): string {
				if (val >= 80) return 'HIGH';
				if (val >= 50) return 'MED';
				return 'LOW';
			}

			function getFOMO(app: AppData): string {
				const fomoScore = (app.scores.socialComparison + app.scores.notifications + app.scores.variableRewards) / 3;
				if (fomoScore >= 80) return 'SEVERE';
				if (fomoScore >= 60) return 'HIGH';
				if (fomoScore >= 40) return 'MODERATE';
				return 'LOW';
			}

			// ===== RENDER APP GRID =====
			const grid = document.querySelector('.app-select-grid')!;
			const selectedApps: string[] = [];

			const iconSprites = document.getElementById('app-icon-sprites')!;
			Object.entries(appsDB).forEach(([key, app]) => {
				const btn = document.createElement('button');
				btn.className = 'app-select-card';
				btn.dataset.app = key;
				btn.setAttribute('aria-pressed', 'false');
				const spriteIcon = iconSprites.querySelector(`[data-app="${key}"]`)?.innerHTML || app.icon;
				btn.innerHTML = `
					<span class="asc-icon" style="--app-color: ${app.color}">${spriteIcon}</span>
					<span class="asc-name">${app.name}</span>
				`;
				btn.addEventListener('click', () => toggleApp(key, btn));
				grid.appendChild(btn);
			});

			function toggleApp(key: string, btn: Element) {
				const idx = selectedApps.indexOf(key);
				if (idx > -1) {
					selectedApps.splice(idx, 1);
					btn.classList.remove('selected');
					btn.setAttribute('aria-pressed', 'false');
				} else if (selectedApps.length < 8) {
					selectedApps.push(key);
					btn.classList.add('selected');
					btn.setAttribute('aria-pressed', 'true');
				}
				updateAnalyzeBar();
			}

			function updateAnalyzeBar() {
				const bar = document.getElementById('analyze-bar')!;
				const count = document.getElementById('selected-count')!;
				if (selectedApps.length >= 3) {
					bar.style.display = '';
					count.textContent = `${selectedApps.length} selected`;
				} else {
					bar.style.display = 'none';
				}
			}

			// ===== ANALYZE =====
			document.getElementById('analyze-btn')!.addEventListener('click', startScan);

			async function startScan() {
				document.getElementById('phase-select')!.style.display = 'none';
				document.getElementById('phase-scan')!.style.display = '';

				const scanIcon = document.getElementById('scan-icon')!;
				const scanName = document.getElementById('scan-name')!;
				const scanProgress = document.querySelector('.scan-progress') as SVGCircleElement;
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				for (let i = 0; i < selectedApps.length; i++) {
					const app = appsDB[selectedApps[i]];
					scanIcon.textContent = app.icon;
					scanName.textContent = app.name;

					// Animate progress
					const pct = ((i + 1) / selectedApps.length);
					const offset = 283 - (283 * pct);
					scanProgress.style.strokeDashoffset = offset.toString();

					if (prefersReducedMotion) {
						await new Promise(r => setTimeout(r, 300));
					} else {
						await new Promise(r => setTimeout(r, 1200));
					}
				}

				await new Promise(r => setTimeout(r, prefersReducedMotion ? 200 : 600));
				showResults();
			}

			function showResults() {
				document.getElementById('phase-scan')!.style.display = 'none';
				document.getElementById('phase-results')!.style.display = '';

				// Compute overall
				const scores = selectedApps.map(k => computeAppScore(appsDB[k]));
				const overall = Math.round(scores.reduce((a, b) => a + b, 0) / scores.length);
				const level = getLevel(overall);

				// Animate gauge
				const gaugeArc = document.getElementById('gauge-arc')!;
				const gaugeScore = document.getElementById('gauge-score')!;
				const gaugeLabel = document.getElementById('gauge-label')!;
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				const targetOffset = 251 - (251 * overall / 100);

				if (prefersReducedMotion) {
					gaugeArc.style.strokeDashoffset = targetOffset.toString();
					gaugeScore.textContent = overall.toString();
				} else {
					gaugeArc.style.transition = 'stroke-dashoffset 1.5s ease-out';
					requestAnimationFrame(() => {
						gaugeArc.style.strokeDashoffset = targetOffset.toString();
					});
					// Animate number
					const dur = 1500;
					const start = performance.now();
					function tickGauge(now: number) {
						const p = Math.min((now - start) / dur, 1);
						const eased = 1 - Math.pow(1 - p, 3);
						gaugeScore.textContent = Math.round(overall * eased).toString();
						if (p < 1) requestAnimationFrame(tickGauge);
					}
					requestAnimationFrame(tickGauge);
				}
				gaugeLabel.textContent = level.label;
				gaugeLabel.style.fill = level.color;

				// Nutrition labels
				renderNutritionCards();
				// Trading cards
				renderTradingCards();
				// Risk factors
				renderRiskFactors();
				// Recommendations
				renderRecommendations();

				// URL hash
				history.replaceState(null, '', `#apps=${selectedApps.join(',')}`);
			}

			function renderNutritionCards() {
				const container = document.getElementById('nutrition-view')!;
				container.innerHTML = '';

				selectedApps.forEach(key => {
					const app = appsDB[key];
					const score = computeAppScore(app);
					const fomo = getFOMO(app);

					const card = document.createElement('div');
					card.className = 'nutrition-card';
					card.innerHTML = `
						<div class="nut-header" style="border-color:${app.color}">
							<div class="nut-title">DIGITAL NUTRITION FACTS</div>
							<div class="nut-app">${app.icon} ${app.name}</div>
						</div>
						<div class="nut-body">
							<div class="nut-score-row">
								<span>Toxicity Score</span>
								<strong>${score}/100</strong>
							</div>
							<div class="nut-serving">
								<span>Serving Size</span>
								<span>avg ${app.avgMinutes} min/day</span>
							</div>
							<div class="nut-divider"></div>
							<div class="nut-table-header">
								<span></span>
								<span>Amount</span>
								<span>% DV</span>
							</div>
							${Object.entries(app.scores).map(([factor, val]) => `
								<div class="nut-row">
									<span class="nut-factor">${factorLabels[factor]}</span>
									<span class="nut-amount nut-${getIntensity(val).toLowerCase()}">${getIntensity(val)}</span>
									<span class="nut-pct">${val}%</span>
								</div>
							`).join('')}
							<div class="nut-divider"></div>
							<div class="nut-fomo">
								<span>FOMO Risk:</span>
								<strong class="fomo-${fomo.toLowerCase()}">${fomo}</strong>
							</div>
							<div class="nut-footnote">% DV = % of Daily Vulnerability</div>
						</div>
					`;
					container.appendChild(card);
				});
			}

			function renderTradingCards() {
				const container = document.getElementById('trading-view')!;
				container.innerHTML = '';

				selectedApps.forEach(key => {
					const app = appsDB[key];
					const score = computeAppScore(app);
					const rarity = getRarity(score);

					// RPG stats
					const addictionPower = Math.round(score / 10);
					const timeDrain = Math.round(app.avgMinutes / 7);
					const fomoFactor = Math.round(((app.scores.socialComparison + app.scores.notifications) / 2) / 10);
					const escapability = Math.max(1, 10 - Math.round(score / 12));

					// Top 2 types
					const sortedFactors = Object.entries(app.scores).sort((a, b) => b[1] - a[1]);
					const types = sortedFactors.slice(0, 2).map(([f]) => factorLabels[f]);

					const card = document.createElement('div');
					card.className = `trading-card ${rarity.class}`;
					card.innerHTML = `
						<div class="tc-rarity">${rarity.label}</div>
						<div class="tc-icon">${app.icon}</div>
						<div class="tc-name">${app.name}</div>
						<div class="tc-types">
							${types.map(t => `<span class="tc-type">${t}</span>`).join('')}
						</div>
						<div class="tc-stats">
							<div class="tc-stat">
								<span class="tc-stat-label">Addiction Power</span>
								<div class="tc-stat-bar"><div class="tc-stat-fill" style="width:${addictionPower * 10}%"></div></div>
								<span class="tc-stat-val">${addictionPower}/10</span>
							</div>
							<div class="tc-stat">
								<span class="tc-stat-label">Time Drain</span>
								<div class="tc-stat-bar"><div class="tc-stat-fill" style="width:${timeDrain * 10}%"></div></div>
								<span class="tc-stat-val">${timeDrain}/10</span>
							</div>
							<div class="tc-stat">
								<span class="tc-stat-label">FOMO Factor</span>
								<div class="tc-stat-bar"><div class="tc-stat-fill" style="width:${fomoFactor * 10}%"></div></div>
								<span class="tc-stat-val">${fomoFactor}/10</span>
							</div>
							<div class="tc-stat">
								<span class="tc-stat-label">Escapability</span>
								<div class="tc-stat-bar tc-escape"><div class="tc-stat-fill tc-escape-fill" style="width:${escapability * 10}%"></div></div>
								<span class="tc-stat-val">${escapability}/10</span>
							</div>
						</div>
						<div class="tc-score">Score: ${score}/100</div>
					`;
					container.appendChild(card);
				});
			}

			function renderRiskFactors() {
				const container = document.getElementById('risk-factors')!;
				container.innerHTML = '';

				// Aggregate factor scores
				const totals: Record<string, number> = {};
				const factors = Object.keys(factorLabels);
				factors.forEach(f => { totals[f] = 0; });

				selectedApps.forEach(key => {
					const app = appsDB[key];
					factors.forEach(f => {
						totals[f] += (app.scores as any)[f];
					});
				});

				// Average and sort
				const avgFactors = factors.map(f => ({
					key: f,
					label: factorLabels[f],
					avg: Math.round(totals[f] / selectedApps.length)
				})).sort((a, b) => b.avg - a.avg);

				avgFactors.slice(0, 3).forEach(f => {
					const el = document.createElement('div');
					el.className = 'risk-item';
					el.innerHTML = `
						<div class="risk-bar-wrap">
							<span class="risk-label">${f.label}</span>
							<div class="risk-bar"><div class="risk-bar-fill" style="width:${f.avg}%"></div></div>
							<span class="risk-score">${f.avg}%</span>
						</div>
					`;
					container.appendChild(el);
				});
			}

			function renderRecommendations() {
				const container = document.getElementById('recs-list')!;
				container.innerHTML = '';

				// Find top 3 factors
				const totals: Record<string, number> = {};
				Object.keys(factorLabels).forEach(f => { totals[f] = 0; });
				selectedApps.forEach(key => {
					const app = appsDB[key];
					Object.keys(factorLabels).forEach(f => {
						totals[f] += (app.scores as any)[f];
					});
				});

				const topFactors = Object.entries(totals)
					.sort((a, b) => b[1] - a[1])
					.slice(0, 3)
					.map(([f]) => f);

				topFactors.forEach(f => {
					const el = document.createElement('div');
					el.className = 'rec-item';
					el.innerHTML = `
						<span class="rec-check">&#10003;</span>
						<span class="rec-text">${factorTips[f]}</span>
					`;
					container.appendChild(el);
				});
			}

			// ===== VIEW TOGGLE =====
			document.querySelectorAll('.toggle-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					const view = (btn as HTMLElement).dataset.view!;
					document.querySelectorAll('.toggle-btn').forEach(b => {
						b.classList.remove('active');
						b.setAttribute('aria-pressed', 'false');
					});
					btn.classList.add('active');
					btn.setAttribute('aria-pressed', 'true');

					document.getElementById('nutrition-view')!.style.display = view === 'nutrition' ? '' : 'none';
					document.getElementById('trading-view')!.style.display = view === 'trading' ? '' : 'none';
				});
			});

			// ===== SHARE =====
			document.getElementById('share-copy-score')!.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(window.location.href);
					const btn = document.getElementById('share-copy-score')!;
					btn.textContent = 'Copied!';
					setTimeout(() => { btn.textContent = 'Copy Link'; }, 2000);
				} catch {}
			});

			// ===== RETAKE =====
			document.getElementById('retake-score')!.addEventListener('click', () => {
				document.getElementById('phase-results')!.style.display = 'none';
				document.getElementById('phase-select')!.style.display = '';
				selectedApps.length = 0;
				document.querySelectorAll('.app-select-card').forEach(c => {
					c.classList.remove('selected');
					c.setAttribute('aria-pressed', 'false');
				});
				updateAnalyzeBar();
				history.replaceState(null, '', window.location.pathname);
			});

			// ===== RESTORE FROM HASH =====
			function restoreFromHash() {
				const hash = window.location.hash;
				if (!hash || !hash.includes('apps=')) return;
				const params = new URLSearchParams(hash.slice(1));
				const apps = (params.get('apps') || '').split(',').filter(a => appsDB[a]);
				if (apps.length < 3) return;

				apps.forEach(key => {
					selectedApps.push(key);
					const card = document.querySelector(`[data-app="${key}"]`);
					if (card) {
						card.classList.add('selected');
						card.setAttribute('aria-pressed', 'true');
					}
				});
				updateAnalyzeBar();

				// Skip scan, go directly to results
				document.getElementById('phase-select')!.style.display = 'none';
				showResults();
			}

			restoreFromHash();
		</script>
	</body>
</html>

