---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import InputField from '../components/ui/InputField.astro';
import DotLottie from '../components/ui/DotLottie.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';

const subjectOptions = [
	{ value: 'General Inquiry', label: 'General Inquiry' },
	{ value: 'Support', label: 'Support' },
	{ value: 'Feature Request', label: 'Feature Request' },
	{ value: 'Bug Report', label: 'Bug Report' },
	{ value: 'Feedback', label: 'Feedback' },
	{ value: 'Other', label: 'Other' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Contact Us - Get in Touch | Intently" description="Have questions, feedback, or need support? We'd love to hear from you. Send us a message and we'll get back to you as soon as possible." />
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "Contact", url: "https://liveintently.app/contact" }
			]}
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- Contact Hero - Glass -->
			<section class="contact-hero">
				<div class="hero-glow" aria-hidden="true"></div>
				<div class="container">
					<h1 class="text-gradient">Get in Touch</h1>
					<p class="hero-subtitle">Have questions, feedback, or need support? We'd love to hear from you. Send us a message and we'll get back to you as soon as possible.</p>
				</div>
			</section>

			<!-- Contact Form Section -->
			<section class="contact-form-section">
				<div class="container">
					<div class="contact-content">
						<!-- Glass Form Card -->
						<ScrollReveal animation="fadeUp">
							<div class="form-glass-card">
								<form id="contact-form" class="contact-form" novalidate>
									<InputField
										label="Name"
										type="text"
										name="name"
										placeholder="Your name"
										required
										minlength={2}
									/>

									<InputField
										label="Email"
										type="email"
										name="email"
										placeholder="your@email.com"
										required
									/>

									<InputField
										label="Subject"
										type="select"
										name="subject"
										required
										options={subjectOptions}
									/>

									<InputField
										label="Message"
										type="textarea"
										name="message"
										placeholder="Tell us more about what you'd like to discuss..."
										required
										minlength={10}
										rows={6}
									/>

									<div id="form-status" class="form-status" aria-live="polite"></div>

									<Button type="submit" variant="primary" size="lg" id="submit-btn" class="submit-btn-wrapper">
										<span class="btn-text">Send Message</span>
										<span class="btn-loading" hidden>Sending...</span>
									</Button>
								</form>
							</div>
						</ScrollReveal>

						<!-- Contact Animation -->
						<ScrollReveal animation="fadeUp">
							<div class="contact-animation">
								<DotLottie
									src="/contact_us.lottie"
									autoplay={true}
									loop={true}
									speed={1}
									width={400}
									height={400}
									ariaLabel="Contact us animation"
								/>
							</div>
						</ScrollReveal>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<script>
	const form = document.getElementById('contact-form');
	const submitBtn = document.getElementById('submit-btn');
	const btnText = submitBtn?.querySelector('.btn-text');
	const btnLoading = submitBtn?.querySelector('.btn-loading');
	const formStatus = document.getElementById('form-status');

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		clearErrors();

		const formData = new FormData(form);
		const errors = validateForm(formData);

		if (Object.keys(errors).length > 0) {
			showErrors(errors);
			return;
		}

		setLoading(true);

		try {
			const response = await fetch('/api/contact', {
				method: 'POST',
				body: formData,
			});

			const result = await response.json();

			if (result.success) {
				showStatus('success', result.message || 'Your message has been sent successfully!');
				form.reset();
			} else {
				if (result.errors) {
					showErrors(result.errors);
				} else {
					showStatus('error', result.message || 'Failed to send message. Please try again.');
				}
			}
		} catch (error) {
			console.error('Form submission error:', error);
			showStatus('error', 'An error occurred. Please try again later.');
		} finally {
			setLoading(false);
		}
	});

	function validateForm(formData) {
		const errors = {};

		const name = formData.get('name')?.trim();
		const email = formData.get('email')?.trim();
		const subject = formData.get('subject')?.trim();
		const message = formData.get('message')?.trim();

		if (!name || name.length < 2) {
			errors.name = 'Please enter a valid name (at least 2 characters)';
		}

		if (!email || !isValidEmail(email)) {
			errors.email = 'Please enter a valid email address';
		}

		if (!subject) {
			errors.subject = 'Please select a subject';
		}

		if (!message || message.length < 10) {
			errors.message = 'Please enter a message (at least 10 characters)';
		}

		return errors;
	}

	function isValidEmail(email) {
		const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
		return emailRegex.test(email);
	}

	function showErrors(errors) {
		for (const [field, message] of Object.entries(errors)) {
			const input = document.getElementById(`${field}-field`);
			const errorSpan = document.getElementById(`${field}-error`);

			if (input) {
				input.classList.add('input-field-input-error');
			}
			if (errorSpan) {
				errorSpan.textContent = message;
			}
		}
	}

	function clearErrors() {
		const inputs = form?.querySelectorAll('.input-field-input');
		inputs?.forEach(input => input.classList.remove('input-field-input-error'));

		const errorSpans = form?.querySelectorAll('.input-field-error');
		errorSpans?.forEach(span => span.textContent = '');

		if (formStatus) {
			formStatus.className = 'form-status';
			formStatus.textContent = '';
		}
	}

	function showStatus(type, message) {
		if (formStatus) {
			formStatus.className = `form-status ${type}`;
			formStatus.textContent = message;
		}
	}

	function setLoading(isLoading) {
		if (submitBtn) {
			submitBtn.disabled = isLoading;
		}
		if (btnText) {
			btnText.hidden = isLoading;
		}
		if (btnLoading) {
			btnLoading.hidden = !isLoading;
		}
	}
</script>

<style>
	main {
		width: 100%;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* ============================
	   HERO - Glass
	   ============================ */
	.contact-hero {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: linear-gradient(180deg, var(--intently-bg-accent) 0%, var(--intently-bg-secondary) 100%);
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.contact-hero::before {
		content: '';
		display: block;
		height: 7rem;
	}

	.hero-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 600px;
		height: 400px;
		background: radial-gradient(ellipse, rgba(33, 150, 243, 0.12) 0%, transparent 70%);
		filter: blur(60px);
		pointer-events: none;
	}

	.text-gradient {
		font-size: 2rem;
		font-weight: 800;
		margin: 0 0 var(--intently-space-md);
		letter-spacing: -0.02em;
		line-height: 1.2;
		background: linear-gradient(135deg, var(--intently-blue) 0%, var(--intently-purple) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.125rem;
		max-width: 700px;
		margin: 0 auto;
		color: var(--intently-text-secondary);
		line-height: 1.6;
	}

	@media (prefers-color-scheme: dark) {
		.hero-glow {
			background: radial-gradient(ellipse, rgba(66, 165, 245, 0.08) 0%, transparent 70%);
		}
	}

	/* ============================
	   FORM SECTION
	   ============================ */
	.contact-form-section {
		width: 100%;
		padding: var(--intently-space-2xl) 0;
		background: var(--intently-bg-secondary);
		min-height: 60vh;
	}

	.contact-content {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--intently-space-xl);
		max-width: 1000px;
		margin: 0 auto;
		align-items: start;
	}

	/* Glass form card */
	.form-glass-card {
		padding: var(--intently-space-2xl);
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		border: 1px solid rgba(255, 255, 255, 0.8);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.9),
			0 4px 20px rgba(0, 0, 0, 0.06);
		border-radius: 24px;
	}

	@media (prefers-color-scheme: dark) {
		.form-glass-card {
			background: rgba(30, 30, 30, 0.75);
			border: 1px solid rgba(255, 255, 255, 0.12);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 4px 20px rgba(0, 0, 0, 0.4);
		}
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: var(--intently-space-md);
	}

	.submit-btn-wrapper {
		width: 100%;
	}

	.submit-btn-wrapper :global(.btn) {
		width: 100%;
	}

	/* Form status messages */
	.form-status {
		padding: var(--intently-space-md);
		border-radius: var(--intently-radius-md);
		font-size: 0.9375rem;
		display: none;
	}

	.form-status:not(:empty) {
		display: block;
	}

	.form-status.success {
		background: var(--intently-bg-success);
		color: var(--intently-green-dark);
		border: 1px solid var(--intently-green-light);
	}

	.form-status.error {
		background: var(--intently-bg-error);
		color: var(--intently-red-dark);
		border: 1px solid var(--intently-red-light);
	}

	/* Contact Animation */
	.contact-animation {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}

	.contact-animation :global(.dotlottie-wc) {
		width: 100%;
		height: 100%;
		max-width: 400px;
		max-height: 400px;
		object-fit: contain;
	}

	/* ============================
	   RESPONSIVE
	   ============================ */
	@media (min-width: 768px) {
		.contact-hero,
		.contact-form-section {
			padding: var(--intently-space-3xl) 0;
		}

		.text-gradient {
			font-size: 2.5rem;
		}

		.hero-subtitle {
			font-size: 1.25rem;
		}

		.contact-content {
			grid-template-columns: 2fr 1fr;
			align-items: center;
		}
	}

	@media (min-width: 1024px) {
		.contact-hero,
		.contact-form-section {
			padding: var(--intently-space-4xl) 0;
		}

		.text-gradient {
			font-size: 3rem;
		}

		.contact-animation :global(.dotlottie-wc) {
			max-width: 450px;
			max-height: 450px;
		}
	}

	@media (max-width: 767px) {
		.form-glass-card {
			padding: var(--intently-space-lg);
		}
	}

	html {
		scroll-behavior: smooth;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--intently-blue);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.form-glass-card {
			transition: none;
		}
	}
</style>
