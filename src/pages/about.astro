---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import BreadcrumbSchema from '../components/SEO/BreadcrumbSchema.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About - ${SITE_TITLE}`} description="Learn about Intently's mission to help people build healthier digital habits through privacy-first technology." />
		<BreadcrumbSchema
			items={[
				{ name: "Home", url: "https://liveintently.app" },
				{ name: "About", url: "https://liveintently.app/about" }
			]}
		/>
	</head>
	<body>
		<Header />

		<main>
			<!-- About Hero -->
			<section class="about-hero">
				<div class="container">
					<h1>About Intently</h1>
					<p class="hero-subtitle">We believe technology should serve us, not the other way around. Intently exists to help you reclaim your time and attention.</p>
				</div>
			</section>

			<!-- Mission -->
			<section class="mission">
				<div class="container">
					<div class="mission-content">
						<h2>Our Mission</h2>
						<p>To empower individuals to build healthier relationships with technology through mindful, privacy-first tools that respect human autonomy and dignity.</p>
						<p>Unlike screen time apps that rely on shame, guilt, or authoritarian control, Intently takes a compassionate approach. We use gentle interventions to help you make conscious choices about how you spend your time.</p>
					</div>
				</div>
			</section>

			<!-- Values -->
			<section class="values">
				<div class="container">
					<h2 class="section-title">Our Values</h2>
					<div class="values-grid">
						<div class="value-item">
							<div class="value-icon">🔒</div>
							<h3>Privacy First</h3>
							<p>Your personal data belongs to you. We store nothing in the cloud and track nothing about your behavior.</p>
						</div>
						<div class="value-item">
							<div class="value-icon">🧘</div>
							<h3>Mindful Approach</h3>
							<p>We believe in awareness, not restriction. Gentle reminders help you make conscious choices.</p>
						</div>
						<div class="value-item">
							<div class="value-icon">🎯</div>
							<h3>Real Results</h3>
							<p>Our tools are based on behavioral science research, helping users achieve lasting habit change.</p>
						</div>
						<div class="value-item">
							<div class="value-icon">💚</div>
							<h3>Human-Centered</h3>
							<p>Technology should serve human wellbeing, not exploit human psychology for engagement.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Story -->
			<section class="story">
				<div class="container">
					<div class="story-content">
						<h2>The Story Behind Intently</h2>
						<p>Intently was born from personal frustration with social media and endless scrolling. Like many people, we found ourselves losing hours to apps that didn't bring joy or meaning—just distraction.</p>
						<p>We tried existing screen time solutions, but they felt authoritarian and shame-inducing. They treated us like children who couldn't be trusted. We knew there had to be a better way.</p>
						<p>So we built Intently—a tool that respects your autonomy while helping you build better habits. Instead of blocking and restricting, Intently uses mindful interventions to create moments of awareness. In those moments, you can choose what matters to you.</p>
						<p>Today, thousands of people use Intently to reclaim their time and attention. We're building a future where technology serves human flourishing, not the other way around.</p>
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="cta-section">
				<div class="container">
					<div class="cta-content">
						<h2>Join the Movement</h2>
						<p>Start building healthier digital habits today. Download Intently and begin your mindful journey.</p>
						<div class="cta-buttons">
							<Button href="/download" variant="primary" size="lg">Download Intently</Button>
							<Button href="/blog" variant="secondary" size="lg">Read Our Blog</Button>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
	}

	.about-hero {
		padding: var(--intently-space-4xl) 0;
		background: linear-gradient(135deg, var(--intently-blue) 0%, #00BCD4 100%);
		color: white;
		text-align: center;
	}

	.about-hero h1 {
		font-size: 3rem;
		font-weight: 800;
		margin: 0 0 var(--intently-space-md);
		color: white;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		max-width: 700px;
		margin: 0 auto;
		opacity: 0.95;
		line-height: 1.6;
	}

	.mission {
		padding: var(--intently-space-4xl) 0;
		background: var(--intently-bg-primary);
	}

	.mission-content {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.mission-content h2 {
		font-size: 2.5rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-xl);
		color: var(--intently-text-primary);
	}

	.mission-content p {
		font-size: 1.125rem;
		line-height: 1.8;
		color: var(--intently-text-secondary);
		margin: 0 0 var(--intently-space-xl);
	}

	.values {
		padding: var(--intently-space-4xl) 0;
		background: var(--intently-bg-secondary);
	}

	.section-title {
		font-size: 2.5rem;
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--intently-space-3xl);
		color: var(--intently-text-primary);
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: var(--intently-space-xl);
	}

	.value-item {
		text-align: center;
		padding: var(--intently-space-xl);
		background: white;
		border-radius: var(--intently-radius-lg);
	}

	.value-icon {
		font-size: 3rem;
		margin-bottom: var(--intently-space-md);
	}

	.value-item h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-sm);
		color: var(--intently-text-primary);
	}

	.value-item p {
		color: var(--intently-text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	.story {
		padding: var(--intently-space-4xl) 0;
		background: var(--intently-bg-primary);
	}

	.story-content {
		max-width: 800px;
		margin: 0 auto;
	}

	.story-content h2 {
		font-size: 2.5rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-xl);
		color: var(--intently-text-primary);
	}

	.story-content p {
		font-size: 1.125rem;
		line-height: 1.8;
		color: var(--intently-text-secondary);
		margin: 0 0 var(--intently-space-xl);
	}

	.cta-section {
		padding: var(--intently-space-4xl) 0;
		background: var(--intently-bg-secondary);
		text-align: center;
	}

	.cta-content h2 {
		font-size: 2.5rem;
		font-weight: 700;
		margin: 0 0 var(--intently-space-md);
		color: var(--intently-text-primary);
	}

	.cta-content p {
		font-size: 1.125rem;
		color: var(--intently-text-secondary);
		max-width: 600px;
		margin: 0 auto var(--intently-space-xl);
	}

	.cta-buttons {
		display: flex;
		gap: var(--intently-space-md);
		justify-content: center;
		flex-wrap: wrap;
	}

	.container {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 var(--intently-space-xl);
	}

	/* Responsive */
	@media (max-width: 960px) {
		.values-grid {
			grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		}
	}

	@media (max-width: 768px) {
		.about-hero h1 {
			font-size: 2rem;
		}

		.section-title,
		.mission-content h2,
		.story-content h2,
		.cta-content h2 {
			font-size: 2rem;
		}

		.values-grid {
			grid-template-columns: 1fr;
		}

		.cta-buttons {
			flex-direction: column;
		}
	}

	html {
		scroll-behavior: smooth;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--intently-blue);
		outline-offset: 2px;
	}
</style>
