{
	"name": "intently-sites",
	"private": true,
	"type": "module",
	"description": "Intently studio sites: liveintently.app hub and one site per app on <app>.liveintently.app",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"check": "npm run check --workspaces --if-present",
		"dev:pawse": "npm run dev -w @intently/pawse-site"
	},
	"allowScripts": {
		"workerd@1.20251217.0": true,
		"workerd@1.20251118.0": true,
		"esbuild@0.25.12": true,
		"esbuild@0.27.0": true,
		"esbuild@0.25.4": true,
		"sharp@0.34.5": true,
		"sharp@0.33.5": true
	}
}
